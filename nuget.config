<?xml version="1.0" encoding="utf-8"?>
<!--
  Ogma Library NuGet configuration.
  <clear/> drops any machine-level package sources (e.g. a broken local Telerik
  feed observed during Phase 01 spikes) so restore is deterministic on every
  machine and CI runner. See spikes/RESULTS.md S1.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
