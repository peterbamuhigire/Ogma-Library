{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogma.library/schemas/release-descriptor-v1.json",
  "title": "Ogma Library release descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseId",
    "version",
    "platform",
    "runtimeIdentifier",
    "artifactName",
    "artifactSha256",
    "signatureAlgorithm",
    "publicKeyId"
  ],
  "properties": {
    "schema": { "const": "ogma-release-v1" },
    "releaseId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F]+$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "platform": { "enum": ["windows", "macos"] },
    "runtimeIdentifier": { "enum": ["win-x64", "win-arm64", "osx-x64", "osx-arm64"] },
    "artifactName": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\:]+$" },
    "artifactSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "signatureAlgorithm": { "const": "RSA-PSS-SHA256" },
    "publicKeyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F]+$" }
  }
}
