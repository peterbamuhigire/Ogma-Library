{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogma.library/schemas/release-acceptance-v1.json",
  "title": "Ogma Library signed release acceptance record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "releaseId", "commitSha", "artifacts", "hardware", "schemaFreeze", "migration", "approval"],
  "properties": {
    "schema": { "const": "ogma-release-acceptance-v1" },
    "releaseId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "runtimeIdentifier", "artifactName", "sha256", "descriptorSignatureVerified", "platformSigned", "cleanInstall", "criticalFlows", "performanceBudgets"],
        "properties": {
          "platform": { "enum": ["windows", "macos"] },
          "runtimeIdentifier": { "enum": ["win-x64", "win-arm64", "osx-x64", "osx-arm64"] },
          "artifactName": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!.*\\.\\.)(?!.*[\\\\/:]).+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "descriptorSignatureVerified": { "const": true },
          "platformSigned": { "const": true },
          "cleanInstall": { "const": true },
          "criticalFlows": { "const": true },
          "performanceBudgets": { "const": true },
          "authenticodeOrMsix": { "const": true },
          "developerIdAndNotarized": { "const": true }
        }
      }
    },
    "schemaFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "migrationCount", "latestMigration", "sequenceSha256", "verified"],
      "properties": {
        "version": { "const": "beta-schema-v1" },
        "migrationCount": { "const": 41 },
        "latestMigration": { "const": "20260906060000_Phase17PausedJobStatus" },
        "sequenceSha256": { "const": "8135fad43778f705b48c9d667d8e56d36b8d4445b8be3a5d2b985b1e42637dd5" },
        "verified": { "const": true }
      }
    },
    "hardware": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["machineId", "installedBuild", "performanceEvidence", "accessibilityEvidence"],
        "properties": {
          "machineId": { "enum": ["W-REF-01", "M-REF-01"] },
          "installedBuild": { "const": true },
          "performanceEvidence": { "const": true },
          "accessibilityEvidence": { "const": true }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upgrade", "interruptedUpgradeRecovery", "rollback", "backupRestore"],
      "properties": {
        "upgrade": { "const": true },
        "interruptedUpgradeRecovery": { "const": true },
        "rollback": { "const": true },
        "backupRestore": { "const": true }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "approvedAtUtc", "residualRisksAccepted"],
      "properties": {
        "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
        "approvedAtUtc": { "type": "string", "format": "date-time" },
        "residualRisksAccepted": { "const": true }
      }
    }
  }
}
