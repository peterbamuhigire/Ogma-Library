#!/bin/sh
# Ogma Library — Conventional Commits commit-msg hook.
# Enforces:  type(scope)!: subject   with subject <= 72 chars.
# Install via .github/hooks/install-hooks.(sh|ps1).
# Spec: docs/governance/CONVENTIONAL-COMMITS.md

msg_file="$1"
# First non-comment, non-empty line is the subject.
subject=$(grep -vE '^#' "$msg_file" | grep -vE '^[[:space:]]*$' | head -n1)

# Allow merge/revert/fixup commits to pass through.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

types='feat|fix|docs|test|refactor|chore|perf|ci|build|style|revert'
# type, optional (scope), optional !, ": ", then a non-empty subject.
pattern="^(${types})(\([a-z0-9._-]+\))?(!)?: .+"

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "✗ Commit message does not follow Conventional Commits."
  echo ""
  echo "  Required:  type(scope): subject"
  echo "  Types:     feat fix docs test refactor chore perf ci build style revert"
  echo "  Example:   feat(reader): isolate per-file scan failures"
  echo "  Breaking:  feat(api)!: change provider contract"
  echo ""
  echo "  Got:       $subject"
  echo ""
  echo "  See docs/governance/CONVENTIONAL-COMMITS.md"
  exit 1
fi

# Subject length check (<= 72 chars).
len=$(printf '%s' "$subject" | wc -c | tr -d ' ')
if [ "$len" -gt 72 ]; then
  echo "✗ Commit subject is ${len} characters; keep it at 72 or fewer."
  echo "  $subject"
  exit 1
fi

exit 0
