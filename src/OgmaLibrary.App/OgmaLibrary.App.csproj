<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows .exe / taskbar icon (the books mark). macOS .icns/.iconset and the
         store PNGs live in Assets and are consumed by the Phase 22 packaging. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaVersion>11.3.17</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OgmaLibrary.Domain\OgmaLibrary.Domain.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Application\OgmaLibrary.Application.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Infrastructure\OgmaLibrary.Infrastructure.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Reader\OgmaLibrary.Reader.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Bookshelf3D\OgmaLibrary.Bookshelf3D.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Workers\OgmaLibrary.Workers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Avalonia.Svg.Skia latest available is 11.3.0 (11.3.17 not published); compatible with Avalonia 11.3.17 -->
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-system and delivered premium SVG icons.
         Bundled as AvaloniaResource so avares://OgmaLibrary.App/Assets/icons/... resolves. -->
    <AvaloniaResource Include="Assets\icons\**\*.svg" />
    <!-- Application window icon (titlebar/dock). -->
    <AvaloniaResource Include="Assets\app.png" />
    <!-- Design tokens resource dictionary. -->
    <AvaloniaResource Include="Themes\Tokens.axaml" />
  </ItemGroup>

</Project>
