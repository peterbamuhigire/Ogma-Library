<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows .exe / taskbar icon (the books mark). macOS .icns/.iconset and the
         store PNGs live in Assets and are consumed by the Phase 22 packaging. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaVersion>11.3.17</AvaloniaVersion>
  </PropertyGroup>

  <!-- Sept-23 T01.5: real-window E2E builds only (dotnet build -p:OgmaE2EHooks=true, used by
       tests/OgmaLibrary.Tests.E2E/Invoke-GoldenJourneys.ps1 and the e2e-windows CI job) compile the
       OGMA_E2E test hooks. Shipped configurations never set it; an architecture test guards this. -->
  <PropertyGroup Condition="'$(OgmaE2EHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);OGMA_E2E</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OgmaLibrary.Domain\OgmaLibrary.Domain.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Application\OgmaLibrary.Application.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Infrastructure\OgmaLibrary.Infrastructure.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Reader\OgmaLibrary.Reader.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Bookshelf3D\OgmaLibrary.Bookshelf3D.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Workers\OgmaLibrary.Workers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <!-- MIT-licensed native WebView2/WKWebView control for the optional 3D shelf. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="11.4.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Avalonia.Svg.Skia latest available is 11.3.0 (11.3.17 not published); compatible with Avalonia 11.3.17 -->
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-system and delivered premium SVG icons.
         Bundled as AvaloniaResource so avares://OgmaLibrary.App/Assets/icons/... resolves. -->
    <AvaloniaResource Include="Assets\icons\**\*.svg" />
    <!-- OFL-1.1 type families pinned and redistributed with their licence files. -->
    <AvaloniaResource Include="Assets\Fonts\**\*" />
    <!-- Application window icon (titlebar/dock). -->
    <AvaloniaResource Include="Assets\app.png" />
  </ItemGroup>

</Project>
