<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OgmaLibrary.App.ViewModels.Catalogue"
        xmlns:cat="using:OgmaLibrary.App.Views.Catalogue"
        x:Class="OgmaLibrary.App.Views.MainWindow"
        x:DataType="vm:MainShellViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.png"
        Width="1180" Height="760"
        MinWidth="860" MinHeight="560"
        Background="{DynamicResource Brush.Surface.Parchment}">

  <cat:CatalogueShellView DataContext="{Binding}" />
</Window>
