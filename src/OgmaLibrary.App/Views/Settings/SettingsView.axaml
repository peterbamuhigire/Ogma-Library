<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Settings"
             xmlns:cvm="using:OgmaLibrary.App.ViewModels.Catalogue"
             xmlns:cat="using:OgmaLibrary.App.Views.Catalogue"
             x:Class="OgmaLibrary.App.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <!--
    Sept-23 Phase 08 (K16): the Settings destination. A section list on the left and one
    section on the right. Typeface decision: Public Sans (theme body) for labels, help lines
    and controls; Spectral (ogma-display) for the section title only; JetBrains Mono
    (ogma-mono) for folder paths, version and environment-variable names. Colours, sizes and
    radii are design tokens only. Every control has a visible label, a help line and an
    accessible name; the tab order follows the visual order (section list, then the section).
  -->
  <UserControl.Styles>
    <Style Selector="ListBox.settings-sections > ListBoxItem" x:DataType="vm:SettingsSectionItem">
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
      <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="TextBlock.settings-label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource Type.Size.BodyMedium}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Surface.OnParchment}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.settings-help">
      <Setter Property="FontSize" Value="{DynamicResource Type.Size.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Surface.OnParchmentMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.settings-body">
      <Setter Property="FontSize" Value="{DynamicResource Type.Size.Body}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Surface.OnParchment}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.settings-path">
      <Setter Property="FontSize" Value="{DynamicResource Type.Size.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Surface.OnParchment}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.settings-card">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.S}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton, CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Surface.OnParchment}" />
      <Setter Property="FontSize" Value="{DynamicResource Type.Size.Body}" />
    </Style>
    <!-- The About entry sits on the parchment section pane: a quiet button in parchment ink. -->
    <Style Selector="Button.quiet.settings-about">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Surface.OnParchment}" />
      <Setter Property="FontSize" Value="{DynamicResource Type.Size.Body}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:CapabilityToggleViewModel">
      <Border Classes="settings-card">
        <StackPanel Spacing="6">
          <CheckBox IsChecked="{Binding IsOn}"
                    IsEnabled="{Binding CanChange}"
                    AutomationProperties.AutomationId="{Binding AutomationId}"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.HelpText="{Binding Help}">
            <TextBlock Classes="settings-label" Text="{Binding Title}" />
          </CheckBox>
          <TextBlock Classes="settings-help" Text="{Binding Help}" />
          <TextBlock Classes="settings-help"
                     Text="{Binding StateText}"
                     FontWeight="SemiBold" />
          <TextBlock Classes="settings-help ogma-mono"
                     IsVisible="{Binding IsManaged}"
                     Text="{Binding ManagedText}"
                     AutomationProperties.AutomationId="{Binding AutomationId, StringFormat='{}{0}.Managed'}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid ColumnDefinitions="220,*">
    <!-- The section list, with About Ogma Library always reachable at its foot. -->
    <Grid Grid.Column="0" RowDefinitions="*,Auto">
      <ListBox Grid.Row="0"
               Classes="settings-sections"
               Margin="8,8,0,8"
               ItemsSource="{Binding Sections}"
               SelectedItem="{Binding SelectedSection}"
               Background="Transparent"
               AutomationProperties.AutomationId="Settings.Sections"
               AutomationProperties.Name="{Binding SectionsLabel}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsSectionItem">
            <TextBlock Text="{Binding Label}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Type.Size.Body}"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Grid.Row="1"
              Margin="8,4,0,12"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              Classes="quiet settings-about"
              Content="{Binding AboutText}"
              Click="About_Click"
              AutomationProperties.AutomationId="Settings.About"
              AutomationProperties.Name="{Binding AboutText}" />
    </Grid>

    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.AutomationId="Settings.Content">
      <StackPanel Margin="24,12,24,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Classes="ogma-display"
                   Text="{Binding SectionTitle}"
                   FontSize="{DynamicResource Type.Size.Title}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}"
                   AutomationProperties.AutomationId="Settings.SectionTitle" />

        <!-- Library (D-03): the Phase 05 folder panel, hosted here. -->
        <StackPanel Spacing="12" IsVisible="{Binding IsLibrarySection}">
          <TextBlock Classes="settings-help" Text="{Binding LibraryIntro}" />
          <Border Classes="settings-card" Padding="0" IsVisible="{Binding HasLibraryFolders}">
            <cat:LibraryFoldersPanelView DataContext="{Binding LibraryFolders}"
                                         AutomationProperties.AutomationId="Settings.Library.Folders" />
          </Border>
          <TextBlock Classes="settings-help"
                     IsVisible="{Binding !HasLibraryFolders}"
                     Text="{Binding LibraryUnavailableText}" />
          <!-- Sept-23 Phase 10 (META-008): entry point to the library health dashboard. -->
          <Border Classes="settings-card" IsVisible="{Binding HasLibraryHealth}">
            <StackPanel Spacing="6">
              <TextBlock Classes="settings-help" Text="{Binding LibraryHealthHelp}" />
              <Button HorizontalAlignment="Left"
                      Padding="10,5"
                      CornerRadius="{DynamicResource Radius.S}"
                      AutomationProperties.AutomationId="Settings.Library.Health"
                      AutomationProperties.Name="{Binding LibraryHealthLabel}"
                      Click="OpenLibraryHealth_Click">
                <TextBlock Text="{Binding LibraryHealthLabel}" />
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Appearance -->
        <StackPanel Spacing="16" IsVisible="{Binding IsAppearanceSection}">
          <Border Classes="settings-card">
            <StackPanel Spacing="6">
              <TextBlock Classes="settings-label" Text="{Binding ThemeLabel}" />
              <TextBlock Classes="settings-help" Text="{Binding ThemeHelp}" />
              <RadioButton GroupName="SettingsTheme"
                           IsChecked="{Binding IsThemeLight}"
                           Content="{Binding ThemeLightText}"
                           AutomationProperties.AutomationId="Settings.Theme.Light"
                           AutomationProperties.Name="{Binding ThemeLightText}" />
              <RadioButton GroupName="SettingsTheme"
                           IsChecked="{Binding IsThemeDark}"
                           Content="{Binding ThemeDarkText}"
                           AutomationProperties.AutomationId="Settings.Theme.Dark"
                           AutomationProperties.Name="{Binding ThemeDarkText}" />
              <RadioButton GroupName="SettingsTheme"
                           IsChecked="{Binding IsThemeSystem}"
                           Content="{Binding ThemeSystemText}"
                           AutomationProperties.AutomationId="Settings.Theme.System"
                           AutomationProperties.Name="{Binding ThemeSystemText}" />
            </StackPanel>
          </Border>
          <Border Classes="settings-card">
            <StackPanel Spacing="6">
              <TextBlock Classes="settings-label" Text="{Binding DensityLabel}" />
              <TextBlock Classes="settings-help" Text="{Binding DensityHelp}" />
              <RadioButton GroupName="SettingsDensity"
                           IsChecked="{Binding IsDensityComfortable}"
                           Content="{Binding DensityComfortableText}"
                           AutomationProperties.AutomationId="Settings.Density.Comfortable"
                           AutomationProperties.Name="{Binding DensityComfortableText}" />
              <RadioButton GroupName="SettingsDensity"
                           IsChecked="{Binding IsDensityCompact}"
                           Content="{Binding DensityCompactText}"
                           AutomationProperties.AutomationId="Settings.Density.Compact"
                           AutomationProperties.Name="{Binding DensityCompactText}" />
            </StackPanel>
          </Border>
          <Border Classes="settings-card" IsVisible="{Binding HasReaderLayout}">
            <StackPanel Spacing="6">
              <TextBlock Classes="settings-label" Text="{Binding ReaderLayoutLabel}" />
              <TextBlock Classes="settings-help" Text="{Binding ReaderLayoutHelp}" />
              <RadioButton GroupName="SettingsReaderLayout"
                           IsChecked="{Binding IsReaderLayoutSingle}"
                           Content="{Binding ReaderLayoutSingleText}"
                           AutomationProperties.AutomationId="Settings.Reader.Layout.Single"
                           AutomationProperties.Name="{Binding ReaderLayoutSingleText}" />
              <RadioButton GroupName="SettingsReaderLayout"
                           IsChecked="{Binding IsReaderLayoutTwoPage}"
                           Content="{Binding ReaderLayoutTwoPageText}"
                           AutomationProperties.AutomationId="Settings.Reader.Layout.TwoPage"
                           AutomationProperties.Name="{Binding ReaderLayoutTwoPageText}" />
              <RadioButton GroupName="SettingsReaderLayout"
                           IsChecked="{Binding IsReaderLayoutContinuous}"
                           Content="{Binding ReaderLayoutContinuousText}"
                           AutomationProperties.AutomationId="Settings.Reader.Layout.Continuous"
                           AutomationProperties.Name="{Binding ReaderLayoutContinuousText}" />
              <CheckBox IsChecked="{Binding ReaderCoverAlone}"
                        Content="{Binding ReaderCoverAloneText}"
                        AutomationProperties.AutomationId="Settings.Reader.Layout.CoverAlone"
                        AutomationProperties.Name="{Binding ReaderCoverAloneText}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Language -->
        <Border Classes="settings-card" IsVisible="{Binding IsLanguageSection}">
          <StackPanel Spacing="6">
            <TextBlock Classes="settings-label" Text="{Binding LanguageLabel}" />
            <TextBlock Classes="settings-help" Text="{Binding LanguageHelp}" />
            <RadioButton GroupName="SettingsLanguage"
                         IsChecked="{Binding IsLanguageSystem}"
                         Content="{Binding LanguageSystemText}"
                         AutomationProperties.AutomationId="Settings.Language.System"
                         AutomationProperties.Name="{Binding LanguageSystemText}" />
            <RadioButton GroupName="SettingsLanguage"
                         IsChecked="{Binding IsLanguageEnglish}"
                         Content="{Binding LanguageEnglishText}"
                         AutomationProperties.AutomationId="Settings.Language.English"
                         AutomationProperties.Name="{Binding LanguageEnglishText}" />
            <RadioButton GroupName="SettingsLanguage"
                         IsChecked="{Binding IsLanguageFrench}"
                         Content="{Binding LanguageFrenchText}"
                         AutomationProperties.AutomationId="Settings.Language.French"
                         AutomationProperties.Name="{Binding LanguageFrenchText}" />
          </StackPanel>
        </Border>

        <!-- Online services -->
        <StackPanel Spacing="12" IsVisible="{Binding IsOnlineSection}">
          <ContentControl Content="{Binding MetadataProviders}" />
          <Border Classes="settings-card">
            <StackPanel Spacing="6" AutomationProperties.AutomationId="Settings.Online.Disclosure">
              <TextBlock Classes="settings-label" Text="{Binding DisclosureTitle}" />
              <TextBlock Classes="settings-body" Text="{Binding DisclosureSent}" />
              <TextBlock Classes="settings-body" Text="{Binding DisclosureNotSent}" />
              <TextBlock Classes="settings-help" Text="{Binding DisclosureOff}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Optional features: 3D shelf preview and classroom Host -->
        <StackPanel Spacing="12" IsVisible="{Binding IsFeaturesSection}">
          <TextBlock Classes="settings-help" Text="{Binding FeaturesIntro}" />
          <ContentControl Content="{Binding Shelf3D}" />
          <ContentControl Content="{Binding ClassroomHost}" />
        </StackPanel>

        <!--
          Search and AI (Sept-23 Phase 14, task 14.7; K141). Provider choice, the built-in model
          with a consented download (D-104), the smart index and Ollama detection. Typefaces:
          Public Sans for labels and controls, JetBrains Mono (ogma-mono) for the environment
          override line only; no new font. No link opens automatically.
        -->
        <ContentControl IsVisible="{Binding IsSearchSection}"
                        Content="{Binding SearchOptions}"
                        AutomationProperties.AutomationId="Settings.Search.Options">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:SemanticSearchSettingsViewModel">
              <StackPanel Spacing="12">
                <TextBlock Classes="settings-help" Text="{Binding BodyText}" />

                <!-- Provider -->
                <Border Classes="settings-card">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="settings-label" Text="{Binding ProviderLabel}" />
                    <TextBlock Classes="settings-help" Text="{Binding ProviderHelp}" />
                    <RadioButton GroupName="SettingsSemanticProvider"
                                 IsChecked="{Binding IsBuiltIn, Mode=TwoWay}"
                                 IsEnabled="{Binding CanChooseProvider}"
                                 Content="{Binding BuiltInText}"
                                 AutomationProperties.AutomationId="Settings.Search.Provider.BuiltIn"
                                 AutomationProperties.Name="{Binding BuiltInText}" />
                    <RadioButton GroupName="SettingsSemanticProvider"
                                 IsChecked="{Binding IsOllama, Mode=TwoWay}"
                                 IsEnabled="{Binding CanChooseProvider}"
                                 Content="{Binding OllamaText}"
                                 AutomationProperties.AutomationId="Settings.Search.Provider.Ollama"
                                 AutomationProperties.Name="{Binding OllamaText}" />
                    <RadioButton GroupName="SettingsSemanticProvider"
                                 IsChecked="{Binding IsOff, Mode=TwoWay}"
                                 IsEnabled="{Binding CanChooseProvider}"
                                 Content="{Binding OffText}"
                                 AutomationProperties.AutomationId="Settings.Search.Provider.Off"
                                 AutomationProperties.Name="{Binding OffText}" />
                    <TextBlock Classes="settings-help ogma-mono"
                               IsVisible="{Binding IsProviderManaged}"
                               Text="{Binding ProviderManagedText}"
                               AutomationProperties.AutomationId="Settings.Search.Provider.Managed" />
                    <TextBlock Classes="settings-body"
                               IsVisible="{Binding IsOff}"
                               Text="{Binding KeywordOnlyText}"
                               AutomationProperties.AutomationId="Settings.Search.KeywordOnly" />
                  </StackPanel>
                </Border>

                <!-- Built-in model -->
                <Border Classes="settings-card" IsVisible="{Binding IsBuiltInSelected}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="settings-label" Text="{Binding ModelLabel}" />
                    <TextBlock Classes="settings-body"
                               Text="{Binding ModelStatusText}"
                               AutomationProperties.AutomationId="Settings.Search.Model.Status"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding DownloadPercent}"
                                 IsVisible="{Binding IsDownloadProgressVisible}"
                                 AutomationProperties.AutomationId="Settings.Search.Model.Progress"
                                 AutomationProperties.Name="{Binding DownloadProgressName}" />
                    <TextBlock Classes="settings-help"
                               IsVisible="{Binding ShowDownloadConsent}"
                               Text="{Binding DownloadConsentText}"
                               AutomationProperties.AutomationId="Settings.Search.Model.Consent" />
                    <TextBlock Classes="settings-help"
                               IsVisible="{Binding HasDiskUse}"
                               Text="{Binding DiskUseText}"
                               AutomationProperties.AutomationId="Settings.Search.Model.DiskUse" />
                    <WrapPanel Orientation="Horizontal">
                      <Button Margin="0,0,8,0"
                              Padding="10,5"
                              CornerRadius="{DynamicResource Radius.S}"
                              IsVisible="{Binding CanDownload}"
                              AutomationProperties.AutomationId="Settings.Search.Model.Download"
                              AutomationProperties.Name="{Binding DownloadLabel}"
                              AutomationProperties.HelpText="{Binding DownloadConsentText}"
                              Click="SearchDownload_Click">
                        <TextBlock Text="{Binding DownloadLabel}" />
                      </Button>
                      <Button Margin="0,0,8,0"
                              Padding="10,5"
                              CornerRadius="{DynamicResource Radius.S}"
                              IsVisible="{Binding CanCancelDownload}"
                              AutomationProperties.AutomationId="Settings.Search.Model.Cancel"
                              AutomationProperties.Name="{Binding CancelDownloadLabel}"
                              Click="SearchCancelDownload_Click">
                        <TextBlock Text="{Binding CancelDownloadLabel}" />
                      </Button>
                      <Button Padding="10,5"
                              CornerRadius="{DynamicResource Radius.S}"
                              IsVisible="{Binding CanRemoveModel}"
                              AutomationProperties.AutomationId="Settings.Search.Model.Remove"
                              AutomationProperties.Name="{Binding RemoveModelLabel}"
                              Click="SearchRemoveModel_Click">
                        <TextBlock Text="{Binding RemoveModelLabel}" />
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Ollama (advanced) -->
                <Border Classes="settings-card" IsVisible="{Binding IsOllamaSelected}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="settings-label" Text="{Binding OllamaLabel}" />
                    <TextBlock Classes="settings-body"
                               Text="{Binding OllamaStatusText}"
                               AutomationProperties.AutomationId="Settings.Search.Ollama.Status"
                               AutomationProperties.LiveSetting="Polite" />
                    <SelectableTextBlock Classes="settings-help"
                                         IsVisible="{Binding ShowOllamaGuidance}"
                                         Text="{Binding OllamaGuidanceText}"
                                         FontSize="{DynamicResource Type.Size.Small}"
                                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="Settings.Search.Ollama.Guidance"
                                         AutomationProperties.Name="{Binding OllamaGuidanceText}" />
                    <Button HorizontalAlignment="Left"
                            Padding="10,5"
                            CornerRadius="{DynamicResource Radius.S}"
                            AutomationProperties.AutomationId="Settings.Search.Ollama.Check"
                            AutomationProperties.Name="{Binding OllamaCheckLabel}"
                            Click="SearchCheckOllama_Click">
                      <TextBlock Text="{Binding OllamaCheckLabel}" />
                    </Button>
                  </StackPanel>
                </Border>

                <!-- Smart index -->
                <Border Classes="settings-card" IsVisible="{Binding IsIndexVisible}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="settings-label" Text="{Binding IndexLabel}" />
                    <TextBlock Classes="settings-help" Text="{Binding IndexHelp}" />
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding IndexPercent}"
                                 AutomationProperties.AutomationId="Settings.Search.Index.Progress"
                                 AutomationProperties.Name="{Binding IndexProgressName}"
                                 AutomationProperties.HelpText="{Binding IndexProgressText}" />
                    <TextBlock Classes="settings-body"
                               Text="{Binding IndexProgressText}"
                               AutomationProperties.AutomationId="Settings.Search.Index.Count" />
                    <TextBlock Classes="settings-help"
                               Text="{Binding IndexEtaText}"
                               AutomationProperties.AutomationId="Settings.Search.Index.Eta"
                               AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel Orientation="Horizontal">
                      <Button Margin="0,0,8,0"
                              Padding="10,5"
                              CornerRadius="{DynamicResource Radius.S}"
                              IsEnabled="{Binding CanBuildIndex}"
                              AutomationProperties.AutomationId="Settings.Search.Index.Build"
                              AutomationProperties.Name="{Binding BuildIndexLabel}"
                              Click="SearchBuildIndex_Click">
                        <TextBlock Text="{Binding BuildIndexLabel}" />
                      </Button>
                      <Button Margin="0,0,8,0"
                              Padding="10,5"
                              CornerRadius="{DynamicResource Radius.S}"
                              IsVisible="{Binding CanPause}"
                              AutomationProperties.AutomationId="Settings.Search.Index.Pause"
                              AutomationProperties.Name="{Binding PauseLabel}"
                              Click="SearchPause_Click">
                        <TextBlock Text="{Binding PauseLabel}" />
                      </Button>
                      <Button Padding="10,5"
                              CornerRadius="{DynamicResource Radius.S}"
                              IsVisible="{Binding CanResume}"
                              AutomationProperties.AutomationId="Settings.Search.Index.Resume"
                              AutomationProperties.Name="{Binding ResumeLabel}"
                              Click="SearchResume_Click">
                        <TextBlock Text="{Binding ResumeLabel}" />
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Erase embeddings, with a confirmation -->
                <Border Classes="settings-card">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="settings-label" Text="{Binding EraseLabel}" />
                    <TextBlock Classes="settings-help" Text="{Binding EraseHelp}" />
                    <Button HorizontalAlignment="Left"
                            Padding="10,5"
                            CornerRadius="{DynamicResource Radius.S}"
                            IsVisible="{Binding CanErase}"
                            AutomationProperties.AutomationId="Settings.Search.Erase"
                            AutomationProperties.Name="{Binding EraseLabel}"
                            Click="SearchRequestErase_Click">
                      <TextBlock Text="{Binding EraseLabel}" />
                    </Button>
                    <StackPanel Spacing="6"
                                IsVisible="{Binding IsEraseConfirmationVisible}"
                                AutomationProperties.AutomationId="Settings.Search.Erase.Confirmation">
                      <TextBlock Classes="settings-body" Text="{Binding EraseConfirmText}" />
                      <WrapPanel Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Padding="10,5"
                                CornerRadius="{DynamicResource Radius.S}"
                                AutomationProperties.AutomationId="Settings.Search.Erase.Confirm"
                                AutomationProperties.Name="{Binding EraseConfirmLabel}"
                                Click="SearchConfirmErase_Click">
                          <TextBlock Text="{Binding EraseConfirmLabel}" />
                        </Button>
                        <Button Padding="10,5"
                                CornerRadius="{DynamicResource Radius.S}"
                                AutomationProperties.AutomationId="Settings.Search.Erase.Cancel"
                                AutomationProperties.Name="{Binding EraseCancelLabel}"
                                Click="SearchCancelErase_Click">
                          <TextBlock Text="{Binding EraseCancelLabel}" />
                        </Button>
                      </WrapPanel>
                    </StackPanel>
                    <TextBlock Classes="settings-help"
                               IsVisible="{Binding HasEraseStatus}"
                               Text="{Binding EraseStatusText}"
                               AutomationProperties.AutomationId="Settings.Search.Erase.Status"
                               AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- AI and privacy: the Phase 15 Privacy Center mounts here. -->
        <Border Classes="settings-card" IsVisible="{Binding IsPrivacySection}">
          <StackPanel Spacing="8">
            <TextBlock Classes="settings-label" Text="{Binding PrivacyStatusTitle}" />
            <TextBlock Classes="settings-body"
                       Text="{Binding PrivacyStatusText}"
                       AutomationProperties.AutomationId="Settings.Privacy.Status" />
            <TextBlock Classes="settings-help" Text="{Binding PrivacyLocalText}" />
            <TextBlock Classes="settings-help" Text="{Binding PrivacyNextText}" />
          </StackPanel>
        </Border>

        <!-- Text recognition: the Phase 17 OCR policy extension point. -->
        <Border Classes="settings-card" IsVisible="{Binding IsTextRecognitionSection}">
          <StackPanel Spacing="8">
            <TextBlock Classes="settings-body" Text="{Binding TextRecognitionBody}" />
            <TextBlock Classes="settings-help"
                       IsVisible="{Binding IsTextRecognitionPendingVisible}"
                       Text="{Binding TextRecognitionPendingText}" />
            <ContentControl IsVisible="{Binding HasTextRecognitionOptions}"
                            Content="{Binding TextRecognitionOptions}"
                            AutomationProperties.AutomationId="Settings.Ocr.Options">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:OcrSettingsViewModel">
                  <StackPanel Spacing="10">
                    <ToggleSwitch IsChecked="{Binding AutoOcrScannedBooks, Mode=TwoWay}"
                                  OnContent="{Binding AutoOcrLabel}"
                                  OffContent="{Binding AutoOcrLabel}"
                                  AutomationProperties.AutomationId="Settings.Ocr.Auto"
                                  AutomationProperties.Name="{Binding AutoOcrLabel}" />
                    <ToggleSwitch IsChecked="{Binding PauseOnBattery, Mode=TwoWay}"
                                  OnContent="{Binding PauseOnBatteryLabel}"
                                  OffContent="{Binding PauseOnBatteryLabel}"
                                  AutomationProperties.AutomationId="Settings.Ocr.PauseOnBattery"
                                  AutomationProperties.Name="{Binding PauseOnBatteryLabel}" />
                    <StackPanel Spacing="4">
                      <TextBlock Classes="settings-body" Text="{Binding LanguageLabel}" />
                      <ComboBox MinWidth="160"
                                ItemsSource="{Binding Languages}"
                                SelectedItem="{Binding Language, Mode=TwoWay}"
                                IsEnabled="{Binding HasLanguageChoice}"
                                AutomationProperties.AutomationId="Settings.Ocr.Language"
                                AutomationProperties.Name="{Binding LanguageLabel}" />
                      <TextBlock Classes="settings-help" Text="{Binding LanguagesHelp}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </StackPanel>
        </Border>

        <!-- Diagnostics and about -->
        <StackPanel Spacing="12" IsVisible="{Binding IsDiagnosticsSection}">
          <Border Classes="settings-card">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
              <TextBlock Grid.Row="0" Classes="settings-label" Text="{Binding VersionLabel}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Classes="settings-path ogma-mono"
                         Text="{Binding VersionText}"
                         AutomationProperties.AutomationId="Settings.Diagnostics.Version" />
              <TextBlock Grid.Row="1" Classes="settings-label" Text="{Binding DataFolderLabel}" />
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                <TextBlock Classes="settings-path ogma-mono"
                           Text="{Binding DataFolderPath}"
                           AutomationProperties.AutomationId="Settings.Diagnostics.DataFolder" />
                <TextBlock Classes="settings-help" Text="{Binding DataFolderHelp}" />
              </StackPanel>
              <TextBlock Grid.Row="2" Classes="settings-label" Text="{Binding AssetFolderLabel}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="settings-path ogma-mono" Text="{Binding AssetFolderPath}" />
              <TextBlock Grid.Row="3" Classes="settings-label" Text="{Binding LogsFolderLabel}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Classes="settings-path ogma-mono" Text="{Binding LogsFolderPath}" />
            </Grid>
          </Border>
          <WrapPanel Orientation="Horizontal">
            <Button Margin="0,0,8,8"
                    Content="{Binding OpenDataFolderText}"
                    Click="OpenDataFolder_Click"
                    AutomationProperties.AutomationId="Settings.Diagnostics.OpenData"
                    AutomationProperties.Name="{Binding OpenDataFolderText}" />
            <Button Margin="0,0,8,8"
                    Content="{Binding OpenLogsText}"
                    Click="OpenLogs_Click"
                    AutomationProperties.AutomationId="Settings.Diagnostics.OpenLogs"
                    AutomationProperties.Name="{Binding OpenLogsText}" />
            <Button Margin="0,0,8,8"
                    Content="{Binding ExportText}"
                    Click="Export_Click"
                    AutomationProperties.AutomationId="Settings.Diagnostics.Export"
                    AutomationProperties.Name="{Binding ExportText}"
                    AutomationProperties.HelpText="{Binding ExportHelp}" />
          </WrapPanel>
          <TextBlock Classes="settings-help" Text="{Binding ExportHelp}" />
          <TextBlock Classes="settings-help"
                     IsVisible="{Binding HasDiagnosticsStatus}"
                     Text="{Binding DiagnosticsStatus}" />
          <TextBlock Classes="ogma-display settings-label"
                     Text="{Binding CapabilitiesTitle}"
                     FontSize="{DynamicResource Type.Size.Subtitle}" />
          <ItemsControl ItemsSource="{Binding CapabilityRows}"
                        AutomationProperties.AutomationId="Settings.Capabilities"
                        AutomationProperties.Name="{Binding CapabilitiesTitle}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="cvm:CapabilityRow">
                <Border Classes="settings-card">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="settings-label" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Status}"
                               FontSize="{DynamicResource Type.Size.Small}"
                               Foreground="{DynamicResource Brush.Link}" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                               Classes="settings-help" Text="{Binding Detail}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
