<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Catalogue"
             x:Class="OgmaLibrary.App.Views.Settings.SharingSettingsView"
             x:DataType="vm:HostSharingViewModel">

  <ScrollViewer>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
          RowSpacing="18"
          Margin="28"
          MaxWidth="960"
          HorizontalAlignment="Left">

      <Grid Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Sharing"
                     FontSize="{DynamicResource Type.Size.Title}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          <TextBlock Text="Library Host"
                     FontSize="{DynamicResource Type.Size.Body}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
        </StackPanel>

        <Border Grid.Column="1"
                MinWidth="132"
                Padding="12,8"
                BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.S}"
                VerticalAlignment="Top">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="{DynamicResource Type.Size.Body}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}" />
            <TextBlock Text="{Binding ClientCountText}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Text="Content delivery"
                     FontSize="{DynamicResource Type.Size.Subtitle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          <TextBlock Text="{Binding ContentModeText}"
                     FontSize="{DynamicResource Type.Size.Body}"
                     Foreground="{DynamicResource Brush.Accent.Slate}" />
          <TextBlock Text="{Binding FingerprintText}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Top">
          <Button Padding="12,7"
                  Background="{DynamicResource Brush.Accent.Slate}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsEnabled="{Binding CanChangeContentMode}"
                  AutomationProperties.Name="{Binding ToggleContentModeText}"
                  Click="ContentModeButton_Click">
            <TextBlock Text="{Binding ToggleContentModeText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
          <Button Padding="12,7"
                  Background="{DynamicResource Brush.Accent.Sage}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsEnabled="{Binding CanStart}"
                  AutomationProperties.Name="{Binding ConfirmStartText}"
                  Click="StartButton_Click">
            <TextBlock Text="Start"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
          <Button Padding="12,7"
                  Background="{DynamicResource Brush.Accent.Clay}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsEnabled="{Binding CanStop}"
                  AutomationProperties.Name="Stop Library Host"
                  Click="StopButton_Click">
            <TextBlock Text="Stop"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2"
            RowDefinitions="Auto,Auto"
            RowSpacing="10">
        <Border Grid.Row="0"
                IsVisible="{Binding IsStartConfirmationOpen}"
                Padding="14"
                BorderBrush="{DynamicResource Brush.Accent.Sage}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.S}">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="16">
            <TextBlock Grid.Column="0"
                       Text="{Binding StartConfirmationText}"
                       FontSize="{DynamicResource Type.Size.Body}"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
              <Button Padding="10,6"
                      Background="Transparent"
                      BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.S}"
                      AutomationProperties.Name="{Binding CancelConfirmationText}"
                      Click="CancelStartButton_Click">
                <TextBlock Text="{Binding CancelConfirmationText}"
                           FontSize="{DynamicResource Type.Size.Caption}" />
              </Button>
              <Button Padding="10,6"
                      Background="{DynamicResource Brush.Accent.Sage}"
                      Foreground="White"
                      CornerRadius="{DynamicResource Radius.S}"
                      AutomationProperties.Name="{Binding ConfirmStartText}"
                      Click="ConfirmStartButton_Click">
                <TextBlock Text="{Binding ConfirmStartText}"
                           FontSize="{DynamicResource Type.Size.Caption}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding IsFileStreamConfirmationOpen}"
                Padding="14"
                BorderBrush="{DynamicResource Brush.Accent.Clay}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.S}">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="16">
            <TextBlock Grid.Column="0"
                       Text="{Binding FileStreamConfirmationText}"
                       FontSize="{DynamicResource Type.Size.Body}"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
              <Button Padding="10,6"
                      Background="Transparent"
                      BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.S}"
                      AutomationProperties.Name="{Binding CancelConfirmationText}"
                      Click="CancelFileStreamButton_Click">
                <TextBlock Text="{Binding CancelConfirmationText}"
                           FontSize="{DynamicResource Type.Size.Caption}" />
              </Button>
              <Button Padding="10,6"
                      Background="{DynamicResource Brush.Accent.Clay}"
                      Foreground="White"
                      CornerRadius="{DynamicResource Radius.S}"
                      AutomationProperties.Name="{Binding ConfirmFileStreamText}"
                      Click="ConfirmFileStreamButton_Click">
                <TextBlock Text="{Binding ConfirmFileStreamText}"
                           FontSize="{DynamicResource Type.Size.Caption}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="3"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="10">
        <TextBlock Grid.Row="0"
                   Text="{Binding ClientTitle}"
                   FontSize="{DynamicResource Type.Size.Subtitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}" />

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10"
              IsVisible="{Binding HasHostDiscovery}">
          <ComboBox Grid.Column="0"
                    ItemsSource="{Binding DiscoveredHosts}"
                    SelectedItem="{Binding SelectedDiscoveredHost, Mode=TwoWay}"
                    AutomationProperties.Name="{Binding DiscoveredHostsLabel}"
                    IsEnabled="{Binding HasDiscoveredHosts}"
                    FontSize="{DynamicResource Type.Size.Caption}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding DisplayName}"
                             FontSize="{DynamicResource Type.Size.Caption}" />
                  <TextBlock Text="{Binding Address}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1"
                  Padding="12,7"
                  Background="{DynamicResource Brush.Accent.Slate}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsEnabled="{Binding CanDiscoverHosts}"
                  AutomationProperties.Name="{Binding RefreshHostsText}"
                  Click="DiscoverHostsButton_Click">
            <TextBlock Text="{Binding RefreshHostsText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              IsVisible="{Binding HasProfileManagement}">
          <ComboBox Grid.Column="0"
                    ItemsSource="{Binding ClassroomProfiles}"
                    SelectedItem="{Binding SelectedClassroomProfile, Mode=TwoWay}"
                    AutomationProperties.Name="{Binding SavedProfileLabel}"
                    IsEnabled="{Binding HasClassroomProfiles}"
                    FontSize="{DynamicResource Type.Size.Caption}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding DisplayName}"
                             FontSize="{DynamicResource Type.Size.Caption}" />
                  <TextBlock Text="{Binding Role}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Column="1"
                     Text="{Binding ProfileDisplayName}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="2*,*,Auto"
              ColumnSpacing="10">
          <TextBox Grid.Column="0"
                   Text="{Binding JoinLink, Mode=TwoWay}"
                   Watermark="{Binding JoinLinkLabel}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   TextWrapping="NoWrap"
                   AutomationProperties.Name="{Binding JoinLinkLabel}" />
          <TextBox Grid.Column="1"
                   Text="{Binding ProfileDisplayName, Mode=TwoWay}"
                   Watermark="{Binding ProfileDisplayNameLabel}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   TextWrapping="NoWrap"
                   AutomationProperties.Name="{Binding ProfileDisplayNameLabel}" />
          <Button Grid.Column="2"
                  Padding="12,7"
                  Background="{DynamicResource Brush.Accent.Sage}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsEnabled="{Binding CanConnectToHost}"
                  AutomationProperties.Name="{Binding ConnectToHostText}"
                  Click="ConnectToHostButton_Click">
            <TextBlock Text="{Binding ConnectToHostText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
        </Grid>

        <Grid Grid.Row="4"
              ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="14">
          <CheckBox Grid.Column="0"
                    Content="{Binding GuestProfileText}"
                    IsChecked="{Binding UseGuestProfile, Mode=TwoWay}"
                    FontSize="{DynamicResource Type.Size.Caption}" />
          <CheckBox Grid.Column="1"
                    Content="{Binding AcceptTrustText}"
                    IsChecked="{Binding AcceptFirstUseTrust, Mode=TwoWay}"
                    FontSize="{DynamicResource Type.Size.Caption}" />
          <TextBlock Grid.Column="2"
                     Text="{Binding ClientConnectionStatusText}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="5"
              ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="14">
          <CheckBox Grid.Column="0"
                    Content="{Binding SyncOptInText}"
                    IsChecked="{Binding IsSyncOptInEnabled, Mode=TwoWay}"
                    IsVisible="{Binding HasPersistentSyncSettings}"
                    FontSize="{DynamicResource Type.Size.Caption}"
                    Click="SyncSettingsCheckBox_Click" />
          <CheckBox Grid.Column="1"
                    Content="{Binding SyncOnReconnectText}"
                    IsChecked="{Binding SyncOnReconnect, Mode=TwoWay}"
                    IsEnabled="{Binding CanSyncOnReconnect}"
                    IsVisible="{Binding HasPersistentSyncSettings}"
                    FontSize="{DynamicResource Type.Size.Caption}"
                    Click="SyncSettingsCheckBox_Click" />
        </Grid>

        <Grid Grid.Row="6"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">
          <TextBlock Grid.Column="0"
                     Text="{Binding SyncStatusText}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Padding="12,7"
                  Background="{DynamicResource Brush.Accent.Ink}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsEnabled="{Binding CanSyncNow}"
                  AutomationProperties.Name="{Binding SyncNowText}"
                  Click="SyncNowButton_Click">
            <TextBlock Text="{Binding SyncNowText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
        </Grid>

        <Grid Grid.Row="7"
              RowDefinitions="Auto,Auto"
              RowSpacing="8"
              IsVisible="{Binding HasPendingAnnotationConflicts}">
          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding PendingAnnotationConflicts}"
                      SelectedItem="{Binding SelectedAnnotationConflict, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding SyncConflictsLabel}"
                      FontSize="{DynamicResource Type.Size.Caption}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding LocalAnnotation.BookId}"
                               FontSize="{DynamicResource Type.Size.Caption}" />
                    <TextBlock Text="{Binding LocalAnnotation.Body}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1"
                    Padding="12,7"
                    Background="{DynamicResource Brush.Accent.Sage}"
                    Foreground="White"
                    CornerRadius="{DynamicResource Radius.S}"
                    IsEnabled="{Binding CanResolveAnnotationConflict}"
                    AutomationProperties.Name="{Binding KeepLocalText}"
                    Click="KeepLocalConflictButton_Click">
              <TextBlock Text="{Binding KeepLocalText}"
                         FontSize="{DynamicResource Type.Size.Caption}" />
            </Button>
            <Button Grid.Column="2"
                    Padding="12,7"
                    Background="{DynamicResource Brush.Accent.Slate}"
                    Foreground="White"
                    CornerRadius="{DynamicResource Radius.S}"
                    IsEnabled="{Binding CanResolveAnnotationConflict}"
                    AutomationProperties.Name="{Binding KeepServerText}"
                    Click="KeepServerConflictButton_Click">
              <TextBlock Text="{Binding KeepServerText}"
                         FontSize="{DynamicResource Type.Size.Caption}" />
            </Button>
          </Grid>
          <TextBlock Grid.Row="1"
                     Text="{Binding SelectedConflictText}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap" />
        </Grid>
      </Grid>

      <Border Grid.Row="4"
              IsVisible="{Binding HasSchoolAdministration}"
              Padding="16"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.S}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="16">
          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="3">
              <TextBlock Text="{Binding SchoolAdminTitle}"
                         FontSize="{DynamicResource Type.Size.Subtitle}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <TextBlock Text="{Binding SchoolAdminStatusText}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Padding="12,7"
                    Background="{DynamicResource Brush.Accent.Slate}"
                    Foreground="White"
                    CornerRadius="{DynamicResource Radius.S}"
                    AutomationProperties.Name="Refresh school administration"
                    Click="RefreshSchoolAdminButton_Click">
              <TextBlock Text="Refresh"
                         FontSize="{DynamicResource Type.Size.Caption}" />
            </Button>
          </Grid>

          <Grid Grid.Row="1"
                ColumnDefinitions="*,*"
                ColumnSpacing="18">
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Text="Managed profiles"
                         FontSize="{DynamicResource Type.Size.Body}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <Grid ColumnDefinitions="2*,*,*,Auto"
                    ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding EnrollmentDisplayName, Mode=TwoWay}"
                         Watermark="Student or teacher name"
                         AutomationProperties.Name="Enrollment display name"
                         FontSize="{DynamicResource Type.Size.Caption}" />
                <TextBox Grid.Column="1"
                         Text="{Binding EnrollmentRole, Mode=TwoWay}"
                         Watermark="Role"
                         AutomationProperties.Name="Enrollment role"
                         FontSize="{DynamicResource Type.Size.Caption}" />
                <TextBox Grid.Column="2"
                         Text="{Binding EnrollmentBirthYearText, Mode=TwoWay}"
                         Watermark="Birth year"
                         AutomationProperties.Name="Enrollment birth year"
                         FontSize="{DynamicResource Type.Size.Caption}" />
                <Button Grid.Column="3"
                        Padding="12,7"
                        Background="{DynamicResource Brush.Accent.Sage}"
                        Foreground="White"
                        CornerRadius="{DynamicResource Radius.S}"
                        IsEnabled="{Binding CanEnrollProfile}"
                        AutomationProperties.Name="Enroll managed profile"
                        Click="EnrollProfileButton_Click">
                  <TextBlock Text="Enroll"
                             FontSize="{DynamicResource Type.Size.Caption}" />
                </Button>
              </Grid>
              <TextBox Text="{Binding LastEnrollmentTokenText, Mode=OneWay}"
                       IsVisible="{Binding HasLastEnrollmentToken}"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       AutomationProperties.Name="Latest enrollment token" />
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                <ListBox Grid.Column="0"
                         ItemsSource="{Binding EnrolledProfiles}"
                         SelectedItem="{Binding SelectedEnrolledProfile, Mode=TwoWay}"
                         MinHeight="116"
                         MaxHeight="160"
                         AutomationProperties.Name="Enrolled profiles">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="2*,*,*,*"
                            ColumnSpacing="8">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="{DynamicResource Type.Size.Caption}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Role}"
                                   FontSize="{DynamicResource Type.Size.Caption}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Status}"
                                   FontSize="{DynamicResource Type.Size.Caption}" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding BirthYear}"
                                   FontSize="{DynamicResource Type.Size.Caption}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Column="1"
                        Padding="12,7"
                        Background="{DynamicResource Brush.Accent.Clay}"
                        Foreground="White"
                        CornerRadius="{DynamicResource Radius.S}"
                        IsEnabled="{Binding CanRevokeSelectedProfile}"
                        AutomationProperties.Name="Revoke managed profile"
                        Click="RevokeProfileButton_Click">
                  <TextBlock Text="Revoke"
                             FontSize="{DynamicResource Type.Size.Caption}" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="School AI"
                         FontSize="{DynamicResource Type.Size.Body}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <Grid ColumnDefinitions="*,2*,Auto,Auto"
                    ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding SchoolAiProviderId, Mode=TwoWay}"
                         Watermark="Provider"
                         AutomationProperties.Name="School AI provider"
                         FontSize="{DynamicResource Type.Size.Caption}" />
                <TextBox x:Name="SchoolAiKeyBox"
                         Grid.Column="1"
                         PasswordChar="*"
                         Watermark="Provider key"
                         AutomationProperties.Name="School AI key"
                         FontSize="{DynamicResource Type.Size.Caption}" />
                <Button Grid.Column="2"
                        Padding="12,7"
                        Background="{DynamicResource Brush.Accent.Sage}"
                        Foreground="White"
                        CornerRadius="{DynamicResource Radius.S}"
                        IsEnabled="{Binding CanSaveSchoolAiKey}"
                        AutomationProperties.Name="Save school AI key"
                        Click="SaveSchoolAiKeyButton_Click">
                  <TextBlock Text="Save key"
                             FontSize="{DynamicResource Type.Size.Caption}" />
                </Button>
                <Button Grid.Column="3"
                        Padding="12,7"
                        Background="{DynamicResource Brush.Accent.Clay}"
                        Foreground="White"
                        CornerRadius="{DynamicResource Radius.S}"
                        IsEnabled="{Binding CanDeleteSchoolAiKey}"
                        AutomationProperties.Name="Delete school AI key"
                        Click="DeleteSchoolAiKeyButton_Click">
                  <TextBlock Text="Delete"
                             FontSize="{DynamicResource Type.Size.Caption}" />
                </Button>
              </Grid>
              <TextBlock Text="{Binding SchoolAiKeyStatusText}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                         TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*,*,Auto"
                    ColumnSpacing="8">
                <NumericUpDown Grid.Column="0"
                               Value="{Binding PerStudentDailyTokenBudget, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="10000000"
                               Increment="500"
                               AutomationProperties.Name="Per-student daily token budget"
                               FontSize="{DynamicResource Type.Size.Caption}" />
                <NumericUpDown Grid.Column="1"
                               Value="{Binding ClassDailyTokenBudget, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="100000000"
                               Increment="5000"
                               AutomationProperties.Name="Class daily token budget"
                               FontSize="{DynamicResource Type.Size.Caption}" />
                <NumericUpDown Grid.Column="2"
                               Value="{Binding PerStudentQueriesPerMinute, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="120"
                               Increment="1"
                               AutomationProperties.Name="Per-student queries per minute"
                               FontSize="{DynamicResource Type.Size.Caption}" />
                <Button Grid.Column="3"
                        Padding="12,7"
                        Background="{DynamicResource Brush.Accent.Slate}"
                        Foreground="White"
                        CornerRadius="{DynamicResource Radius.S}"
                        IsEnabled="{Binding CanSaveSchoolAiPolicy}"
                        AutomationProperties.Name="Save school AI policy"
                        Click="SaveSchoolAiPolicyButton_Click">
                  <TextBlock Text="Save policy"
                             FontSize="{DynamicResource Type.Size.Caption}" />
                </Button>
              </Grid>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2"
                ColumnDefinitions="*,*"
                ColumnSpacing="18">
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Text="Usage dashboard"
                         FontSize="{DynamicResource Type.Size.Body}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <ItemsControl ItemsSource="{Binding SchoolAiUsage}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="2*,*,*,*,*"
                          ColumnSpacing="8">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontSize="{DynamicResource Type.Size.Caption}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding QueryCount}"
                                 FontSize="{DynamicResource Type.Size.Caption}" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding TokensUsed}"
                                 FontSize="{DynamicResource Type.Size.Caption}" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding EstimatedCostUsd}"
                                 FontSize="{DynamicResource Type.Size.Caption}" />
                      <ProgressBar Grid.Column="4"
                                   Minimum="0"
                                   Maximum="100"
                                   Value="{Binding QuotaPercent}"
                                   Height="8"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Quota percentage" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="Recent audit"
                         FontSize="{DynamicResource Type.Size.Body}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding SchoolAuditFilterText, Mode=TwoWay}"
                         Watermark="Filter by profile, action, route, or payload"
                         AutomationProperties.Name="School audit filter"
                         FontSize="{DynamicResource Type.Size.Caption}" />
                <Button Grid.Column="1"
                        Padding="10,6"
                        Background="{DynamicResource Brush.Accent.Slate}"
                        Foreground="White"
                        CornerRadius="{DynamicResource Radius.S}"
                        IsEnabled="{Binding CanExportSchoolAuditCsv}"
                        AutomationProperties.Name="Export school audit CSV"
                        Click="ExportSchoolAuditCsvButton_Click">
                  <TextBlock Text="Export CSV"
                             FontSize="{DynamicResource Type.Size.Caption}" />
                </Button>
              </Grid>
              <ListBox ItemsSource="{Binding SchoolAuditEvents}"
                       MinHeight="116"
                       MaxHeight="170"
                       AutomationProperties.Name="School audit events">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="150,140,*,*"
                          ColumnSpacing="8">
                      <TextBlock Text="{Binding TimestampUtc}"
                                 FontSize="{DynamicResource Type.Size.Caption}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding ActorId}"
                                 FontSize="{DynamicResource Type.Size.Caption}" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding EventType}"
                                 FontSize="{DynamicResource Type.Size.Caption}" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding EntityId}"
                                 FontSize="{DynamicResource Type.Size.Caption}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="3"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding AiHistoryPurgeConfirmationText, Mode=TwoWay}"
                     Watermark="Type PURGE AI HISTORY to clear student AI history and usage ledger"
                     AutomationProperties.Name="AI history purge confirmation"
                     FontSize="{DynamicResource Type.Size.Caption}" />
            <Button Grid.Column="1"
                    Padding="12,7"
                    Background="{DynamicResource Brush.Accent.Clay}"
                    Foreground="White"
                    CornerRadius="{DynamicResource Radius.S}"
                    IsEnabled="{Binding CanPurgeAiHistory}"
                    AutomationProperties.Name="Purge school AI history"
                    Click="PurgeAiHistoryButton_Click">
              <TextBlock Text="Purge AI history"
                         FontSize="{DynamicResource Type.Size.Caption}" />
            </Button>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="5"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="20"
            IsVisible="{Binding CanShare}">
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                BorderThickness="1"
                Padding="10"
                VerticalAlignment="Top">
          <TextBlock Text="{Binding QrCodeText}"
                     FontFamily="Consolas, Menlo, monospace"
                     FontSize="4"
                     LineHeight="4"
                     Foreground="Black" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="10">
          <TextBlock Text="{Binding SharePanelSubtitle}"
                     FontSize="{DynamicResource Type.Size.Body}"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}"
                     TextWrapping="Wrap" />
          <TextBox Text="{Binding ManualJoinUri, Mode=OneWay}"
                   IsReadOnly="True"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   TextWrapping="NoWrap"
                   AutomationProperties.Name="LAN Host join link" />
          <TextBlock Text="{Binding EnrollmentCodeText}"
                     FontSize="{DynamicResource Type.Size.Body}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Accent.Slate}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding FullFingerprintText}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ShareConfirmationText}"
                     IsVisible="{Binding HasShareConfirmation}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Accent.Sage}"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Padding="12,7"
                    Background="{DynamicResource Brush.Accent.Slate}"
                    Foreground="White"
                    CornerRadius="{DynamicResource Radius.S}"
                    AutomationProperties.Name="{Binding CopyJoinLinkText}"
                    Click="CopyJoinLinkButton_Click">
              <TextBlock Text="{Binding CopyJoinLinkText}"
                         FontSize="{DynamicResource Type.Size.Caption}" />
            </Button>
            <Button Padding="12,7"
                    Background="{DynamicResource Brush.Accent.Oak}"
                    Foreground="White"
                    CornerRadius="{DynamicResource Radius.S}"
                    AutomationProperties.Name="{Binding CopyFingerprintText}"
                    Click="CopyFingerprintButton_Click">
              <TextBlock Text="{Binding CopyFingerprintText}"
                         FontSize="{DynamicResource Type.Size.Caption}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
