<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OgmaLibrary.App.ViewModels"
        xmlns:cat="using:OgmaLibrary.App.ViewModels.Catalogue"
        xmlns:catv="using:OgmaLibrary.App.Views.Catalogue"
        x:Class="OgmaLibrary.App.Views.DesktopShellWindow"
        x:DataType="vm:StartupShellViewModel"
        Title="{Binding Title}"
        KeyDown="DesktopShellWindow_KeyDown"
        Icon="/Assets/app.png"
        Width="1180" Height="760"
        MinWidth="860" MinHeight="560"
        Background="{DynamicResource Brush.Surface.Parchment}">

  <Grid>
    <Grid x:Name="LibrarySurface" IsVisible="{Binding IsLibraryVisible}">
      <catv:CatalogueShellView DataContext="{Binding MainShell}"
                              x:CompileBindings="False" />
    </Grid>

    <!-- Sept-23 Phase 07 (UX-003): the palette is hosted at window level so it is available on
         every route. A transparent scrim closes it on an outside click; Escape and executing a
         command close it too. Items come from the shared command registry. -->
    <Border x:Name="CommandPaletteScrim"
            IsVisible="{Binding MainShell.IsCommandPaletteOpen}"
            x:CompileBindings="False"
            Background="Transparent"
            PointerPressed="CommandPaletteScrim_PointerPressed" />
    <Border IsVisible="{Binding MainShell.IsCommandPaletteOpen}"
            x:CompileBindings="False"
            Width="560"
            MaxHeight="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16,72,16,0"
            Padding="12"
            Background="{DynamicResource Brush.Surface.Card}"
            BorderBrush="{DynamicResource Brush.Focus}"
            BorderThickness="2"
            CornerRadius="{DynamicResource Radius.L}"
            AutomationProperties.AutomationId="Shell.Palette"
            AutomationProperties.Name="{Binding MainShell.CommandPaletteTitle}">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding MainShell.CommandPaletteTitle}"
                     VerticalAlignment="Center"
                     FontSize="{DynamicResource Type.Size.Subtitle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          <Button Grid.Column="1"
                  Content="×"
                  MinWidth="36"
                  MinHeight="36"
                  Padding="0"
                  AutomationProperties.AutomationId="Shell.Palette.Close"
                  AutomationProperties.Name="{Binding MainShell.CommandPaletteCloseLabel}"
                  Click="CommandPaletteCloseButton_Click" />
        </Grid>
        <TextBox x:Name="CommandPaletteBox"
                 Grid.Row="1"
                 Text="{Binding MainShell.CommandPaletteQuery, Mode=TwoWay}"
                 Watermark="{Binding MainShell.CommandPaletteWatermark}"
                 AutomationProperties.AutomationId="Shell.Palette.Query"
                 AutomationProperties.Name="{Binding MainShell.CommandPaletteWatermark}"
                 KeyDown="CommandPaletteBox_KeyDown" />
        <ScrollViewer Grid.Row="2" MaxHeight="400">
          <ItemsControl x:Name="CommandPaletteList"
                        ItemsSource="{Binding MainShell.CommandPaletteItems}"
                        AutomationProperties.AutomationId="Shell.Palette.Results"
                        KeyDown="CommandPaletteList_KeyDown">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="cat:CommandPaletteItem">
                <Button HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,8"
                        AutomationProperties.Name="{Binding AutomationName}"
                        Click="CommandPaletteItem_Click">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                    <TextBlock Grid.Column="1"
                               Classes="ogma-mono"
                               Text="{Binding Hint}"
                               Margin="16,0,0,0"
                               FontSize="{DynamicResource Type.Size.Small}"
                               Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Sept-23 Phase 07 (T07.8): the keyboard shortcuts sheet (Ctrl/Cmd+/), generated from
         the same registry as the palette. -->
    <Border IsVisible="{Binding MainShell.IsShortcutSheetOpen}"
            x:CompileBindings="False"
            Background="Transparent"
            PointerPressed="ShortcutScrim_PointerPressed" />
    <Border IsVisible="{Binding MainShell.IsShortcutSheetOpen}"
            x:CompileBindings="False"
            Width="520"
            MaxHeight="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16,72,16,0"
            Padding="16"
            Background="{DynamicResource Brush.Surface.Card}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}"
            AutomationProperties.AutomationId="Shell.Shortcuts"
            AutomationProperties.Name="{Binding MainShell.ShortcutsTitle}">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding MainShell.ShortcutsTitle}"
                     Classes="ogma-display"
                     VerticalAlignment="Center"
                     FontSize="{DynamicResource Type.Size.Subtitle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          <Button x:Name="ShortcutsCloseButton"
                  Grid.Column="1"
                  Content="{Binding MainShell.CloseLabel}"
                  AutomationProperties.AutomationId="Shell.Shortcuts.Close"
                  AutomationProperties.Name="{Binding MainShell.CloseLabel}"
                  Click="ShortcutsClose_Click" />
        </Grid>
        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding MainShell.ShortcutRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="cat:ShortcutRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <TextBlock Text="{Binding Label}"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                  <TextBlock Grid.Column="1"
                             Classes="ogma-mono"
                             Text="{Binding Gesture}"
                             Margin="16,0,0,0"
                             FontSize="{DynamicResource Type.Size.Small}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border IsVisible="{Binding IsLoadingVisible}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="420"
            Padding="28"
            CornerRadius="{DynamicResource Radius.L}"
            Background="{DynamicResource Brush.Surface.Card}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="1"
            AutomationProperties.AutomationId="Shell.Loading"
            AutomationProperties.Name="{Binding StartingHeading}"
            AutomationProperties.LiveSetting="Polite">
      <StackPanel Spacing="14">
        <TextBlock Text="{Binding StartingHeading}"
                   Classes="ogma-display"
                   FontSize="{DynamicResource Type.Size.Title}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}" />
        <TextBlock Text="{Binding StartingBody}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource Type.Size.Body}"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
        <TextBlock Text="{Binding MigrationProgressText}"
                   IsVisible="{Binding IsMigrationProgressKnown}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
        <ProgressBar Value="{Binding MigrationProgress}"
                     IsVisible="{Binding IsMigrationProgressKnown}"
                     Height="5"
                     AutomationProperties.Name="{Binding MigrationProgressText}" />
        <ProgressBar IsIndeterminate="True"
                     Height="5"
                     AutomationProperties.Name="{Binding StartingBody}" />
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding IsDegraded}"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Width="420"
            Margin="16"
            Padding="24"
            CornerRadius="{DynamicResource Radius.L}"
            Background="{DynamicResource Brush.Surface.Card}"
            BorderBrush="{DynamicResource Brush.Accent.Clay}"
            BorderThickness="2"
            AutomationProperties.AutomationId="Shell.Degraded"
            AutomationProperties.Name="{Binding DegradedHeading}"
            AutomationProperties.LiveSetting="Assertive">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="{Binding DegradedHeading}"
                   Classes="ogma-display"
                   FontSize="{DynamicResource Type.Size.Title}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,16"
                   Text="{Binding DegradedBody}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource Type.Size.Body}"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
        <ScrollViewer Grid.Row="2">
          <ItemsControl ItemsSource="{Binding Issues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,10"
                        Padding="12"
                        CornerRadius="{DynamicResource Radius.S}"
                        Background="{DynamicResource Brush.Surface.Footer}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                    <TextBlock Text="{Binding Code}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Accent.Slate}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Spacing="10" Margin="0,16,0,0">
          <TextBlock Text="{Binding ExportStatus}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     AutomationProperties.LiveSetting="Polite" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="RetryButton"
                    MinWidth="130"
                    MinHeight="40"
                    Background="{DynamicResource Brush.Accent.Oak}"
                    Foreground="{DynamicResource Brush.Accent.OnAccent}"
                    CornerRadius="{DynamicResource Radius.S}"
                    IsEnabled="{Binding CanRetry}"
                    Content="{Binding RetryText}"
                    AutomationProperties.AutomationId="Shell.Degraded.Retry"
                    AutomationProperties.Name="{Binding RetryText}"
                    Click="RetryButton_Click" />
            <Button MinWidth="150"
                    MinHeight="40"
                    Background="Transparent"
                    Foreground="{DynamicResource Brush.Surface.OnParchment}"
                    BorderBrush="{DynamicResource Brush.Accent.Slate}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.S}"
                    IsEnabled="{Binding CanExportDiagnostics}"
                    Content="{Binding ExportDiagnosticsText}"
                    AutomationProperties.AutomationId="Shell.Degraded.ExportDiagnostics"
                    AutomationProperties.Name="{Binding ExportDiagnosticsText}"
                    Click="ExportDiagnosticsButton_Click" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sept-23 Phase 02 (T02.7): non-modal, dismissible error surface. Its DataContext is
         the process NotificationCenterViewModel, attached from code-behind so it survives the
         startup-to-runtime DataContext swap of the window. -->
    <ItemsControl x:Name="ToastHost"
                  x:DataType="vm:NotificationCenterViewModel"
                  ItemsSource="{Binding Toasts}"
                  IsVisible="{Binding HasToasts}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Width="400"
                  Margin="16"
                  AutomationProperties.AutomationId="Shell.Toasts"
                  AutomationProperties.Name="{Binding RegionName}"
                  AutomationProperties.LiveSetting="Assertive">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ToastViewModel">
          <Border Padding="14"
                  CornerRadius="{DynamicResource Radius.M}"
                  Background="{DynamicResource Brush.Surface.Card}"
                  BorderBrush="{DynamicResource Brush.Accent.Slate}"
                  BorderThickness="2"
                  Classes.error="{Binding IsError}"
                  AutomationProperties.AutomationId="Shell.Toast"
                  AutomationProperties.Name="{Binding Message}">
            <Border.Styles>
              <Style Selector="Border.error">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Clay}" />
              </Style>
            </Border.Styles>
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Message}"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource Type.Size.Body}"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{Binding ActionText}"
                        IsVisible="{Binding HasAction}"
                        Command="{Binding ActionCommand}"
                        MinHeight="36"
                        AutomationProperties.Name="{Binding ActionText}" />
                <Button Content="{Binding DismissText}"
                        Command="{Binding DismissCommand}"
                        MinHeight="36"
                        AutomationProperties.Name="{Binding DismissText}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
