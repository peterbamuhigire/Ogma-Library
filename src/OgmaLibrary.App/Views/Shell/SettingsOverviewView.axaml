<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Catalogue"
             xmlns:settings="using:OgmaLibrary.App.Views.Settings"
             x:Class="OgmaLibrary.App.Views.Shell.SettingsOverviewView"
             x:DataType="vm:MainShellViewModel">

  <!--
    Sept-23 Phase 07: the Settings route and host. Phase 08 (K16) hosts the sectioned Settings
    view here. The capability list below remains only for shells composed without Settings
    (headless tests), so no feature is ever silently missing (K17 mitigation).
  -->
  <Panel>
  <Panel IsVisible="{Binding Settings, Converter={x:Static ObjectConverters.IsNotNull}}">
    <settings:SettingsView DataContext="{Binding Settings}" />
  </Panel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                IsVisible="{Binding Settings, Converter={x:Static ObjectConverters.IsNull}}">
    <StackPanel Margin="16" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="{Binding SettingsIntro}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
      <TextBlock Text="{Binding SettingsCapabilitiesTitle}"
                 Classes="ogma-display"
                 FontSize="{DynamicResource Type.Size.Subtitle}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Surface.OnParchment}" />
      <ItemsControl ItemsSource="{Binding CapabilityRows}"
                    AutomationProperties.AutomationId="Settings.Capabilities.Overview"
                    AutomationProperties.Name="{Binding SettingsCapabilitiesTitle}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CapabilityRow">
            <Border Padding="12,10"
                    CornerRadius="{DynamicResource Radius.S}"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                    BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Status}"
                           FontSize="{DynamicResource Type.Size.Small}"
                           Foreground="{DynamicResource Brush.Accent.Ink}" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="0,4,0,0"
                           Text="{Binding Detail}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource Type.Size.Small}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
  </Panel>
</UserControl>
