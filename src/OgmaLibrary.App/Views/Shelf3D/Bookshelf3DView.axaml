<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Shelf3D"
             xmlns:messages="using:OgmaLibrary.Bookshelf3D.Messages"
             xmlns:webview="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="OgmaLibrary.App.Views.Shelf3D.Bookshelf3DView"
             x:DataType="vm:Bookshelf3DViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="12">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <svg:Svg Width="20"
                 Height="20"
                 Path="{Binding ToggleIconPath}" />
        <TextBlock Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="1"
              AutomationProperties.Name="{Binding ShelfLayoutLabel}"
              ToolTip.Tip="{Binding ShelfLayoutLabel}"
              Click="ShelfLayout_Click">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <svg:Svg Width="14"
                   Height="14"
                   Path="{Binding ShelfLayoutIconPath}" />
          <TextBlock Text="{Binding ShelfLayoutLabel}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2"
              AutomationProperties.Name="{Binding GridLayoutLabel}"
              ToolTip.Tip="{Binding GridLayoutLabel}"
              Click="GridLayout_Click">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <svg:Svg Width="14"
                   Height="14"
                   Path="{Binding GridLayoutIconPath}" />
          <TextBlock Text="{Binding GridLayoutLabel}" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1">
      <Border IsVisible="{Binding IsInteractive3DVisible}"
              BorderBrush="{DynamicResource ThemeBorderLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Background="{DynamicResource ThemeSurfaceSubtleBrush}"
              MinHeight="360"
              AutomationProperties.Name="{Binding WebViewHostLabel}">
        <webview:NativeWebView x:Name="WebViewHost"
                               Focusable="True"
                               IsTabStop="True" />
      </Border>

      <Border IsVisible="{Binding IsFallbackVisible}"
              BorderBrush="{DynamicResource ThemeBorderLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12"
              Background="{DynamicResource ThemeSurfaceSubtleBrush}">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <svg:Svg Width="18"
                     Height="18"
                     Path="{Binding UnavailableIconPath}" />
            <TextBlock Text="{Binding FallbackMessage}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Books}"
                   MinHeight="320"
                   AutomationProperties.Name="{Binding FallbackListLabel}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="messages:BookSceneItem">
                <Grid ColumnDefinitions="2*,*" ColumnSpacing="10" Margin="0,3">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Author}"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
