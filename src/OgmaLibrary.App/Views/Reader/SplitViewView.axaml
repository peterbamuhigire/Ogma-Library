<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Reader"
             xmlns:reader="using:OgmaLibrary.App.Views.Reader"
             x:Class="OgmaLibrary.App.Views.Reader.SplitViewView"
             x:DataType="vm:SplitViewViewModel"
             AutomationProperties.Name="{Binding AccessibleLabel}">

  <Grid RowDefinitions="Auto,*"
        Background="{DynamicResource Brush.Surface.Parchment}">
    <Border Padding="14,10"
            Background="{DynamicResource Brush.Surface.Footer}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="0,0,0,1">
      <TextBlock Text="{Binding Title}"
                 FontSize="{DynamicResource Type.Size.Subtitle}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Surface.OnParchment}" />
    </Border>

    <Grid Grid.Row="1"
          ColumnDefinitions="*,*"
          MinHeight="320">
      <Border Padding="16"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="0,0,1,0">
        <reader:ReaderView DataContext="{Binding LeftReader}" />
      </Border>

      <Border Grid.Column="1"
              Padding="8">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
            <TextBox Width="180"
                     Text="{Binding ReferenceBookId, Mode=TwoWay}"
                     Watermark="{Binding RightPaneText}"
                     AutomationProperties.Name="{Binding RightPaneText}" />
            <Button IsEnabled="{Binding CanOpenReference}"
                    AutomationProperties.Name="{Binding OpenReferenceLabel}"
                    Click="OpenReferenceButton_Click">
              <TextBlock Text="{Binding OpenReferenceLabel}" />
            </Button>
          </StackPanel>
          <reader:ReaderView Grid.Row="1" DataContext="{Binding RightReader}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
