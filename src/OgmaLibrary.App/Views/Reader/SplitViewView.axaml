<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Reader"
             xmlns:reader="using:OgmaLibrary.App.Views.Reader"
             x:Class="OgmaLibrary.App.Views.Reader.SplitViewView"
             x:DataType="vm:SplitViewViewModel"
             AutomationProperties.Name="{Binding AccessibleLabel}">

  <Grid RowDefinitions="Auto,*"
        Background="{DynamicResource Brush.Surface.Parchment}">
    <Border Padding="14,10"
            Background="{DynamicResource Brush.Surface.Footer}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Title}"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource Type.Size.Subtitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}" />
        <CheckBox Grid.Column="1"
                  IsChecked="{Binding SyncScroll, Mode=TwoWay}"
                  Content="{Binding SyncScrollLabel}"
                  AutomationProperties.AutomationId="Reader.Split.SyncScroll"
                  AutomationProperties.Name="{Binding SyncScrollLabel}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          ColumnDefinitions="*,*"
          MinHeight="320">
      <!-- Left pane: own session, own picker, own reader. -->
      <Border Padding="8"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*"
              DataContext="{Binding LeftPane}"
              x:DataType="vm:SplitPaneViewModel">
          <TextBox Text="{Binding Picker.Query, Mode=TwoWay}"
                   Watermark="{Binding Picker.Label}"
                   AutomationProperties.AutomationId="Reader.Split.Picker.Left"
                   AutomationProperties.Name="{Binding Picker.Label}" />
          <ListBox Grid.Row="1"
                   MaxHeight="160"
                   ItemsSource="{Binding Picker.Results}"
                   IsVisible="{Binding Picker.HasResults}"
                   AutomationProperties.AutomationId="Reader.Split.Results.Left"
                   AutomationProperties.Name="{Binding Picker.Label}"
                   SelectionChanged="PickerResults_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BookPickerItem">
                <TextBlock Text="{Binding Display}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="{Binding Display}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1"
                     Text="{Binding Picker.EmptyText}"
                     IsVisible="{Binding Picker.IsEmptyVisible}"
                     Margin="4,6"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          <reader:ReaderView Grid.Row="2" DataContext="{Binding Reader}" />
        </Grid>
      </Border>

      <!-- Right pane: its own independent session. -->
      <Border Grid.Column="1" Padding="8">
        <Grid RowDefinitions="Auto,Auto,*"
              DataContext="{Binding RightPane}"
              x:DataType="vm:SplitPaneViewModel">
          <TextBox Text="{Binding Picker.Query, Mode=TwoWay}"
                   Watermark="{Binding Picker.Label}"
                   AutomationProperties.AutomationId="Reader.Split.Picker.Right"
                   AutomationProperties.Name="{Binding Picker.Label}" />
          <ListBox Grid.Row="1"
                   MaxHeight="160"
                   ItemsSource="{Binding Picker.Results}"
                   IsVisible="{Binding Picker.HasResults}"
                   AutomationProperties.AutomationId="Reader.Split.Results.Right"
                   AutomationProperties.Name="{Binding Picker.Label}"
                   SelectionChanged="PickerResults_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BookPickerItem">
                <TextBlock Text="{Binding Display}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="{Binding Display}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1"
                     Text="{Binding Picker.EmptyText}"
                     IsVisible="{Binding Picker.IsEmptyVisible}"
                     Margin="4,6"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          <reader:ReaderView Grid.Row="2" DataContext="{Binding Reader}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
