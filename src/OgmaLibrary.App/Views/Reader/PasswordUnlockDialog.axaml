<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OgmaLibrary.App.ViewModels.Reader"
        x:Class="OgmaLibrary.App.Views.Reader.PasswordUnlockDialog"
        x:DataType="vm:PasswordUnlockDialogViewModel"
        Width="440"
        SizeToContent="Height"
        MinWidth="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface.Page}"
        Title="{Binding Title}"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.AutomationId="PasswordUnlock.Dialog"
        AutomationProperties.Name="{Binding Title}">
  <!-- Sept-23 Phase 12 (READ-009, D-92): in-app unlock. The keychain checkbox is unchecked by
       default; Escape cancels; Enter unlocks. The wrong-password message is a live region. -->
  <StackPanel Spacing="12" Margin="20">
    <TextBlock Classes="heading"
               Text="{Binding Title}"
               Foreground="{DynamicResource Brush.Text.Primary}" />
    <TextBlock Text="{Binding PromptText}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.Text.Primary}" />
    <TextBlock Text="{Binding PasswordLabel}"
               FontWeight="SemiBold"
               Foreground="{DynamicResource Brush.Text.Primary}" />
    <TextBox x:Name="PasswordBox"
             PasswordChar="*"
             MinHeight="36"
             AutomationProperties.AutomationId="PasswordUnlock.Password"
             AutomationProperties.Name="{Binding PasswordLabel}" />
    <TextBlock Text="{Binding WrongPasswordText}"
               IsVisible="{Binding WrongPassword}"
               TextWrapping="Wrap"
               AutomationProperties.AutomationId="PasswordUnlock.WrongPassword"
               AutomationProperties.LiveSetting="Assertive"
               Foreground="{DynamicResource Brush.Text.Primary}" />
    <CheckBox x:Name="RememberBox"
              IsChecked="False"
              Content="{Binding RememberText}"
              AutomationProperties.AutomationId="PasswordUnlock.Remember"
              AutomationProperties.Name="{Binding RememberText}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button MinHeight="36"
              Click="Cancel_Click"
              AutomationProperties.AutomationId="PasswordUnlock.Cancel"
              AutomationProperties.Name="{Binding CancelText}">
        <TextBlock Text="{Binding CancelText}" />
      </Button>
      <Button Classes="primary"
              MinHeight="36"
              Click="Unlock_Click"
              AutomationProperties.AutomationId="PasswordUnlock.Unlock"
              AutomationProperties.Name="{Binding UnlockText}">
        <TextBlock Text="{Binding UnlockText}" />
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
