<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Reader"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             xmlns:reader="using:OgmaLibrary.App.Views.Reader"
             x:Class="OgmaLibrary.App.Views.Reader.ReaderView"
             x:Name="Root"
             x:DataType="vm:ReaderViewModel"
             Focusable="True"
             KeyDown="ReaderView_KeyDown">

  <UserControl.Styles>
    <Style Selector="Button.edge-zone">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*"
        Background="{DynamicResource Brush.Surface.Parchment}">

    <!-- Sept-23 Phase 12: one slim toolbar. Back, title, page field, zoom, layout, search,
         annotate tools (one group), more, side panel. Page turning is by keyboard, the page
         field and the edge zones; there is no second navigation row. -->
    <Border Grid.Row="0"
            x:Name="ReaderToolbar"
            Padding="12,6"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="0,0,0,1"
            TextElement.FontFamily="{DynamicResource Type.FontFamily.Body}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0"
                Classes="tool primary"
                AutomationProperties.AutomationId="Reader.BackToLibrary"
                AutomationProperties.Name="{Binding BackToLibraryLabel}"
                Click="BackToLibraryButton_Click">
          <TextBlock Text="{Binding BackToLibraryLabel}" />
        </Button>

        <TextBlock Grid.Column="1"
                   Classes="ogma-display"
                   Text="{Binding ReaderTitle}"
                   FontSize="{DynamicResource Type.Size.Subtitle}"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="Reader.Title" />

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
          <Button Classes="tool"
                  IsEnabled="{Binding CanHistoryBack}"
                  AutomationProperties.AutomationId="Reader.History.Back"
                  AutomationProperties.Name="{Binding HistoryBackLabel}"
                  ToolTip.Tip="{Binding HistoryBackLabel}"
                  Click="HistoryBackButton_Click">
            <TextBlock Text="&#x2190;" />
          </Button>
          <Button Classes="tool"
                  IsEnabled="{Binding CanHistoryForward}"
                  AutomationProperties.AutomationId="Reader.History.Forward"
                  AutomationProperties.Name="{Binding HistoryForwardLabel}"
                  ToolTip.Tip="{Binding HistoryForwardLabel}"
                  Click="HistoryForwardButton_Click">
            <TextBlock Text="&#x2192;" />
          </Button>
          <TextBox x:Name="PageNumberBox"
                   Width="56"
                   Text="{Binding PageNumberInput, Mode=TwoWay}"
                   HorizontalContentAlignment="Center"
                   FontFeatures="tnum"
                   AutomationProperties.AutomationId="Reader.PageNumber"
                   AutomationProperties.Name="{Binding JumpToPageLabel}"
                   ToolTip.Tip="{Binding JumpToPageLabel}"
                   KeyDown="PageNumberBox_KeyDown" />
          <TextBlock Text="/"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
          <TextBlock Text="{Binding PageCount}"
                     MinWidth="34"
                     FontFeatures="tnum"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
        </StackPanel>

        <DropDownButton Grid.Column="3"
                        Classes="tool"
                        AutomationProperties.AutomationId="Reader.Zoom"
                        AutomationProperties.Name="{Binding ZoomMenuLabel}"
                        ToolTip.Tip="{Binding ZoomMenuLabel}">
          <TextBlock Text="{Binding ZoomPercentLabel}" FontFeatures="tnum" />
          <DropDownButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{Binding FitWidthLabel}"
                        AutomationProperties.AutomationId="Reader.Zoom.FitWidth"
                        Click="FitWidthButton_Click" />
              <MenuItem Header="{Binding FitPageLabel}"
                        AutomationProperties.AutomationId="Reader.Zoom.FitPage"
                        Click="FitPageButton_Click" />
              <Separator />
              <MenuItem Header="50%" Tag="50" Click="ZoomPresetItem_Click" />
              <MenuItem Header="75%" Tag="75" Click="ZoomPresetItem_Click" />
              <MenuItem Header="100%" Tag="100" Click="ZoomPresetItem_Click" />
              <MenuItem Header="125%" Tag="125" Click="ZoomPresetItem_Click" />
              <MenuItem Header="150%" Tag="150" Click="ZoomPresetItem_Click" />
              <MenuItem Header="200%" Tag="200" Click="ZoomPresetItem_Click" />
              <MenuItem Header="300%" Tag="300" Click="ZoomPresetItem_Click" />
              <MenuItem Header="400%" Tag="400" Click="ZoomPresetItem_Click" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>

        <DropDownButton Grid.Column="4"
                        Classes="tool"
                        AutomationProperties.AutomationId="Reader.Layout"
                        AutomationProperties.Name="{Binding LayoutMenuLabel}"
                        ToolTip.Tip="{Binding LayoutMenuLabel}">
          <TextBlock Text="{Binding LayoutMenuLabel}" />
          <DropDownButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{Binding LayoutSingleLabel}" Tag="SinglePage" Click="LayoutItem_Click" />
              <MenuItem Header="{Binding LayoutTwoPageLabel}" Tag="TwoPage" Click="LayoutItem_Click" />
              <MenuItem Header="{Binding LayoutContinuousLabel}" Tag="Continuous" Click="LayoutItem_Click" />
              <Separator />
              <MenuItem Header="{Binding CoverAloneLabel}"
                        ToggleType="CheckBox"
                        IsChecked="{Binding CoverAlone, Mode=OneWay}"
                        AutomationProperties.AutomationId="Reader.Layout.CoverAlone"
                        Click="CoverAloneItem_Click" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>

        <Button Grid.Column="5"
                Classes="tool"
                IsEnabled="{Binding IsSearchAvailable}"
                AutomationProperties.AutomationId="Reader.Search"
                AutomationProperties.Name="{Binding SearchToggleLabel}"
                ToolTip.Tip="{Binding SearchToggleLabel}"
                Click="FindButton_Click">
          <TextBlock Text="{Binding SearchToggleLabel}" />
        </Button>

        <DropDownButton Grid.Column="6"
                        Classes="tool"
                        AutomationProperties.AutomationId="Reader.Annotate"
                        AutomationProperties.Name="{Binding AnnotateMenuLabel}"
                        ToolTip.Tip="{Binding AnnotateMenuLabel}">
          <TextBlock Text="{Binding AnnotateMenuLabel}" />
          <DropDownButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Orientation="Vertical"
                              Spacing="6"
                              MinWidth="240"
                              Margin="4">
                  <svg:Svg Width="16"
                           Height="16"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding ChooseHighlightColorLabel}"
                           ToolTip.Tip="{Binding ChooseHighlightColorLabel}"
                           Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_annotation_highlight_color.svg" />
                  <ItemsControl ItemsSource="{Binding HighlightColorOptions}"
                                VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:HighlightColorOption">
                        <Button Padding="4"
                                MinWidth="28"
                                MinHeight="28"
                                AutomationProperties.Name="{Binding AccessibleLabel}"
                                ToolTip.Tip="{Binding Label}"
                                Click="HighlightColorButton_Click">
                          <Grid Width="16" Height="16">
                            <Border CornerRadius="8"
                                    BorderBrush="{DynamicResource Brush.Surface.OnParchment}"
                                    BorderThickness="1"
                                    Background="{Binding Color}" />
                            <TextBlock Text="{Binding SelectedMarker}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="{DynamicResource Type.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Accent.OnAccent}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="primary" Padding="12,6"
                          CornerRadius="{DynamicResource Radius.S}"
                          AutomationProperties.Name="{Binding CreateHighlightLabel}"
                          Click="CreateHighlightButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <svg:Svg Width="16"
                               Height="16"
                               Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_annotation_highlight.svg" />
                      <TextBlock Text="{Binding CreateHighlightLabel}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="danger" Padding="12,6"
                          CornerRadius="{DynamicResource Radius.S}"
                          AutomationProperties.Name="{Binding CreateNoteLabel}"
                          Click="CreateNoteButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <svg:Svg Width="16"
                               Height="16"
                               Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_annotation_note.svg" />
                      <TextBlock Text="{Binding CreateNoteLabel}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="primary" Padding="12,6"
                          CornerRadius="{DynamicResource Radius.S}"
                          AutomationProperties.Name="{Binding AddBookmarkLabel}"
                          Click="AddBookmarkButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <svg:Svg Width="16"
                               Height="16"
                               Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_bookmark_add.svg" />
                      <TextBlock Text="{Binding AddBookmarkLabel}" />
                    </StackPanel>
                  </Button>
                  <Button Padding="12,6"
                          AutomationProperties.Name="{Binding CaptureCitationLabel}"
                          Click="CaptureCitationButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <svg:Svg Width="16"
                               Height="16"
                               Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_citation_capture.svg" />
                      <TextBlock Text="{Binding CaptureCitationLabel}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>

        <DropDownButton Grid.Column="7"
                        Classes="tool"
                        AutomationProperties.AutomationId="Reader.More"
                        AutomationProperties.Name="{Binding MoreMenuLabel}"
                        ToolTip.Tip="{Binding MoreMenuLabel}">
          <TextBlock Text="..." />
          <DropDownButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{Binding ImportReaderStateLabel}"
                        AutomationProperties.AutomationId="Reader.More.ImportState"
                        IsEnabled="{Binding CanUsePortability}"
                        Click="ImportReaderStateButton_Click" />
              <MenuItem Header="{Binding ExportReaderStateLabel}"
                        AutomationProperties.AutomationId="Reader.More.ExportState"
                        IsEnabled="{Binding CanUsePortability}"
                        Click="ExportReaderStateButton_Click" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>

        <ToggleButton Grid.Column="8"
                      Classes="tool"
                      IsChecked="{Binding IsSidePanelOpen, Mode=OneWay}"
                      AutomationProperties.AutomationId="Reader.SidePanelToggle"
                      AutomationProperties.Name="{Binding SidePanelToggleLabel}"
                      ToolTip.Tip="{Binding SidePanelToggleLabel}"
                      Click="SidePanelToggle_Click">
          <TextBlock Text="{Binding SidePanelToggleLabel}" />
        </ToggleButton>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            x:Name="FindBar"
            IsVisible="{Binding IsFindOpen}"
            Padding="12,6"
            Background="{DynamicResource Brush.Surface.Card}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="0,0,0,1"
            TextElement.FontFamily="{DynamicResource Type.FontFamily.Body}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0"
                   Text="{Binding FindLabel}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
        <TextBox Grid.Column="1"
                 x:Name="FindBox"
                 MaxWidth="420"
                 MinWidth="240"
                 HorizontalAlignment="Left"
                 Text="{Binding FindQuery, Mode=TwoWay}"
                 Watermark="{Binding FindPlaceholder}"
                 AutomationProperties.AutomationId="Reader.Find.Box"
                 AutomationProperties.Name="{Binding FindLabel}"
                 KeyDown="FindBox_KeyDown" />
        <TextBlock Grid.Column="2"
                   Text="{Binding FindCountText}"
                   FontFeatures="tnum"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                   AutomationProperties.AutomationId="Reader.Find.Count"
                   AutomationProperties.Name="{Binding FindCountText}" />
        <Button Grid.Column="3"
                Classes="tool"
                IsEnabled="{Binding HasFindResults}"
                AutomationProperties.AutomationId="Reader.Find.Previous"
                AutomationProperties.Name="{Binding FindPreviousLabel}"
                ToolTip.Tip="{Binding FindPreviousLabel}"
                Click="FindPreviousButton_Click">
          <TextBlock Text="&#x2191;" />
        </Button>
        <Button Grid.Column="4"
                Classes="tool"
                IsEnabled="{Binding HasFindResults}"
                AutomationProperties.AutomationId="Reader.Find.Next"
                AutomationProperties.Name="{Binding FindNextLabel}"
                ToolTip.Tip="{Binding FindNextLabel}"
                Click="FindNextButton_Click">
          <TextBlock Text="&#x2193;" />
        </Button>
        <Button Grid.Column="5"
                Classes="tool"
                AutomationProperties.AutomationId="Reader.Find.Close"
                AutomationProperties.Name="{Binding FindCloseLabel}"
                ToolTip.Tip="{Binding FindCloseLabel}"
                Click="FindCloseButton_Click">
          <TextBlock Text="&#x2715;" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <ScrollViewer x:Name="PageScrollViewer"
                    AutomationProperties.AutomationId="Reader.Viewport"
                    Grid.Column="0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    reader:ReaderRenderScaling.IsEnabled="True"
                    Focusable="True">
        <Border x:Name="PageSurface"
                IsVisible="{Binding IsPagedLayout}"
                Margin="20"
                Width="{Binding PageSurfaceWidth}"
                Height="{Binding PageSurfaceHeight}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.S}"
                Background="{DynamicResource Brush.Surface.Page}"
                PointerPressed="PageSurface_PointerPressed"
                PointerMoved="PageSurface_PointerMoved"
                PointerReleased="PageSurface_PointerReleased">
        <Grid RowDefinitions="*,Auto" ClipToBounds="True">
          <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image AutomationProperties.AutomationId="Reader.Page"
                   Source="{Binding PageImage}"
                   Width="{Binding SinglePageSurfaceWidth}"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   IsVisible="{Binding HasPageImage}" />
            <Image AutomationProperties.AutomationId="Reader.PageSecond"
                   Source="{Binding SecondPageImage}"
                   Width="{Binding SinglePageSurfaceWidth}"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   IsVisible="{Binding HasSecondPage}" />
          </StackPanel>

          <TextBlock Grid.Row="0"
                     Text="{Binding PageStatusText}"
                     Classes="ogma-display"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="{Binding !HasPageImage}"
                     FontSize="{DynamicResource Type.Size.Display}"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />

          <StackPanel Grid.Row="0"
                      IsVisible="{Binding HasRenderError}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock Text="{Binding RenderErrorText}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}" />
            <Button Content="{Binding RetryRenderText}"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="{Binding RetryRenderText}"
                    Click="RetryRenderButton_Click" />
          </StackPanel>

          <ItemsControl Grid.Row="0"
                        ItemsSource="{Binding AnnotationOverlays}"
                        HorizontalAlignment="Left"
                        Width="{Binding SinglePageSurfaceWidth}"
                        Height="{Binding PageSurfaceHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Grid />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AnnotationOverlayItem">
                <Grid>
                  <Border Width="{Binding Width}"
                          Height="{Binding Height}"
                          Margin="{Binding Margin}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Background="{Binding OverlayColor}"
                          Opacity="0.8"
                          CornerRadius="3"
                          IsHitTestVisible="False"
                          AutomationProperties.Name="{Binding AccessibleLabel}" />
                  <Button Classes="tool" Width="24"
                          Height="24"
                          Padding="3"
                          Margin="{Binding NoteAnchorMargin}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          BorderThickness="0"
                          IsVisible="{Binding IsNote}"
                          AutomationProperties.Name="{Binding NoteAnchorAccessibleLabel}"
                          ToolTip.Tip="{Binding NoteAnchorAccessibleLabel}"
                          Click="NoteAnchorButton_Click">
                    <svg:Svg Width="16"
                             Height="16"
                             Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_annotation_note_anchor.svg" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl Grid.Row="0"
                        ItemsSource="{Binding FindHighlights}"
                        HorizontalAlignment="Left"
                        IsHitTestVisible="False"
                        Width="{Binding SinglePageSurfaceWidth}"
                        Height="{Binding PageSurfaceHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Grid />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FindHighlightItem">
                <Border Width="{Binding Width}"
                        Height="{Binding Height}"
                        Margin="{Binding Margin}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{DynamicResource Brush.Accent.Saffron}"
                        BorderBrush="{DynamicResource Brush.Accent.Ink}"
                        BorderThickness="1"
                        Opacity="0.55"
                        CornerRadius="2"
                        IsHitTestVisible="False" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="0"
                  Width="{Binding SelectionOverlay.Width}"
                  Height="{Binding SelectionOverlay.Height}"
                  Margin="{Binding SelectionOverlay.Margin}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  BorderBrush="{DynamicResource Brush.Accent.Ink}"
                  BorderThickness="1"
                  Background="{DynamicResource Brush.Accent.Oak}"
                  Opacity="0.28"
                  IsVisible="{Binding HasSelection}" />

          <Border x:Name="SelectionActionMenu"
                  Grid.Row="0"
                  Margin="{Binding SelectionOverlay.ActionMargin}"
                  Padding="6"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Background="{DynamicResource Brush.Surface.Card}"
                  BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsVisible="{Binding HasSelection}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Padding="8,4"
                      AutomationProperties.Name="{Binding CreateHighlightLabel}"
                      Click="SelectionHighlightButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <svg:Svg Width="14"
                           Height="14"
                           Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_annotation_highlight.svg" />
                  <TextBlock Text="{Binding CreateHighlightLabel}" />
                </StackPanel>
              </Button>
              <Button Padding="8,4"
                      AutomationProperties.Name="{Binding CreateNoteLabel}"
                      Click="SelectionNoteButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <svg:Svg Width="14"
                           Height="14"
                           Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_annotation_note.svg" />
                  <TextBlock Text="{Binding CreateNoteLabel}" />
                </StackPanel>
              </Button>
              <Button Padding="8,4"
                      AutomationProperties.Name="{Binding CaptureCitationLabel}"
                      Click="SelectionCitationButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <svg:Svg Width="14"
                           Height="14"
                           Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_citation_capture.svg" />
                  <TextBlock Text="{Binding CaptureCitationLabel}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <TextBlock Grid.Row="1"
                     Text="{Binding StatusMessage}"
                     IsVisible="{Binding HasStatusMessage}"
                     Margin="16"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Accent.Plum}"
                     AutomationProperties.LiveSetting="Polite" />

          <Border Grid.RowSpan="2"
                  Width="420"
                  MaxWidth="520"
                  Padding="18"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource Brush.Surface.Card}"
                  BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsVisible="{Binding HasCitationCard}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding CaptureCitationLabel}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                  <TextBlock Text="{Binding CitationCard.PageText}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Padding="8,4"
                        AutomationProperties.Name="{Binding CloseCitationLabel}"
                        Click="CloseCitationButton_Click">
                  <TextBlock Text="x" />
                </Button>
              </Grid>

              <TextBlock Text="{Binding CitationCard.Title}"
                         TextWrapping="Wrap"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <TextBlock Text="{Binding CitationCard.Author}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
              <Border Padding="10"
                      Background="{DynamicResource Brush.Surface.Parchment}"
                      BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.S}">
                <TextBlock Text="{Binding CitationCard.SelectedText}"
                           TextWrapping="Wrap"
                           MaxHeight="120"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              </Border>

              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          HorizontalAlignment="Right">
                <Button Padding="10,6"
                        AutomationProperties.Name="{Binding CopyCitationLabel}"
                        Click="CopyCitationButton_Click">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <svg:Svg Width="16"
                             Height="16"
                             Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_citation_copy.svg" />
                    <TextBlock Text="{Binding CopyCitationLabel}" />
                  </StackPanel>
                </Button>
                <Button Classes="primary" Padding="10,6"
                        CornerRadius="{DynamicResource Radius.S}"
                        AutomationProperties.Name="{Binding ExportCitationLabel}"
                        Click="ExportCitationButton_Click">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <svg:Svg Width="16"
                             Height="16"
                             Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_citation_export.svg" />
                    <TextBlock Text="{Binding ExportCitationLabel}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
        </Border>
      </ScrollViewer>

      <reader:ContinuousPageHost x:Name="ContinuousHost"
                                 Grid.Column="0"
                                 IsVisible="{Binding IsContinuousLayout}"
                                 AutomationProperties.AutomationId="Reader.Continuous"
                                 AutomationProperties.Name="{Binding ReaderTitle}" />

      <!-- Edge click zones: optional page turning without a second navigation row. -->
      <Button Grid.Column="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Width="36"
              Classes="edge-zone"
              IsTabStop="False"
              IsEnabled="{Binding CanGoPrevious}"
              IsVisible="{Binding IsPagedLayout}"
              Cursor="Hand"
              AutomationProperties.AutomationId="Reader.EdgePrev"
              AutomationProperties.Name="{Binding PreviousPageLabel}"
              ToolTip.Tip="{Binding PreviousPageLabel}"
              Click="PreviousButton_Click" />
      <Button Grid.Column="0"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Width="36"
              Margin="0,0,18,0"
              Classes="edge-zone"
              IsTabStop="False"
              IsEnabled="{Binding CanGoNext}"
              IsVisible="{Binding IsPagedLayout}"
              Cursor="Hand"
              AutomationProperties.AutomationId="Reader.EdgeNext"
              AutomationProperties.Name="{Binding NextPageLabel}"
              ToolTip.Tip="{Binding NextPageLabel}"
              Click="NextButton_Click" />

      <Border Grid.Column="1"
              Width="320"
              IsVisible="{Binding IsSidePanelOpen}"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="1,0,0,0"
              Background="{DynamicResource Brush.Surface.Card}">
        <TabControl SelectedIndex="{Binding SelectedSidebarTabIndex, Mode=TwoWay}">
          <TabItem AutomationProperties.Name="{Binding AnnotationPanelLabel}">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <svg:Svg Width="16"
                         Height="16"
                         Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_annotation_panel.svg" />
                <TextBlock Text="{Binding AnnotationPanelLabel}" />
              </StackPanel>
            </TabItem.Header>
            <Grid RowDefinitions="Auto,*,Auto" Margin="12">
              <TextBlock Grid.Row="0"
                         Text="{Binding AnnotationPanelLabel}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <ListBox Grid.Row="1"
                       Margin="0,10,0,0"
                       ItemsSource="{Binding Annotations}"
                       SelectedItem="{Binding SelectedAnnotation, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AnnotationListItem">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,5">
                      <Grid.ContextFlyout>
                        <MenuFlyout>
                          <MenuItem Header="{Binding #Root.DataContext.DeleteAnnotationLabel}"
                                    CommandParameter="{Binding}"
                                    Click="DeleteAnnotationMenuItem_Click" />
                        </MenuFlyout>
                      </Grid.ContextFlyout>
                      <Border Grid.Column="0"
                              Width="14"
                              Height="14"
                              CornerRadius="3"
                              Background="{Binding Color}" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Kind}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                        <TextBlock Text="{Binding Preview}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource Type.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                      </StackPanel>
                      <Button Grid.Column="2"
                              Padding="8,4"
                              IsVisible="{Binding IsNote}"
                              AutomationProperties.Name="{Binding #Root.DataContext.EditNoteLabel}"
                              ToolTip.Tip="{Binding #Root.DataContext.EditNoteLabel}"
                              Click="EditNoteButton_Click">
                        <svg:Svg Width="16"
                                 Height="16"
                                 Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_annotation_note.svg" />
                      </Button>
                      <Button Grid.Column="3"
                              Padding="8,4"
                              AutomationProperties.Name="{Binding #Root.DataContext.DeleteAnnotationLabel}"
                              ToolTip.Tip="{Binding #Root.DataContext.DeleteAnnotationLabel}"
                              Click="DeleteAnnotationButton_Click">
                        <svg:Svg Width="16"
                                 Height="16"
                                 Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_annotation_delete.svg" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Grid.Row="2"
                      Margin="0,10,0,0"
                      Padding="10"
                      BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.S}"
                      IsVisible="{Binding IsNoteEditorOpen}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding NoteEditorLabel}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                  <TextBox x:Name="NoteEditorTextBox"
                           Text="{Binding EditingNoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="True"
                           MinHeight="82"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{Binding NoteEditorLabel}"
                           LostFocus="NoteEditor_LostFocus"
                           KeyDown="NoteEditor_KeyDown" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2"
                      Margin="0,10,0,0"
                      Padding="10"
                      BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.S}"
                      IsVisible="{Binding HasPendingDeleteAnnotation}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding DeleteAnnotationConfirmationText}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Padding="8,4"
                            AutomationProperties.Name="{Binding CancelDeleteAnnotationLabel}"
                            Click="CancelDeleteAnnotationButton_Click">
                      <TextBlock Text="{Binding CancelDeleteAnnotationLabel}" />
                    </Button>
                    <Button Classes="danger" Padding="8,4"
                            CornerRadius="{DynamicResource Radius.S}"
                            AutomationProperties.Name="{Binding ConfirmDeleteAnnotationLabel}"
                            Click="ConfirmDeleteAnnotationButton_Click">
                      <TextBlock Text="{Binding ConfirmDeleteAnnotationLabel}" />
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </TabItem>

          <TabItem AutomationProperties.Name="{Binding BookmarkPanelLabel}">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <svg:Svg Width="16"
                         Height="16"
                         Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_bookmark_panel.svg" />
                <TextBlock Text="{Binding BookmarkPanelLabel}" />
              </StackPanel>
            </TabItem.Header>
            <Grid RowDefinitions="Auto,Auto,*" Margin="12">
              <TextBlock Grid.Row="0"
                         Text="{Binding BookmarkPanelLabel}"
                         AutomationProperties.Name="{Binding BookmarkPanelAccessibleLabel}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <StackPanel Grid.Row="1"
                          Margin="0,10,0,0"
                          Spacing="4">
                <TextBlock Text="{Binding BookmarkSortLabel}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                <ComboBox ItemsSource="{Binding BookmarkSortOptions}"
                          SelectedItem="{Binding SelectedBookmarkSortOption, Mode=TwoWay}"
                          MinHeight="32"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{Binding BookmarkSortLabel}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BookmarkSortOption">
                      <TextBlock Text="{Binding Label}"
                                 TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <ListBox Grid.Row="2"
                        Margin="0,10,0,0"
                        Focusable="True"
                        ItemsSource="{Binding Bookmarks}"
                        AutomationProperties.Name="{Binding BookmarkPanelAccessibleLabel}"
                        KeyDown="Bookmarks_KeyDown">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BookmarkListItem">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,4">
                      <Grid.ContextFlyout>
                        <MenuFlyout>
                          <MenuItem Header="{Binding #Root.DataContext.RenameBookmarkLabel}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding}"
                                    Click="RenameBookmarkMenuItem_Click" />
                          <MenuItem Header="{Binding #Root.DataContext.RemoveBookmarkLabel}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding}"
                                    Click="DeleteBookmarkMenuItem_Click" />
                        </MenuFlyout>
                      </Grid.ContextFlyout>
                      <Button Grid.Column="0"
                              Padding="8,4"
                              AutomationProperties.Name="{Binding AccessibleLabel}"
                              Click="BookmarkNavigateButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <svg:Svg Width="14"
                                   Height="14"
                                   Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_bookmark_item.svg" />
                          <TextBlock Text="{Binding PageNumber}" />
                        </StackPanel>
                      </Button>
                      <svg:Svg Grid.Column="1"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="{Binding #Root.DataContext.RenameBookmarkLabel}"
                               ToolTip.Tip="{Binding #Root.DataContext.RenameBookmarkLabel}"
                               Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_bookmark_rename.svg" />
                      <TextBox Grid.Column="2"
                               Text="{Binding Label, Mode=TwoWay}"
                               MinHeight="30"
                               VerticalContentAlignment="Center"
                               AutomationProperties.Name="{Binding #Root.DataContext.RenameBookmarkLabel}"
                               LostFocus="BookmarkLabel_LostFocus" />
                      <Button Grid.Column="3"
                              Padding="8,4"
                              AutomationProperties.Name="{Binding #Root.DataContext.RemoveBookmarkLabel}"
                              Click="DeleteBookmarkButton_Click">
                        <svg:Svg Width="16"
                                 Height="16"
                                 Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_bookmark_remove.svg" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <TabItem AutomationProperties.Name="{Binding LayerPanelLabel}">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <svg:Svg Width="16"
                         Height="16"
                         Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_layer_panel.svg" />
                <TextBlock Text="{Binding LayerPanelLabel}" />
              </StackPanel>
            </TabItem.Header>
            <Grid RowDefinitions="Auto,Auto,*" Margin="12">
              <Button Grid.Row="0"
                      HorizontalAlignment="Left"
                      Padding="10,6"
                      AutomationProperties.Name="{Binding AddLayerLabel}"
                      Click="AddLayerButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <svg:Svg Width="16"
                           Height="16"
                           Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_layer_add.svg" />
                  <TextBlock Text="{Binding AddLayerLabel}" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Row="1"
                          Margin="0,10,0,0"
                          Spacing="4">
                <TextBlock Text="{Binding LayerFilterLabel}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                <ComboBox ItemsSource="{Binding LayerFilterOptions}"
                          SelectedItem="{Binding SelectedLayerFilter, Mode=OneWay}"
                          MinHeight="32"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="LayerFilter_SelectionChanged"
                          AutomationProperties.Name="{Binding LayerFilterLabel}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LayerFilterOption">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Border Grid.Column="0"
                                Width="12"
                                Height="12"
                                CornerRadius="6"
                                Background="{Binding Color}"
                                IsVisible="{Binding !IsAllVisible}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <ItemsControl Grid.Row="2"
                            Margin="0,10,0,0"
                            ItemsSource="{Binding Layers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LayerListItem">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,5">
                      <Border Grid.Column="0"
                              Width="14"
                              Height="14"
                              CornerRadius="7"
                              Background="{Binding Color}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Name, Mode=TwoWay}"
                               MinHeight="30"
                               VerticalContentAlignment="Center"
                               AutomationProperties.Name="{Binding Name}"
                               LostFocus="LayerName_LostFocus" />
                      <Border Grid.Column="2"
                              Padding="6,2"
                              CornerRadius="{DynamicResource Radius.S}"
                              Background="{DynamicResource Brush.Accent.Ink}"
                              IsVisible="{Binding IsActiveWritableLayer}"
                              AutomationProperties.Name="{Binding ActiveAutomationLabel}">
                        <TextBlock Text="{Binding ActiveLabel}"
                                   FontSize="{DynamicResource Type.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Accent.OnAccent}" />
                      </Border>
                      <CheckBox Grid.Column="3"
                                IsChecked="{Binding IsVisible, Mode=OneWay}"
                                AutomationProperties.Name="{Binding VisibilityAutomationLabel}"
                                Click="LayerVisibility_Click">
                        <svg:Svg Width="16"
                                 Height="16"
                                 Path="{Binding VisibilityIconPath}" />
                      </CheckBox>
                      <Button Grid.Column="4"
                              Padding="8,4"
                              IsEnabled="{Binding CanMergeOrDelete}"
                              AutomationProperties.Name="{Binding MergeAutomationLabel}"
                              ToolTip.Tip="{Binding MergeAutomationLabel}"
                              Click="MergeLayerButton_Click">
                        <svg:Svg Width="16"
                                 Height="16"
                                 Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_layer_merge.svg" />
                      </Button>
                      <Button Grid.Column="5"
                              Padding="8,4"
                              IsEnabled="{Binding CanMergeOrDelete}"
                              AutomationProperties.Name="{Binding DeleteAutomationLabel}"
                              Click="DeleteLayerButton_Click">
                        <svg:Svg Width="16"
                                 Height="16"
                                 Path="avares://OgmaLibrary.App/Assets/icons/reader/annotations/ic_layer_delete.svg" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </TabItem>

          <TabItem AutomationProperties.Name="{Binding ReadingMemoryLabel}">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <svg:Svg Width="16"
                         Height="16"
                         Path="avares://OgmaLibrary.App/Assets/icons/reader/memory/ic_reading_memory.svg" />
                <TextBlock Text="{Binding ReadingMemoryLabel}" />
              </StackPanel>
            </TabItem.Header>
            <ScrollViewer Margin="12">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding OpenedBecauseLabel}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBox Text="{Binding OpenedBecause, Mode=TwoWay}"
                         AcceptsReturn="True"
                         MinHeight="58"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding OpenedBecauseLabel}"
                         LostFocus="ReadingMemoryField_LostFocus" />

                <TextBlock Text="{Binding KeyInsightLabel}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBox Text="{Binding KeyInsight, Mode=TwoWay}"
                         AcceptsReturn="True"
                         MinHeight="58"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding KeyInsightLabel}"
                         LostFocus="ReadingMemoryField_LostFocus" />

                <TextBlock Text="{Binding OpenQuestionsLabel}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBox Text="{Binding OpenQuestions, Mode=TwoWay}"
                         AcceptsReturn="True"
                         MinHeight="58"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding OpenQuestionsLabel}"
                         LostFocus="ReadingMemoryField_LostFocus" />

                <StackPanel Orientation="Horizontal" Spacing="6">
                  <svg:Svg Width="16"
                           Height="16"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding DispositionLabel}"
                           ToolTip.Tip="{Binding DispositionLabel}"
                           Path="avares://OgmaLibrary.App/Assets/icons/reader/memory/ic_reading_memory_disposition.svg" />
                  <TextBlock Text="{Binding DispositionLabel}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                </StackPanel>
                <TextBox Text="{Binding DispositionText, Mode=TwoWay}"
                         MaxLength="1"
                         Width="56"
                         HorizontalAlignment="Left"
                         AutomationProperties.Name="{Binding DispositionLabel}"
                         LostFocus="ReadingMemoryField_LostFocus" />

                <Button Classes="primary" Padding="12,8"
                        HorizontalAlignment="Left"
                        CornerRadius="{DynamicResource Radius.S}"
                        AutomationProperties.Name="{Binding SaveReadingMemoryLabel}"
                        Click="SaveMemoryButton_Click">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <svg:Svg Width="16"
                             Height="16"
                             Path="avares://OgmaLibrary.App/Assets/icons/reader/memory/ic_reading_memory.svg" />
                    <TextBlock Text="{Binding SaveReadingMemoryLabel}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem AutomationProperties.Name="{Binding ContentsTabLabel}"
                   AutomationProperties.AutomationId="Reader.Contents.Tab">
            <TabItem.Header>
              <TextBlock Text="{Binding ContentsTabLabel}" />
            </TabItem.Header>
            <Grid Margin="12">
              <ListBox x:Name="ContentsList"
                       ItemsSource="{Binding ContentsEntries}"
                       AutomationProperties.AutomationId="Reader.Contents.List"
                       AutomationProperties.Name="{Binding ContentsTabLabel}"
                       SelectionChanged="ContentsList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContentsEntryItem">
                    <Grid ColumnDefinitions="*,Auto"
                          Margin="{Binding Indent}"
                          AutomationProperties.Name="{Binding AccessibleLabel}">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Title}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1"
                                 Margin="8,0,0,0"
                                 Text="{Binding PageText}"
                                 FontFeatures="tnum"
                                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel IsVisible="{Binding ShowContentsEmptyState}"
                          VerticalAlignment="Top"
                          Spacing="6"
                          AutomationProperties.AutomationId="Reader.Contents.Empty">
                <TextBlock Text="{Binding ContentsEmptyText}"
                           Classes="ogma-display"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBlock Text="{Binding ContentsEmptyHint}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
              </StackPanel>
            </Grid>
          </TabItem>

          <TabItem AutomationProperties.Name="{Binding FindResultsTabLabel}"
                   AutomationProperties.AutomationId="Reader.Find.Tab">
            <TabItem.Header>
              <TextBlock Text="{Binding FindResultsTabLabel}" />
            </TabItem.Header>
            <Grid RowDefinitions="Auto,*" Margin="12">
              <TextBlock Grid.Row="0"
                         Text="{Binding FindCountText}"
                         Margin="0,0,0,8"
                         FontFeatures="tnum"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
              <ListBox Grid.Row="1"
                       x:Name="FindResultsList"
                       ItemsSource="{Binding FindResults}"
                       AutomationProperties.AutomationId="Reader.Find.Results"
                       AutomationProperties.Name="{Binding FindResultsTabLabel}"
                       SelectionChanged="FindResultsList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FindResultItem">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding PageLabel}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MatchCount}"
                                   FontFeatures="tnum"
                                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                      </Grid>
                      <TextBlock Text="{Binding Snippet}"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </Grid>
</UserControl>
