<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cat="using:OgmaLibrary.App.Views.Catalogue"
             x:Class="OgmaLibrary.App.Views.Catalogue.CoverImageView"
             x:CompileBindings="False">
  <Grid ClipToBounds="True">
    <!-- Sept-23 Phase 09: a generated cloth-bound cover replaces the flat brown block. -->
    <cat:GeneratedCover Title="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Author="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsVisible="{Binding IsPlaceholder, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <Image Source="{Binding Image, RelativeSource={RelativeSource AncestorType=UserControl}}"
           IsVisible="{Binding IsImageVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
           Stretch="UniformToFill" />
  </Grid>
</UserControl>
