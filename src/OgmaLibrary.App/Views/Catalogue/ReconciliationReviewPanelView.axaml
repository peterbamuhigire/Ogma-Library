<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Catalogue"
             x:Class="OgmaLibrary.App.Views.Catalogue.ReconciliationReviewPanelView"
             x:DataType="vm:ReconciliationReviewPanelViewModel">
  <Border Padding="14"
          Background="{DynamicResource Brush.Surface.Parchment}"
          BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Radius.S}">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto"
          RowSpacing="8">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding Title}"
                   FontSize="{DynamicResource Type.Size.Subtitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button Padding="8,4"
                  AutomationProperties.Name="{Binding ReloadLabel}"
                  Click="Reload_Click">
            <TextBlock Text="{Binding ReloadLabel}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
          <Button Padding="8,4"
                  AutomationProperties.Name="{Binding CloseLabel}"
                  Click="Close_Click">
            <TextBlock Text="{Binding CloseLabel}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
        </StackPanel>
      </Grid>

      <TextBlock Grid.Row="1"
                 Text="{Binding Description}"
                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                 TextWrapping="Wrap" />

      <ListBox Grid.Row="2"
               ItemsSource="{Binding Reviews}"
               SelectedItem="{Binding SelectedReview, Mode=TwoWay}"
               AutomationProperties.Name="{Binding Title}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ReconciliationReviewItemViewModel">
            <StackPanel Spacing="2" Margin="4,3">
              <TextBlock Text="{Binding FileOccurrenceId}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <TextBlock Text="{Binding ReasonCode}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="3"
                  Spacing="4">
        <TextBlock Text="{Binding CandidateLabel}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
        <ComboBox ItemsSource="{Binding SelectedReview.CandidatePaths}"
                  SelectedItem="{Binding SelectedReview.SelectedPath, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding CandidateLabel}" />
      </StackPanel>

      <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
        <Button Padding="10,5"
                Background="{DynamicResource Brush.Accent.Sage}"
                Foreground="White"
                IsEnabled="{Binding CanAccept}"
                AutomationProperties.Name="{Binding AcceptLabel}"
                Click="Accept_Click">
          <TextBlock Text="{Binding AcceptLabel}" />
        </Button>
        <Button Padding="10,5"
                Background="{DynamicResource Brush.Accent.Clay}"
                Foreground="White"
                IsEnabled="{Binding CanReject}"
                AutomationProperties.Name="{Binding RejectLabel}"
                Click="Reject_Click">
          <TextBlock Text="{Binding RejectLabel}" />
        </Button>
        <TextBlock Text="{Binding EmptyText}"
                   IsVisible="{Binding HasNoReviews}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
      </StackPanel>

      <TextBlock Grid.Row="5"
                 Text="{Binding StatusText}"
                 IsVisible="{Binding HasStatus}"
                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                 TextWrapping="Wrap" />
    </Grid>
  </Border>
</UserControl>
