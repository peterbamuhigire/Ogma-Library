<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Catalogue"
             xmlns:cat="using:OgmaLibrary.App.Views.Catalogue"
             xmlns:classroom="using:OgmaLibrary.App.Views.Classroom"
             xmlns:reader="using:OgmaLibrary.App.Views.Reader"
             xmlns:search="using:OgmaLibrary.App.Views.Search"
             xmlns:settings="using:OgmaLibrary.App.Views.Settings"
             xmlns:shell="using:OgmaLibrary.App.Views.Shell"
             xmlns:ai="using:OgmaLibrary.App.Views.Ai"
             xmlns:shelf3d="using:OgmaLibrary.App.Views.Shelf3D"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="OgmaLibrary.App.Views.Catalogue.CatalogueShellView"
             x:DataType="vm:MainShellViewModel"
             Focusable="True"
             KeyDown="CatalogueShellView_KeyDown">

  <!--
    Sept-23 Phase 07 (K11, K12, K17): the routed shell. Navigation rail | destination host
    (contextual toolbar, active-filter chips, content, one drawer, pager) | inspector, with the
    status bar below. One route is current at a time (NavigationState); drawers belong to the
    Library and close on navigation; the toolbar overflows by priority into "More".
    Typography: Spectral for destination headings (ogma-display), Public Sans for everything
    else (theme default). Colours and sizes are design tokens only.
  -->

  <UserControl.Styles>
    <Style Selector="Border.rail">
      <Setter Property="Width" Value="208" />
    </Style>
    <Style Selector="Border.rail.compact">
      <Setter Property="Width" Value="64" />
    </Style>
    <Style Selector="Border.rail.compact TextBlock.rail-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.rail-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Surface.OnParchment}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.rail-item.selected">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Oak}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.rail-item:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Surface.OnParchment}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.tool.primary">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Oak}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.OnAccent}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.tool.active">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Oak}" />
    </Style>
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Surface.OnParchment}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.segment.selected">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Oak}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.destination-heading">
      <Setter Property="FontFamily" Value="{DynamicResource Type.FontFamily.Display}" />
      <Setter Property="FontSize" Value="{DynamicResource Type.Size.Title}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Surface.OnParchment}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="ShellGrid"
        ColumnDefinitions="Auto,*,Auto"
        RowDefinitions="*,Auto">

    <!-- ─── Navigation rail (focus order 1) ─────────────────────────── -->
    <Border Grid.Row="0"
            Grid.Column="0"
            Classes="rail"
            Classes.compact="{Binding IsRailCompact}"
            Background="{DynamicResource Brush.Surface.Footer}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="RailList"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding RailItems}"
                        AutomationProperties.AutomationId="Shell.Rail"
                        AutomationProperties.Name="{Binding RailName}"
                        KeyDown="Rail_KeyDown">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RailItemViewModel">
                <Button Classes="rail-item"
                        Classes.selected="{Binding IsSelected}"
                        IsVisible="{Binding IsVisible}"
                        AutomationProperties.AutomationId="{Binding AutomationId}"
                        AutomationProperties.Name="{Binding Label}"
                        AutomationProperties.ItemStatus="{Binding Status}"
                        ToolTip.Tip="{Binding ToolTip}"
                        Click="RailItem_Click">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <svg:Svg Width="20" Height="20" Path="{Binding IconPath}" />
                    <TextBlock Classes="rail-label"
                               Text="{Binding Label}"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource Type.Size.Body}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="1"
                Classes="rail-item"
                Margin="6,4,6,8"
                AutomationProperties.AutomationId="Shell.Nav.ToggleRail"
                AutomationProperties.Name="{Binding RailToggleLabel}"
                ToolTip.Tip="{Binding RailToggleLabel}"
                Click="ToggleRail_Click">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding RailToggleGlyph}"
                       Width="20"
                       TextAlignment="Center"
                       FontSize="{DynamicResource Type.Size.Subtitle}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
            <TextBlock Classes="rail-label"
                       Text="{Binding RailToggleLabel}"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource Type.Size.Small}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- ─── Destination host (focus order 2: toolbar, then content) ───── -->
    <Grid Grid.Row="0"
          Grid.Column="1"
          RowDefinitions="Auto,Auto,*,Auto">

      <!-- Contextual toolbar -->
      <Border Grid.Row="0"
              Padding="16,8,12,8"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0"
                     Classes="destination-heading"
                     Margin="0,0,16,0"
                     Text="{Binding DestinationHeading}"
                     AutomationProperties.AutomationId="Shell.Heading"
                     AutomationProperties.HeadingLevel="1" />

          <!-- Library toolbar: at most 7 visible controls; the rest overflow into More. -->
          <Grid Grid.Column="1"
                ColumnDefinitions="*,Auto"
                IsVisible="{Binding IsLibraryDestination}">
            <shell:PriorityToolbarPanel x:Name="LibraryToolbar"
                                        Grid.Column="0"
                                        Spacing="6"
                                        VerticalAlignment="Center">
              <Button x:Name="AddFolderButton"
                      shell:PriorityToolbarPanel.Priority="0"
                      Classes="tool primary"
                      AutomationProperties.AutomationId="Shell.Action.ChooseFolder"
                      AutomationProperties.Name="{Binding AddFolderLabel}"
                      Click="ChooseFolderButton_Click">
                <TextBlock Text="{Binding AddFolderLabel}" />
              </Button>
              <Button x:Name="FilterButton"
                      shell:PriorityToolbarPanel.Priority="1"
                      Classes="tool"
                      Classes.active="{Binding IsFilterPanelOpen}"
                      AutomationProperties.AutomationId="Shell.Action.Filter"
                      AutomationProperties.Name="{Binding FilterLabel}"
                      Click="FilterToggle_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <svg:Svg Width="16" Height="16" Path="{Binding FilterIconPath}" />
                  <TextBlock Text="{Binding FilterLabel}" />
                </StackPanel>
              </Button>
              <StackPanel x:Name="ViewSwitcher"
                          shell:PriorityToolbarPanel.Priority="2"
                          Orientation="Horizontal"
                          AutomationProperties.Name="{Binding ViewSwitcherLabel}">
                <Border BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.S}"
                        ClipToBounds="True">
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="segment"
                            Classes.selected="{Binding IsGridViewSelected}"
                            AutomationProperties.AutomationId="Catalogue.View.Grid"
                            AutomationProperties.Name="{Binding GridViewLabel}"
                            Click="GridViewButton_Click">
                      <TextBlock Text="{Binding GridViewLabel}" />
                    </Button>
                    <Button Classes="segment"
                            Classes.selected="{Binding IsListViewSelected}"
                            AutomationProperties.AutomationId="Catalogue.View.List"
                            AutomationProperties.Name="{Binding ListViewLabel}"
                            Click="ListViewButton_Click">
                      <TextBlock Text="{Binding ListViewLabel}" />
                    </Button>
                    <Button Classes="segment"
                            Classes.selected="{Binding IsDirectoryViewSelected}"
                            AutomationProperties.AutomationId="Catalogue.View.Directory"
                            AutomationProperties.Name="{Binding DirectoryViewLabel}"
                            Click="DirectoryViewButton_Click">
                      <TextBlock Text="{Binding DirectoryViewLabel}" />
                    </Button>
                    <Button Classes="segment"
                            Classes.selected="{Binding IsBookshelf3DActive}"
                            IsVisible="{Binding IsShelf3DAvailable}"
                            AutomationProperties.AutomationId="Catalogue.View.Shelf3D"
                            AutomationProperties.Name="{Binding Shelf3DViewLabel}"
                            Click="Bookshelf3DButton_Click">
                      <TextBlock Text="{Binding Shelf3DViewLabel}" />
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>
              <Button x:Name="RescanButton"
                      shell:PriorityToolbarPanel.Priority="3"
                      Classes="tool"
                      IsVisible="{Binding IsLibraryFoldersVisible}"
                      AutomationProperties.AutomationId="Shell.Action.Rescan"
                      AutomationProperties.Name="{Binding RescanLibraryText}"
                      Click="Rescan_Click">
                <TextBlock Text="{Binding RescanLibraryText}" />
              </Button>
              <StackPanel x:Name="SortGroup"
                          shell:PriorityToolbarPanel.Priority="4"
                          Orientation="Horizontal"
                          Spacing="4">
                <ComboBox MinWidth="120"
                          ItemsSource="{Binding Catalogue.Filter.SortOptions}"
                          SelectedItem="{Binding Catalogue.Filter.SortField, Mode=TwoWay}"
                          AutomationProperties.AutomationId="Catalogue.Filter.Sort"
                          AutomationProperties.Name="{Binding SortLabel}" />
                <Button Classes="tool"
                        AutomationProperties.AutomationId="Catalogue.Filter.SortDirection"
                        AutomationProperties.Name="{Binding Catalogue.Filter.SortDirectionText}"
                        Click="ToggleSortDirection_Click">
                  <TextBlock Text="{Binding Catalogue.Filter.SortDirectionText}" />
                </Button>
              </StackPanel>
              <Button x:Name="FoldersButton"
                      shell:PriorityToolbarPanel.Priority="5"
                      Classes="tool"
                      Classes.active="{Binding IsFoldersDrawerOpen}"
                      IsVisible="{Binding IsLibraryFoldersVisible}"
                      AutomationProperties.AutomationId="Shell.Action.Folders"
                      AutomationProperties.Name="{Binding FoldersLabel}"
                      Click="FoldersToggle_Click">
                <TextBlock Text="{Binding FoldersLabel}" />
              </Button>
              <TextBlock x:Name="CountText"
                         shell:PriorityToolbarPanel.Priority="6"
                         VerticalAlignment="Center"
                         Margin="6,0"
                         Text="{Binding CatalogueCountText}"
                         FontSize="{DynamicResource Type.Size.Small}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
            </shell:PriorityToolbarPanel>

            <DropDownButton x:Name="LibraryMoreButton"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="Shell.Action.More"
                            AutomationProperties.Name="{Binding MoreActionsLabel}">
              <TextBlock Text="{Binding MoreActionsLabel}" />
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight"
                            Opening="LibraryMoreFlyout_Opening" />
              </DropDownButton.Flyout>
            </DropDownButton>
          </Grid>

          <!-- Reading toolbar -->
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="6"
                      IsVisible="{Binding IsReadingDestination}">
            <Button Classes="tool primary"
                    IsVisible="{Binding IsReaderContentVisible}"
                    AutomationProperties.AutomationId="Reader.BackToLibrary"
                    AutomationProperties.Name="{Binding BackToLibraryLabel}"
                    Click="BackToLibrary_Click">
              <TextBlock Text="{Binding BackToLibraryLabel}" />
            </Button>
            <Button Classes="tool"
                    Classes.active="{Binding IsSplitViewActive}"
                    AutomationProperties.AutomationId="Reader.SplitView"
                    AutomationProperties.Name="{Binding SplitViewLabel}"
                    Click="SplitViewButton_Click">
              <TextBlock Text="{Binding SplitViewLabel}" />
            </Button>
          </StackPanel>

          <!-- Advisor toolbar: Ask | Reading plan -->
          <Border Grid.Column="1"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding IsAdvisorDestination}"
                  BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.S}"
                  ClipToBounds="True">
            <StackPanel Orientation="Horizontal">
              <Button Classes="segment"
                      Classes.selected="{Binding IsAdvisorActive}"
                      AutomationProperties.AutomationId="Advisor.Tab.Ask"
                      AutomationProperties.Name="{Binding AdvisorAskLabel}"
                      Click="AdvisorButton_Click">
                <TextBlock Text="{Binding AdvisorAskLabel}" />
              </Button>
              <Button Classes="segment"
                      Classes.selected="{Binding IsReadingPlanActive}"
                      AutomationProperties.AutomationId="Advisor.Tab.ReadingPlan"
                      AutomationProperties.Name="{Binding ReadingPlanLabel}"
                      Click="ReadingPlanButton_Click">
                <TextBlock Text="{Binding ReadingPlanLabel}" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Collections toolbar -->
          <Button Grid.Column="1"
                  HorizontalAlignment="Left"
                  Classes="tool primary"
                  IsVisible="{Binding IsCollectionsActive}"
                  IsEnabled="{Binding CanShowSelectedCollection}"
                  AutomationProperties.AutomationId="Collections.ShowInLibrary"
                  AutomationProperties.Name="{Binding ShowCollectionLabel}"
                  Click="ShowCollection_Click">
            <TextBlock Text="{Binding ShowCollectionLabel}" />
          </Button>

          <!-- Classroom toolbar: tabs only when both surfaces exist -->
          <Border Grid.Column="1"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding IsClassroomTabsVisible}"
                  BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.S}"
                  ClipToBounds="True">
            <StackPanel Orientation="Horizontal">
              <Button Classes="segment"
                      Classes.selected="{Binding IsSharingSettingsActive}"
                      AutomationProperties.AutomationId="Classroom.Tab.Sharing"
                      AutomationProperties.Name="{Binding SharingSettingsLabel}"
                      Click="SharingSettingsButton_Click">
                <TextBlock Text="{Binding SharingSettingsLabel}" />
              </Button>
              <Button Classes="segment"
                      Classes.selected="{Binding IsStudentSmartSearchActive}"
                      AutomationProperties.AutomationId="Classroom.Tab.SmartSearch"
                      AutomationProperties.Name="{Binding StudentSmartSearchLabel}"
                      Click="StudentSmartSearchButton_Click">
                <TextBlock Text="{Binding StudentSmartSearchLabel}" />
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Active-filter chips (K12): a filter can never apply out of sight. -->
      <Border Grid.Row="1"
              Padding="16,6"
              IsVisible="{Binding HasActiveFilterChips}"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="0,0,0,1">
        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
          <ItemsControl ItemsSource="{Binding ActiveFilterChips}"
                        AutomationProperties.AutomationId="Catalogue.FilterChips"
                        AutomationProperties.Name="{Binding FilterChipsLabel}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterChip">
                <Border Padding="10,2,2,2"
                        CornerRadius="{DynamicResource Radius.M}"
                        Background="{DynamicResource Brush.Surface.Footer}"
                        BorderBrush="{DynamicResource Brush.Accent.Oak}"
                        BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Label}"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource Type.Size.Small}"
                               Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                    <Button Background="Transparent"
                            BorderThickness="0"
                            MinHeight="28"
                            MinWidth="28"
                            Padding="6,0"
                            AutomationProperties.AutomationId="Catalogue.FilterChip.Remove"
                            AutomationProperties.Name="{Binding RemoveName}"
                            Click="RemoveFilterChip_Click">
                      <TextBlock Text="×"
                                 FontSize="{DynamicResource Type.Size.Body}"
                                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="tool"
                  MinHeight="30"
                  Padding="8,2"
                  AutomationProperties.AutomationId="Catalogue.Filter.Clear"
                  AutomationProperties.Name="{Binding ClearFiltersText}"
                  Click="ClearFilters_Click">
            <TextBlock Text="{Binding ClearFiltersText}" FontSize="{DynamicResource Type.Size.Small}" />
          </Button>
        </WrapPanel>
      </Border>

      <!-- Content (one destination at a time) and the Library drawer -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
        <Panel Grid.Column="0">

          <!-- Library: catalogue -->
          <Grid IsVisible="{Binding IsCatalogueActive}">
            <Panel IsVisible="{Binding Catalogue.IsGridView}">
              <cat:CatalogueGridView DataContext="{Binding Catalogue}" />
            </Panel>
            <Panel IsVisible="{Binding Catalogue.IsListView}">
              <cat:CatalogueListView DataContext="{Binding Catalogue}" />
            </Panel>
            <Panel IsVisible="{Binding Catalogue.IsDirectoryView}">
              <cat:CatalogueDirectoryView DataContext="{Binding Catalogue}" />
            </Panel>

            <!-- Filtered-empty state (Sept-23 K12/K13): filters hide every book. -->
            <StackPanel IsVisible="{Binding Catalogue.IsFilteredEmpty}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8">
              <TextBlock Text="{Binding FilteredEmptyHeading}"
                         AutomationProperties.AutomationId="Catalogue.FilteredEmpty.Heading"
                         FontSize="{DynamicResource Type.Size.Title}"
                         FontWeight="SemiBold"
                         TextAlignment="Center"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <Button HorizontalAlignment="Center"
                      Classes="tool primary"
                      AutomationProperties.AutomationId="Catalogue.FilteredEmpty.Clear"
                      AutomationProperties.Name="{Binding ClearFiltersText}"
                      Click="ClearFilters_Click">
                <TextBlock Text="{Binding ClearFiltersText}" />
              </Button>
            </StackPanel>

            <!-- Empty state -->
            <Border IsVisible="{Binding Catalogue.IsEmpty}"
                    AutomationProperties.AutomationId="Catalogue.EmptyState"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="16">
              <StackPanel Spacing="8" MaxWidth="400">
                <TextBlock Text="{Binding EmptyStateHeading}"
                           AutomationProperties.AutomationId="Catalogue.EmptyState.Heading"
                           Classes="ogma-display"
                           FontSize="{DynamicResource Type.Size.Title}"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBlock Text="{Binding EmptyStateBody}"
                           FontSize="{DynamicResource Type.Size.Body}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                <WrapPanel Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           ItemSpacing="8"
                           LineSpacing="8"
                           Margin="0,8,0,0">
                  <Button Padding="16,8"
                          Classes="tool primary"
                          AutomationProperties.AutomationId="Catalogue.EmptyState.ChooseFolder"
                          AutomationProperties.Name="{Binding ChooseFolderText}"
                          Click="ChooseFolderButton_Click">
                    <TextBlock Text="{Binding ChooseFolderText}" />
                  </Button>
                  <Button Padding="16,8"
                          Classes="tool"
                          AutomationProperties.AutomationId="Catalogue.EmptyState.OpenPdf"
                          AutomationProperties.Name="{Binding OpenPdfText}"
                          Click="OpenPdfButton_Click">
                    <TextBlock Text="{Binding OpenPdfText}" />
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Library: 3D shelf (capability-gated) -->
          <Panel IsVisible="{Binding IsBookshelf3DActive}">
            <shelf3d:Bookshelf3DView DataContext="{Binding Bookshelf3D}" />
          </Panel>

          <!-- Search -->
          <Panel IsVisible="{Binding IsSearchActive}">
            <search:SearchPanelView x:Name="SearchPanel" DataContext="{Binding Search}" />
          </Panel>

          <!-- Reading -->
          <Panel IsVisible="{Binding IsReaderContentVisible}">
            <reader:ReaderView DataContext="{Binding Reader}" />
          </Panel>
          <StackPanel IsVisible="{Binding IsReadingEmptyVisible}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      MaxWidth="440"
                      Margin="16"
                      Spacing="8">
            <TextBlock Text="{Binding ReadingEmptyHeading}"
                       AutomationProperties.AutomationId="Reading.Empty.Heading"
                       Classes="ogma-display"
                       FontSize="{DynamicResource Type.Size.Title}"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}" />
            <TextBlock Text="{Binding ReadingEmptyBody}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
            <WrapPanel HorizontalAlignment="Center" ItemSpacing="8" LineSpacing="8" Margin="0,8,0,0">
              <Button Classes="tool primary"
                      IsVisible="{Binding CanResumeLastBook}"
                      AutomationProperties.AutomationId="Reading.Empty.Resume"
                      AutomationProperties.Name="{Binding ReadingResumeLabel}"
                      Click="ResumeLastBook_Click">
                <TextBlock Text="{Binding ReadingResumeLabel}" />
              </Button>
              <Button Classes="tool"
                      AutomationProperties.AutomationId="Reading.Empty.GoToLibrary"
                      AutomationProperties.Name="{Binding GoToLibraryLabel}"
                      Click="LibraryButton_Click">
                <TextBlock Text="{Binding GoToLibraryLabel}" />
              </Button>
            </WrapPanel>
          </StackPanel>
          <Panel IsVisible="{Binding IsSplitViewActive}">
            <reader:SplitViewView DataContext="{Binding SplitView}" />
          </Panel>

          <!-- Advisor (ask and reading plan), with the honest "set up AI" state (G7, K17) -->
          <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsAdvisorDestination}">
            <Border Grid.Row="0"
                    IsVisible="{Binding IsAdvisorSetupNeeded}"
                    Margin="16,12,16,0"
                    Padding="16,12"
                    CornerRadius="{DynamicResource Radius.M}"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Accent.Ink}"
                    BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="{Binding AdvisorSetupHeading}"
                           AutomationProperties.AutomationId="Advisor.Setup.Heading"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,4,12,0"
                           Text="{Binding AdvisorSetupBody}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource Type.Size.Small}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                <Button Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Classes="tool primary"
                        AutomationProperties.AutomationId="Advisor.SettingsRoute"
                        AutomationProperties.Name="{Binding AdvisorSetupAction}"
                        Click="AdvisorSettingsRoute_Click">
                  <TextBlock Text="{Binding AdvisorSetupAction}" />
                </Button>
              </Grid>
            </Border>
            <Panel Grid.Row="1" IsVisible="{Binding IsAdvisorActive}">
              <ai:RecommendationPanelView DataContext="{Binding Advisor}" />
            </Panel>
            <Panel Grid.Row="1" IsVisible="{Binding IsReadingPlanActive}">
              <ai:ReadingPlanView DataContext="{Binding ReadingPlan}" />
            </Panel>
          </Grid>

          <!-- Collections -->
          <shell:CollectionsView IsVisible="{Binding IsCollectionsActive}" />

          <!-- Activity: index and background jobs -->
          <Panel IsVisible="{Binding IsActivityActive}">
            <search:IndexManagerPanelView DataContext="{Binding IndexManager}" />
          </Panel>

          <!-- Classroom (only when the capability is on) -->
          <Panel IsVisible="{Binding IsSharingSettingsActive}">
            <settings:SharingSettingsView DataContext="{Binding HostSharing}" />
          </Panel>
          <Panel IsVisible="{Binding IsStudentSmartSearchActive}">
            <classroom:StudentSmartSearchView DataContext="{Binding StudentSmartSearch}" />
          </Panel>

          <!-- Settings overview (content arrives in Phase 08) -->
          <shell:SettingsOverviewView IsVisible="{Binding IsSettingsActive}" />
        </Panel>

        <!-- Library drawer: exactly one of Filter, Folders, Relocation reviews -->
        <Border Grid.Column="1"
                Width="340"
                IsVisible="{Binding IsDrawerOpen}"
                Background="{DynamicResource Brush.Surface.Footer}"
                BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                BorderThickness="1,0,0,0"
                AutomationProperties.AutomationId="Shell.Drawer">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="14,10,8,4"
                  IsVisible="{Binding IsDrawerHeaderVisible}">
              <TextBlock Grid.Column="0"
                         Text="{Binding DrawerTitle}"
                         AutomationProperties.AutomationId="Shell.Drawer.Title"
                         FontSize="{DynamicResource Type.Size.Subtitle}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <Button Grid.Column="1"
                      Classes="tool"
                      AutomationProperties.AutomationId="Shell.Drawer.Close"
                      AutomationProperties.Name="{Binding CloseDrawerLabel}"
                      ToolTip.Tip="{Binding CloseDrawerLabel}"
                      Click="CloseDrawer_Click">
                <TextBlock Text="×" />
              </Button>
            </Grid>

            <!-- Filter drawer -->
            <StackPanel Grid.Row="1"
                        Margin="14,4,14,14"
                        Spacing="10"
                        IsVisible="{Binding IsFilterPanelOpen}">
              <TextBox Text="{Binding Catalogue.Filter.TitleSearch, Mode=TwoWay}"
                       Watermark="{Binding FilterTitleWatermark}"
                       AutomationProperties.AutomationId="Catalogue.Filter.Title"
                       AutomationProperties.Name="{Binding FilterTitleWatermark}" />
              <TextBox Text="{Binding Catalogue.Filter.AuthorSearch, Mode=TwoWay}"
                       Watermark="{Binding FilterAuthorWatermark}"
                       AutomationProperties.AutomationId="Catalogue.Filter.Author"
                       AutomationProperties.Name="{Binding FilterAuthorWatermark}" />
              <Button Classes="tool"
                      AutomationProperties.AutomationId="Catalogue.Filter.ClearDrawer"
                      AutomationProperties.Name="{Binding ClearFiltersText}"
                      Click="ClearFilters_Click">
                <TextBlock Text="{Binding ClearFiltersText}" />
              </Button>
            </StackPanel>

            <!-- Library folders drawer (Phase 08 moves this into Settings) -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsFoldersDrawerOpen}">
              <cat:LibraryFoldersPanelView DataContext="{Binding LibraryFolders}" />
            </ScrollViewer>

            <!-- Relocation reviews drawer -->
            <Panel Grid.Row="0"
                   Grid.RowSpan="2"
                   IsVisible="{Binding IsReconciliationReviewPanelOpen}">
              <cat:ReconciliationReviewPanelView Margin="8"
                                                 DataContext="{Binding ReconciliationReviews}"
                                                 CloseRequested="ReconciliationReviewPanel_CloseRequested" />
            </Panel>
          </Grid>
        </Border>
      </Grid>

      <!-- Bounded catalogue paging keeps large result sets responsive. -->
      <Border Grid.Row="3"
              IsVisible="{Binding IsPagerVisible}"
              Background="{DynamicResource Brush.Surface.Footer}"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="0,1,0,0"
              Padding="12,6">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <Button Grid.Column="0"
                  Classes="tool"
                  IsEnabled="{Binding Catalogue.CanGoToPreviousPage}"
                  AutomationProperties.AutomationId="Catalogue.Pager.Previous"
                  AutomationProperties.Name="{Binding Catalogue.PreviousPageText}"
                  Click="PreviousPage_Click">
            <TextBlock Text="{Binding Catalogue.PreviousPageText}"
                       FontSize="{DynamicResource Type.Size.Small}" />
          </Button>
          <TextBlock Grid.Column="1"
                     Text="{Binding Catalogue.PageSummaryText}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="{DynamicResource Type.Size.Small}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
          <Button Grid.Column="2"
                  Classes="tool"
                  IsEnabled="{Binding Catalogue.CanGoToNextPage}"
                  AutomationProperties.AutomationId="Catalogue.Pager.Next"
                  AutomationProperties.Name="{Binding Catalogue.NextPageText}"
                  Click="NextPage_Click">
            <TextBlock Text="{Binding Catalogue.NextPageText}"
                       FontSize="{DynamicResource Type.Size.Small}" />
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- ─── Inspector (focus order 3); overlays the content below 1280 px ─ -->
    <cat:BookDetailView x:Name="Inspector"
                        Grid.Row="0"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="Detail.Panel"
                        DataContext="{Binding BookDetail}"
                        IsVisible="{Binding IsVisible}"
                        x:CompileBindings="False" />

    <!-- ─── Status bar ─────────────────────────────────────────────────── -->
    <Border Grid.Row="1"
            Grid.ColumnSpan="3"
            Background="{DynamicResource Brush.Surface.Footer}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   AutomationProperties.AutomationId="Shell.Status"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{Binding StatusText}"
                   TextTrimming="CharacterEllipsis"
                   FontSize="{DynamicResource Type.Size.Small}"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                   VerticalAlignment="Center" />

        <Border Grid.Column="1"
                IsVisible="{Binding IsClassroomOfflineVisible}"
                Background="{DynamicResource Brush.Accent.Clay}"
                CornerRadius="{DynamicResource Radius.S}"
                Padding="8,3"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding ClassroomOfflineAutomationName}">
          <StackPanel Orientation="Horizontal"
                      Spacing="5">
            <svg:Svg Width="14"
                     Height="14"
                     Path="{Binding ClassroomOfflineIconPath}" />
            <TextBlock Text="{Binding ClassroomOfflineText}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Accent.OnAccent}" />
          </StackPanel>
        </Border>

        <!-- Sept-23 Phase 05 (T05.11): offer to add a loose book's folder. -->
        <Button Grid.Column="2"
                Classes="tool"
                MinHeight="28"
                Padding="8,3"
                Margin="10,0,0,0"
                IsVisible="{Binding IsAddLooseFolderVisible}"
                AutomationProperties.Name="{Binding AddLooseFolderText}"
                Click="AddLooseFolder_Click">
          <TextBlock Text="{Binding AddLooseFolderText}"
                     FontSize="{DynamicResource Type.Size.Small}" />
        </Button>
      </Grid>
    </Border>

  </Grid>
</UserControl>
