<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Catalogue"
             xmlns:cat="using:OgmaLibrary.App.Views.Catalogue"
             xmlns:classroom="using:OgmaLibrary.App.Views.Classroom"
             xmlns:reader="using:OgmaLibrary.App.Views.Reader"
             xmlns:search="using:OgmaLibrary.App.Views.Search"
             xmlns:settings="using:OgmaLibrary.App.Views.Settings"
             xmlns:ai="using:OgmaLibrary.App.Views.Ai"
             xmlns:shelf3d="using:OgmaLibrary.App.Views.Shelf3D"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="OgmaLibrary.App.Views.Catalogue.CatalogueShellView"
             x:DataType="vm:MainShellViewModel"
             Focusable="True"
             KeyDown="CatalogueShellView_KeyDown">

  <!--
    The full catalogue shell (Phase 06): sidebar (shelves) + toolbar (view toggle,
    sort, filter) + content area (grid/list/directory) + detail panel.
    Replaces the empty-state-only window when books are present.
  -->

  <Grid ColumnDefinitions="Auto,*,Auto"
        RowDefinitions="*,Auto">

    <!-- ─── Left sidebar ───────────────────────────────────────────── -->
    <Border Grid.Row="0"
            Grid.Column="0"
            Width="220"
            IsVisible="{Binding IsSidebarOpen}"
            Background="{DynamicResource Brush.Surface.Footer}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*">

        <!-- Sidebar header -->
        <Border Grid.Row="0" Padding="12,10">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ShelfSidebar.ShelvesLabel}"
                       FontSize="{DynamicResource Type.Size.Subtitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}" />
            <TextBox Text="{Binding ShelfSidebar.NewShelfName, Mode=TwoWay}"
                     Watermark="{Binding ShelfSidebar.NewShelfWatermark}"
                     AutomationProperties.Name="{Binding ShelfSidebar.NewShelfWatermark}" />
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Button AutomationProperties.Name="{Binding ShelfSidebar.CreateShelfLabel}"
                      IsEnabled="{Binding ShelfSidebar.CanCreateShelf}"
                      Click="CreateShelf_Click">
                <TextBlock Text="{Binding ShelfSidebar.CreateShelfLabel}" />
              </Button>
              <Button AutomationProperties.Name="{Binding ShelfSidebar.DeleteShelfLabel}"
                      IsEnabled="{Binding ShelfSidebar.CanDeleteSelectedShelf}"
                      Click="DeleteShelf_Click">
                <TextBlock Text="{Binding ShelfSidebar.DeleteShelfLabel}" />
              </Button>
              <Button AutomationProperties.Name="{Binding ShelfSidebar.RenameShelfLabel}"
                      IsEnabled="{Binding ShelfSidebar.CanRenameSelectedShelf}"
                      Click="RenameShelf_Click">
                <TextBlock Text="{Binding ShelfSidebar.RenameShelfLabel}" />
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding ShelfSidebar.StatusText}"
                       IsVisible="{Binding ShelfSidebar.HasStatus}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Shelf list -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ShelfSidebar.Shelves}"
                 SelectedItem="{Binding ShelfSidebar.SelectedShelf, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2">
                <TextBlock Text="{Binding Name}"
                           FontSize="{DynamicResource Type.Size.Body}"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}"
                           VerticalAlignment="Center" />
                <Border CornerRadius="8"
                        Background="{DynamicResource Brush.Accent.Oak}"
                        Padding="6,1">
                  <TextBlock Text="{Binding BookCount}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="White" />
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- ─── Main content area ─────────────────────────────────────── -->
    <Grid Grid.Row="0"
          Grid.Column="1"
          RowDefinitions="Auto,Auto,Auto,Auto,*">

      <!-- Toolbar: view toggle + sort + filter -->
      <Border Grid.Row="0"
              Padding="12,8"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

          <!-- Sidebar toggle -->
          <Button Grid.Column="0"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="6"
                  AutomationProperties.Name="Toggle sidebar"
                  Click="SidebarToggle_Click">
            <TextBlock Text="☰" FontSize="18" Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          </Button>

          <Button Grid.Column="1"
                  Background="{DynamicResource Brush.Surface.Footer}"
                  BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.S}"
                  Padding="10,5"
                  Margin="8,0,4,0"
                  AutomationProperties.Name="{Binding LibraryLabel}"
                  Click="LibraryButton_Click">
            <TextBlock Text="{Binding LibraryLabel}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          </Button>

          <!-- View toggle buttons -->
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="2"
                      VerticalAlignment="Center"
                      Margin="8,0">

            <Button Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4"
                    AutomationProperties.Name="{Binding GridViewLabel}"
                    Click="GridViewButton_Click">
              <TextBlock Text="⊞" FontSize="16" Foreground="{DynamicResource Brush.Accent.Oak}" />
            </Button>

            <Button Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4"
                    AutomationProperties.Name="{Binding ListViewLabel}"
                    Click="ListViewButton_Click">
              <TextBlock Text="☰" FontSize="16" Foreground="{DynamicResource Brush.Surface.OnParchment}" />
            </Button>

            <Button Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4"
                    AutomationProperties.Name="{Binding DirectoryViewLabel}"
                    Click="DirectoryViewButton_Click">
              <TextBlock Text="📁" FontSize="16" />
            </Button>

            <Button Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4"
                    AutomationProperties.Name="{Binding Shelf3DViewLabel}"
                    ToolTip.Tip="{Binding Shelf3DViewLabel}"
                    IsEnabled="{Binding IsShelf3DAvailable}"
                    Click="Bookshelf3DButton_Click">
              <TextBlock Text="🗂" FontSize="16" Opacity="0.4" />
            </Button>

          </StackPanel>

          <!-- Search panel toggle -->
          <Button Grid.Column="3"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="8,4"
                  AutomationProperties.Name="{Binding SearchLabel}"
                  Click="SearchToggle_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <svg:Svg Width="16"
                       Height="16"
                       Path="{Binding SearchIconPath}" />
              <TextBlock Text="{Binding SearchLabel}" FontSize="13" Foreground="{DynamicResource Brush.Surface.OnParchment}" />
            </StackPanel>
          </Button>

          <!-- Student smart-search route -->
          <Button Grid.Column="4"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="8,4"
                  IsVisible="{Binding IsStudentSmartSearchVisible}"
                  AutomationProperties.Name="{Binding StudentSmartSearchLabel}"
                  Click="StudentSmartSearchButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <svg:Svg Width="16"
                       Height="16"
                       Path="{Binding StudentSmartSearchIconPath}" />
              <TextBlock Text="{Binding StudentSmartSearchLabel}" FontSize="13" Foreground="{DynamicResource Brush.Surface.OnParchment}" />
            </StackPanel>
          </Button>

          <Button Grid.Column="12"
                  Background="{DynamicResource Brush.Accent.Oak}"
                  Foreground="White"
                  BorderThickness="0"
                  Padding="10,5"
                  Margin="8,0,0,0"
                  AutomationProperties.Name="{Binding AdvisorLabel}"
                  Click="AdvisorButton_Click">
            <TextBlock Text="{Binding AdvisorLabel}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>

          <Button Grid.Column="13"
                  Background="{DynamicResource Brush.Surface.Footer}"
                  BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.S}"
                  Padding="10,5"
                  Margin="8,0,0,0"
                  AutomationProperties.Name="{Binding ReadingPlanLabel}"
                  Click="ReadingPlanButton_Click">
            <TextBlock Text="{Binding ReadingPlanLabel}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          </Button>

          <!-- Index Manager panel toggle -->
          <Button Grid.Column="5"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="8,4"
                  AutomationProperties.Name="{Binding IndexManagerLabel}"
                  Click="IndexManagerToggle_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <svg:Svg Width="16"
                       Height="16"
                       Path="{Binding IndexManagerIconPath}" />
              <TextBlock Text="{Binding IndexManagerLabel}" FontSize="13" Foreground="{DynamicResource Brush.Surface.OnParchment}" />
            </StackPanel>
          </Button>

          <!-- Split-view scaffold route -->
          <Button Grid.Column="6"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="8,4"
                  AutomationProperties.Name="{Binding SplitViewLabel}"
                  Click="SplitViewButton_Click">
            <TextBlock Text="||"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          </Button>

          <!-- Filter panel toggle -->
          <Button Grid.Column="7"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="8,4"
                  AutomationProperties.Name="{Binding FilterLabel}"
                  Click="FilterToggle_Click">
            <TextBlock Text="⚗" FontSize="16" Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
          </Button>

          <Button Grid.Column="8"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="8,4"
                  AutomationProperties.Name="{Binding SharingSettingsLabel}"
                  Click="SharingSettingsButton_Click">
            <TextBlock Text="{Binding SharingSettingsLabel}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          </Button>

          <Button Grid.Column="9"
                  Background="{DynamicResource Brush.Accent.Oak}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  Padding="10,5"
                  Margin="8,0,0,0"
                  AutomationProperties.Name="{Binding ChooseFolderText}"
                  Click="ChooseFolderButton_Click">
            <TextBlock Text="{Binding ChooseFolderText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>

          <Button Grid.Column="10"
                  Background="{DynamicResource Brush.Accent.Clay}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  Padding="10,5"
                  Margin="8,0,0,0"
                  AutomationProperties.Name="{Binding OpenPdfText}"
                  Click="OpenPdfButton_Click">
            <TextBlock Text="{Binding OpenPdfText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>

          <!-- Count badge -->
          <TextBlock Grid.Column="11"
                     VerticalAlignment="Center"
                     Margin="8,0,4,0"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} books">
                <Binding Path="Catalogue.FilteredCount" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>

        </Grid>
      </Border>

      <Panel Grid.Row="1"
             IsVisible="{Binding IsSearchPanelOpen}">
        <search:SearchPanelView x:Name="SearchPanel" DataContext="{Binding Search}" />
      </Panel>

      <Panel Grid.Row="2"
             IsVisible="{Binding IsIndexManagerOpen}">
        <search:IndexManagerPanelView DataContext="{Binding IndexManager}" />
      </Panel>

      <!-- Filter panel (inline, shown when open) -->
      <Border Grid.Row="3"
              IsVisible="{Binding IsFilterPanelOpen}"
              Background="{DynamicResource Brush.Surface.Footer}"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="0,0,0,1"
              Padding="12,8">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="Filters" FontSize="{DynamicResource Type.Size.Caption}" VerticalAlignment="Center" />
          <TextBox Width="150"
                   Text="{Binding Catalogue.Filter.TitleSearch, Mode=TwoWay}"
                   Watermark="Title"
                   AutomationProperties.Name="Filter by title" />
          <TextBox Width="150"
                   Text="{Binding Catalogue.Filter.AuthorSearch, Mode=TwoWay}"
                   Watermark="Author"
                   AutomationProperties.Name="Filter by author" />
          <ComboBox Width="120"
                    ItemsSource="{Binding Catalogue.Filter.SortOptions}"
                    SelectedItem="{Binding Catalogue.Filter.SortField, Mode=TwoWay}"
                    AutomationProperties.Name="Sort by" />
          <Button Padding="8,4"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.S}"
                  AutomationProperties.Name="{Binding Catalogue.Filter.SortDirectionText}"
                  Click="ToggleSortDirection_Click">
            <TextBlock Text="{Binding Catalogue.Filter.SortDirectionText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
          <Button Padding="8,4"
                  Background="{DynamicResource Brush.Accent.Clay}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  Click="ClearFilters_Click">
            <TextBlock Text="Clear all" FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
        </StackPanel>
      </Border>

      <!-- Main catalogue content (grid/list views) -->
      <Grid Grid.Row="4">

        <!-- Grid view wrapper controls visibility from MainShellViewModel; inner view has CatalogueViewModel DC -->
        <Grid IsVisible="{Binding IsCatalogueActive}">
          <Panel IsVisible="{Binding Catalogue.IsGridView}">
            <cat:CatalogueGridView DataContext="{Binding Catalogue}" />
          </Panel>

          <!-- List view -->
          <Panel IsVisible="{Binding Catalogue.IsListView}">
            <cat:CatalogueListView DataContext="{Binding Catalogue}" />
          </Panel>

          <!-- Directory view: virtualized library-root-relative paths. -->
          <Panel IsVisible="{Binding Catalogue.IsDirectoryView}">
            <cat:CatalogueDirectoryView DataContext="{Binding Catalogue}" />
          </Panel>

          <!-- Empty state -->
          <Border IsVisible="{Binding Catalogue.IsEmpty}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
            <StackPanel Spacing="8" MaxWidth="400">
              <TextBlock Text="{Binding EmptyStateHeading}"
                         FontSize="{DynamicResource Type.Size.Title}"
                         FontWeight="SemiBold"
                         TextAlignment="Center"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <TextBlock Text="{Binding EmptyStateBody}"
                         FontSize="{DynamicResource Type.Size.Body}"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          Spacing="8"
                          Margin="0,8,0,0">
                <Button Padding="16,8"
                        Background="{DynamicResource Brush.Accent.Oak}"
                        Foreground="White"
                        CornerRadius="{DynamicResource Radius.S}"
                        AutomationProperties.Name="{Binding ChooseFolderText}"
                        Click="ChooseFolderButton_Click">
                  <TextBlock Text="{Binding ChooseFolderText}" />
                </Button>
                <Button Padding="16,8"
                        Background="{DynamicResource Brush.Accent.Clay}"
                        Foreground="White"
                        CornerRadius="{DynamicResource Radius.S}"
                        AutomationProperties.Name="{Binding OpenPdfText}"
                        Click="OpenPdfButton_Click">
                  <TextBlock Text="{Binding OpenPdfText}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Panel IsVisible="{Binding IsReaderActive}">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Surface.Footer}"
                    BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
              <Button Padding="12,6"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource Brush.Accent.Oak}"
                      Foreground="White"
                      CornerRadius="{DynamicResource Radius.S}"
                      AutomationProperties.Name="{Binding BackToLibraryLabel}"
                      Click="LibraryButton_Click">
                <TextBlock Text="{Binding BackToLibraryLabel}"
                           FontSize="{DynamicResource Type.Size.Caption}" />
              </Button>
            </Border>

            <reader:ReaderView Grid.Row="1" DataContext="{Binding Reader}" />
          </Grid>
        </Panel>

        <Panel IsVisible="{Binding IsSplitViewActive}">
          <reader:SplitViewView DataContext="{Binding SplitView}" />
        </Panel>

        <Panel IsVisible="{Binding IsStudentSmartSearchActive}">
          <classroom:StudentSmartSearchView DataContext="{Binding StudentSmartSearch}" />
        </Panel>

        <Panel IsVisible="{Binding IsAdvisorActive}">
          <ai:RecommendationPanelView DataContext="{Binding Advisor}" />
        </Panel>

        <Panel IsVisible="{Binding IsReadingPlanActive}">
          <ai:ReadingPlanView DataContext="{Binding ReadingPlan}" />
        </Panel>

        <Panel IsVisible="{Binding IsBookshelf3DActive}">
          <shelf3d:Bookshelf3DView DataContext="{Binding Bookshelf3D}" />
        </Panel>

        <Panel IsVisible="{Binding IsSharingSettingsActive}">
          <settings:SharingSettingsView DataContext="{Binding HostSharing}" />
        </Panel>

      </Grid>
    </Grid>

    <!-- ─── Book detail panel ─────────────────────────────────────── -->
    <Border Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="360"
            Margin="0,0,16,16"
            Padding="14"
            Background="{DynamicResource Brush.Surface.Parchment}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.S}"
            DataContext="{Binding HostSharing}"
            IsVisible="{Binding IsSharePanelOpen}"
            x:CompileBindings="False">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding SharePanelTitle}"
                     FontSize="{DynamicResource Type.Size.Subtitle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Padding="8,4"
                  Background="Transparent"
                  BorderThickness="0"
                  AutomationProperties.Name="{Binding CloseSharePanelText}"
                  Click="HostCloseSharePanelButton_Click">
            <TextBlock Text="x"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
          </Button>
        </Grid>

        <TextBlock Text="{Binding SharePanelSubtitle}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                   TextWrapping="Wrap" />

        <Border HorizontalAlignment="Center"
                Background="White"
                BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                BorderThickness="1"
                Padding="8">
          <TextBlock Text="{Binding QrCodeText}"
                     FontFamily="Consolas, Menlo, monospace"
                     FontSize="3"
                     LineHeight="3"
                     Foreground="Black" />
        </Border>

        <TextBox Text="{Binding ManualJoinUri, Mode=OneWay}"
                 IsReadOnly="True"
                 FontSize="{DynamicResource Type.Size.Caption}"
                 TextWrapping="NoWrap"
                 AutomationProperties.Name="LAN Host join link" />

        <TextBlock Text="{Binding EnrollmentCodeText}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Accent.Slate}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="LAN Host enrollment code" />

        <TextBlock Text="{Binding FullFingerprintText}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   Foreground="{DynamicResource Brush.Accent.Slate}"
                   TextWrapping="Wrap" />

        <TextBlock Text="{Binding ShareConfirmationText}"
                   IsVisible="{Binding HasShareConfirmation}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   Foreground="{DynamicResource Brush.Accent.Sage}"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Button Padding="10,5"
                  Background="{DynamicResource Brush.Accent.Slate}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  AutomationProperties.Name="{Binding CopyJoinLinkText}"
                  Click="HostCopyJoinLinkButton_Click">
            <TextBlock Text="{Binding CopyJoinLinkText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
          <Button Padding="10,5"
                  Background="{DynamicResource Brush.Accent.Oak}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  AutomationProperties.Name="{Binding CopyFingerprintText}"
                  Click="HostCopyFingerprintButton_Click">
            <TextBlock Text="{Binding CopyFingerprintText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="360"
            Margin="0,0,16,92"
            Padding="12"
            Background="{DynamicResource Brush.Surface.Parchment}"
            BorderBrush="{DynamicResource Brush.Accent.Sage}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.S}"
            DataContext="{Binding HostSharing}"
            IsVisible="{Binding IsStartConfirmationOpen}"
            x:CompileBindings="False">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding StartConfirmationText}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}"
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Button Padding="10,5"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.S}"
                  AutomationProperties.Name="{Binding CancelConfirmationText}"
                  Click="HostCancelStartConfirmationButton_Click">
            <TextBlock Text="{Binding CancelConfirmationText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
          <Button Padding="10,5"
                  Background="{DynamicResource Brush.Accent.Sage}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  AutomationProperties.Name="{Binding ConfirmStartText}"
                  Click="HostConfirmStartButton_Click">
            <TextBlock Text="{Binding ConfirmStartText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="360"
            Margin="0,0,16,92"
            Padding="12"
            Background="{DynamicResource Brush.Surface.Parchment}"
            BorderBrush="{DynamicResource Brush.Accent.Clay}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.S}"
            DataContext="{Binding HostSharing}"
            IsVisible="{Binding IsFileStreamConfirmationOpen}"
            x:CompileBindings="False">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding FileStreamConfirmationText}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}"
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Button Padding="10,5"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.S}"
                  AutomationProperties.Name="{Binding CancelConfirmationText}"
                  Click="HostCancelFileStreamConfirmationButton_Click">
            <TextBlock Text="{Binding CancelConfirmationText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
          <Button Padding="10,5"
                  Background="{DynamicResource Brush.Accent.Clay}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  AutomationProperties.Name="{Binding ConfirmFileStreamText}"
                  Click="HostConfirmFileStreamButton_Click">
            <TextBlock Text="{Binding ConfirmFileStreamText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <cat:BookDetailView Grid.Row="0"
                        Grid.Column="2"
                        DataContext="{Binding BookDetail}"
                        IsVisible="{Binding BookDetail.IsVisible}"
                        x:CompileBindings="False" />

    <Border Grid.Row="1"
            Grid.ColumnSpan="3"
            Background="{DynamicResource Brush.Surface.Footer}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusText}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                   VerticalAlignment="Center" />

        <Border Grid.Column="1"
                IsVisible="{Binding IsClassroomOfflineVisible}"
                Background="{DynamicResource Brush.Accent.Clay}"
                CornerRadius="{DynamicResource Radius.S}"
                Padding="8,3"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding ClassroomOfflineAutomationName}">
          <StackPanel Orientation="Horizontal"
                      Spacing="5">
            <svg:Svg Width="14"
                     Height="14"
                     Path="{Binding ClassroomOfflineIconPath}" />
            <TextBlock Text="{Binding ClassroomOfflineText}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       FontWeight="SemiBold"
                       Foreground="White" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsHostSharingVisible}">
          <TextBlock Text="{Binding HostSharing.Title}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding HostSharing.StatusText}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding HostSharing.ClientCountText}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding HostSharing.FingerprintText}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Accent.Slate}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding HostSharing.ContentModeText}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     VerticalAlignment="Center" />
          <Button Padding="8,3"
                  Background="{DynamicResource Brush.Accent.Oak}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsEnabled="{Binding HostSharing.CanShare}"
                  AutomationProperties.Name="{Binding HostSharing.ShareButtonText}"
                  Click="HostShareButton_Click">
            <TextBlock Text="{Binding HostSharing.ShareButtonText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
          <Button Padding="8,3"
                  Background="{DynamicResource Brush.Accent.Slate}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsEnabled="{Binding HostSharing.CanChangeContentMode}"
                  AutomationProperties.Name="{Binding HostSharing.ToggleContentModeText}"
                  Click="HostContentModeButton_Click">
            <TextBlock Text="{Binding HostSharing.ToggleContentModeText}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
          <Button Padding="8,3"
                  Background="{DynamicResource Brush.Accent.Sage}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsEnabled="{Binding HostSharing.CanStart}"
                  AutomationProperties.Name="Start Library Host"
                  Click="HostStartButton_Click">
            <TextBlock Text="Start"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
          <Button Padding="8,3"
                  Background="{DynamicResource Brush.Accent.Clay}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsEnabled="{Binding HostSharing.CanStop}"
                  AutomationProperties.Name="Stop Library Host"
                  Click="HostStopButton_Click">
            <TextBlock Text="Stop"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</UserControl>
