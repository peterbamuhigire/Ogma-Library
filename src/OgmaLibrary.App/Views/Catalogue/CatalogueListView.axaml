<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Catalogue"
             xmlns:app="using:OgmaLibrary.Application.Catalogue"
             x:Class="OgmaLibrary.App.Views.Catalogue.CatalogueListView"
             x:DataType="vm:CatalogueViewModel">

  <!--
    List view: virtualizing ListBox showing one row per book.
    Row = small cover placeholder + title + author + year + rating + status.
  -->

  <ListBox ItemsSource="{Binding FilteredItems}"
           SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
           SelectionMode="Single"
           Background="Transparent"
           BorderThickness="0">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="app:BookSummaryProjection">
        <Border Padding="12,8"
                AutomationProperties.Name="{Binding Title}">
          <Grid ColumnDefinitions="56,*,60,40">

            <!-- Cover placeholder -->
            <Border Grid.Column="0"
                    Width="40" Height="54"
                    CornerRadius="{DynamicResource Radius.S}"
                    Background="{DynamicResource Brush.Accent.Ink}"
                    VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="White"
                         FontSize="9"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="36"
                         Text="{Binding Title}" />
            </Border>

            <!-- Title + Author -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2"
                        Margin="0,0,8,0">
              <TextBlock Text="{Binding Title}"
                         FontSize="{DynamicResource Type.Size.Body}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                         TextTrimming="CharacterEllipsis">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}">
                    <Binding Path="Authors[0]" FallbackValue="Unknown Author" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>

            <!-- Year -->
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                       Text="{Binding Year}"
                       HorizontalAlignment="Center" />

            <!-- Rating -->
            <TextBlock Grid.Column="3"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Accent.Oak}"
                       Text="{Binding Rating}"
                       HorizontalAlignment="Center" />

          </Grid>
        </Border>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
