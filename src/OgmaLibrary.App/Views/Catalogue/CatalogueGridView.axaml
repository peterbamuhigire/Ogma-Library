<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Catalogue"
             xmlns:app="using:OgmaLibrary.Application.Catalogue"
             xmlns:cat="using:OgmaLibrary.App.Views.Catalogue"
             x:Class="OgmaLibrary.App.Views.Catalogue.CatalogueGridView"
             x:DataType="vm:CatalogueViewModel">

  <!--
    Grid view: ListBox with WrapPanel for cover display.
    Each cell shows a cover placeholder, the title, and the primary author.
    Selecting a book routes through IBookDetailNavigationService.
  -->

  <ListBox ItemsSource="{Binding FilteredItems}"
           SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
           SelectionMode="Single"
           Background="Transparent"
           BorderThickness="0"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           AutomationProperties.AutomationId="Catalogue.Grid">
    <ListBox.Styles>
      <!-- Sept-23 K14: the readable accessible name and a stable automation id belong on the
           ListBoxItem container; otherwise UI Automation announces the record's ToString(). -->
      <Style Selector="ListBoxItem" x:DataType="app:BookSummaryProjection">
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="AutomationProperties.AutomationId" Value="{Binding BookId, StringFormat='Catalogue.Item.{0}'}" />
      </Style>
    </ListBox.Styles>
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="app:BookSummaryProjection">
        <Border Width="160"
                Height="230"
                Margin="6"
                CornerRadius="{DynamicResource Radius.S}"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                BorderThickness="1"
                Cursor="Hand"
                AutomationProperties.Name="{Binding Title}"
                AutomationProperties.HelpText="{Binding PrimaryAuthor}"
                ToolTip.Tip="{Binding Title}"
                PointerPressed="BookCard_PointerPressed">
          <Border.Styles>
            <Style Selector="Border:pointerover">
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Oak}" />
            </Style>
          </Border.Styles>
          <StackPanel Spacing="0">
            <!-- Cover placeholder — will be replaced by real cover in Phase 07 -->
            <cat:CoverImageView Height="160"
                                AutomationProperties.AutomationId="Catalogue.Item.Cover"
                                RelativePath="{Binding CoverRelativePath}"
                                RootPath="{Binding $parent[UserControl].DataContext.LibraryRootPath}"
                                Label="{Binding Title}" />
            <!-- Metadata area -->
            <StackPanel Margin="10,8,10,8" Spacing="3">
              <TextBlock Text="{Binding Title}"
                         FontSize="{DynamicResource Type.Size.Small}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="2"
                         TextWrapping="Wrap" />
              <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding PrimaryAuthor}" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="3" LineSpacing="3">
                <Border IsVisible="{Binding Processing.IsIndexed}"
                        Background="{DynamicResource Brush.Accent.Sage}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.IndexedBadgeText}"
                             AutomationProperties.AutomationId="Catalogue.Item.Badge.Indexed"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="White" />
                </Border>
                <Border IsVisible="{Binding Processing.IsIndexing}"
                        Background="{DynamicResource Brush.Accent.Oak}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.IndexingBadgeText}"
                             AutomationProperties.AutomationId="Catalogue.Item.Badge.Indexing"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="White" />
                </Border>
                <Border IsVisible="{Binding Processing.IsIndexFailed}"
                        Background="{DynamicResource Brush.Accent.Clay}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.IndexFailedBadgeText}"
                             AutomationProperties.AutomationId="Catalogue.Item.Badge.IndexFailed"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="White" />
                </Border>
                <!-- Sept-23 Phase 17 (K21): honest text status, derived from pages and OCR. -->
                <Border IsVisible="{Binding Processing.IsTextSearchable}"
                        Background="{DynamicResource Brush.Accent.Sage}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.TextSearchableBadgeText}"
                             AutomationProperties.AutomationId="Catalogue.Item.Badge.Searchable"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Accent.OnAccent}" />
                </Border>
                <Border IsVisible="{Binding Processing.IsPartlySearchable}"
                        Background="{DynamicResource Brush.Accent.Oak}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.TextPartlyBadgeText}"
                             AutomationProperties.AutomationId="Catalogue.Item.Badge.PartlySearchable"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Accent.OnAccent}" />
                </Border>
                <Border IsVisible="{Binding Processing.IsImageOnly}"
                        Background="{DynamicResource Brush.Accent.Slate}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.TextImageOnlyBadgeText}"
                             AutomationProperties.AutomationId="Catalogue.Item.Badge.ImageOnly"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Accent.OnAccent}" />
                </Border>
                <Border IsVisible="{Binding Processing.IsOcrInProgress}"
                        Background="{DynamicResource Brush.Accent.Oak}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.TextOcrInProgressBadgeText}"
                             AutomationProperties.AutomationId="Catalogue.Item.Badge.OcrInProgress"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Accent.OnAccent}" />
                </Border>
                <Border IsVisible="{Binding Processing.IsOcrText}"
                        Background="{DynamicResource Brush.Accent.Slate}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="{Binding $parent[UserControl].DataContext.TextOcrBadgeText}"
                               AutomationProperties.AutomationId="Catalogue.Item.Badge.OcrText"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Accent.OnAccent}" />
                    <TextBlock Text="{Binding Processing.OcrConfidencePercent, StringFormat={}{0} %}"
                               AutomationProperties.AutomationId="Catalogue.Item.Badge.OcrConfidence"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Accent.OnAccent}" />
                  </StackPanel>
                </Border>
                <Border IsVisible="{Binding Processing.IsNoText}"
                        Background="{DynamicResource Brush.Accent.Clay}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.TextNoneBadgeText}"
                             AutomationProperties.AutomationId="Catalogue.Item.Badge.NoText"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Accent.OnAccent}" />
                </Border>
                <Border IsVisible="{Binding Processing.IsOcrFailed}"
                        Background="{DynamicResource Brush.Accent.Clay}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.TextOcrFailedBadgeText}"
                             AutomationProperties.AutomationId="Catalogue.Item.Badge.OcrFailed"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Accent.OnAccent}" />
                </Border>
                <Border IsVisible="{Binding Processing.IsEmbedded}"
                        Background="{DynamicResource Brush.Accent.Ink}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.EmbeddedBadgeText}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="White" />
                </Border>
                <Border IsVisible="{Binding Processing.ShowLegacyOcrBadge}"
                        Background="{DynamicResource Brush.Accent.Slate}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.OcrBadgeText}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="White" />
                </Border>
                <Border IsVisible="{Binding Processing.HasQualityScore}"
                        Background="{DynamicResource Brush.Accent.Plum}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding Processing.QualityScore, StringFormat={}{0:P0}}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="White" />
                </Border>
                <Border IsVisible="{Binding !IsAvailable}"
                        Background="{DynamicResource Brush.Accent.Clay}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.UnavailableBadgeText}"
                             AutomationProperties.AutomationId="Catalogue.Item.Badge.Unavailable"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="White" />
                </Border>
                <Border IsVisible="{Binding IsLocked}"
                        Background="{DynamicResource Brush.Accent.Slate}"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="4,1"
                        AutomationProperties.Name="{Binding $parent[UserControl].DataContext.LockedBadgeText}">
                  <TextBlock Text="{Binding $parent[UserControl].DataContext.LockedBadgeText}"
                             AutomationProperties.AutomationId="Catalogue.Item.Badge.Locked"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Accent.OnAccent}" />
                </Border>
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
