<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Catalogue"
             xmlns:cat="using:OgmaLibrary.App.Views.Catalogue"
             x:Class="OgmaLibrary.App.Views.Catalogue.BookDetailView"
             x:DataType="vm:BookDetailViewModel"
             IsVisible="{Binding IsVisible}">

  <!--
    Book-detail inspector (FR-CAT-004; Sept-23 Phase 11, slice 2).
    Header: compact cover, title (Spectral), authors, year, one state-driven primary action,
    a "More actions" overflow menu, curation (status, rating, favourite) and Close.
    Four segmented sections replace the earlier seven tabs: Overview, Details, Contents, Activity.
    There is no footer button row; Enrich, Run OCR, Add to collection, write-back, Show in folder
    and Forget password live in the overflow menu.
  -->

  <Border Background="{DynamicResource Brush.Surface.Card}"
          BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
          BorderThickness="1,0,0,0"
          Width="360"
          MinWidth="320">

    <Grid RowDefinitions="Auto,Auto,*">

      <!-- Header -->
      <StackPanel Grid.Row="0"
                  Spacing="8"
                  Margin="16,12,12,8"
                  AutomationProperties.AutomationId="Detail.Header">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <cat:CoverImageView Grid.Column="0"
                              Width="56"
                              Height="80"
                              Margin="0,0,12,0"
                              VerticalAlignment="Top"
                              RelativePath="{Binding Book.CoverRelativePath}"
                              RootPath="{Binding AssetRootPath}"
                              Label="{Binding Title}"
                              Subtitle="{Binding AuthorsDisplay}" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
            <TextBlock Classes="ogma-display"
                       FontSize="{DynamicResource Type.Size.Title}"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}"
                       Text="{Binding Title}"
                       ToolTip.Tip="{Binding Title}"
                       AutomationProperties.AutomationId="Detail.Title"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="2" />
            <TextBlock Text="{Binding AuthorsDisplay}"
                       ToolTip.Tip="{Binding AuthorsDisplay}"
                       AutomationProperties.AutomationId="Detail.Authors"
                       FontSize="{DynamicResource Type.Size.Small}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="2" />
            <TextBlock Text="{Binding Year}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
          </StackPanel>
          <Button Classes="tool" Grid.Column="2"
                  BorderThickness="0"
                  Padding="6"
                  VerticalAlignment="Top"
                  AutomationProperties.AutomationId="Detail.Action.Close"
                  AutomationProperties.Name="{Binding CloseButtonText}"
                  ToolTip.Tip="{Binding CloseButtonText}"
                  Click="CloseButton_Click">
            <TextBlock Text="✕" FontSize="{DynamicResource Type.Size.Body}" Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
          </Button>
        </Grid>

        <!-- One primary action, then the overflow menu -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Button Classes="primary" Grid.Column="0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="12,6"
                  IsEnabled="{Binding CanExecutePrimaryAction}"
                  AutomationProperties.AutomationId="Detail.Action.Read"
                  AutomationProperties.Name="{Binding PrimaryActionText}"
                  Click="PrimaryActionButton_Click">
            <TextBlock Text="{Binding PrimaryActionText}" TextTrimming="CharacterEllipsis" />
          </Button>
          <Button x:Name="MoreButton"
                  Classes="tool" Grid.Column="1"
                  Padding="10,6"
                  AutomationProperties.AutomationId="Detail.Action.More"
                  AutomationProperties.Name="{Binding MoreActionsText}"
                  ToolTip.Tip="{Binding MoreActionsText}">
            <TextBlock Text="⋯" FontSize="{DynamicResource Type.Size.Body}" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="MoreMenu_Opening">
                <MenuItem Header="{Binding EnrichText}"
                          IsEnabled="{Binding CanEnrich}"
                          ToolTip.Tip="{Binding EnrichTooltip}"
                          AutomationProperties.AutomationId="Detail.Action.Enrich"
                          AutomationProperties.Name="{Binding EnrichText}"
                          Click="EnrichButton_Click" />
                <MenuItem Header="{Binding RunOcrText}"
                          IsEnabled="{Binding CanRunOcr}"
                          ToolTip.Tip="{Binding RunOcrTooltip}"
                          AutomationProperties.AutomationId="Detail.Action.RunOcr"
                          AutomationProperties.Name="{Binding RunOcrText}"
                          Click="RunOcrButton_Click" />
                <MenuItem x:Name="AddToShelfMenuItem"
                          Header="{Binding AddToShelfMenuText}"
                          AutomationProperties.AutomationId="Detail.Action.AddToShelf"
                          AutomationProperties.Name="{Binding AddToShelfMenuText}" />
                <MenuItem Header="{Binding WriteMetadataMenuText}"
                          IsEnabled="{Binding CanPrepareWriteBack}"
                          AutomationProperties.AutomationId="Detail.Action.WriteMetadata"
                          AutomationProperties.Name="{Binding WriteMetadataMenuText}"
                          Click="PrepareWriteBackButton_Click" />
                <MenuItem Header="{Binding ShowInFolderText}"
                          IsEnabled="{Binding CanShowInFolder}"
                          AutomationProperties.AutomationId="Detail.Action.ShowInFolder"
                          AutomationProperties.Name="{Binding ShowInFolderText}"
                          Click="ShowInFolderButton_Click" />
                <MenuItem Header="{Binding ForgetPasswordText}"
                          IsVisible="{Binding IsPasswordProtected}"
                          IsEnabled="{Binding CanForgetPassword}"
                          ToolTip.Tip="{Binding ForgetPasswordTooltip}"
                          AutomationProperties.AutomationId="Detail.Action.ForgetPassword"
                          AutomationProperties.Name="{Binding ForgetPasswordText}"
                          Click="ForgetPasswordButton_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>

        <!-- Curation: reading status, rating and favourite (moved up from Bibliographic) -->
        <WrapPanel Orientation="Horizontal"
                   ItemSpacing="4"
                   LineSpacing="4"
                   IsVisible="{Binding CanUpdateCuration}">
          <ComboBox x:Name="ReadingStatusPicker"
                    MinWidth="120"
                    SelectedIndex="{Binding CurrentReadingStatusIndex, Mode=OneWay}"
                    AutomationProperties.AutomationId="Detail.Curation.Status"
                    AutomationProperties.Name="{Binding CurationStatusLabel}"
                    ToolTip.Tip="{Binding CurationStatusLabel}"
                    SelectionChanged="ReadingStatusPicker_SelectionChanged">
            <ComboBoxItem Content="{Binding CurationUnreadText}" AutomationProperties.Name="{Binding CurationUnreadText}" />
            <ComboBoxItem Content="{Binding CurationReadingText}" AutomationProperties.Name="{Binding CurationReadingText}" />
            <ComboBoxItem Content="{Binding CurationFinishedText}" AutomationProperties.Name="{Binding CurationFinishedText}" />
            <ComboBoxItem Content="{Binding CurationAbandonedText}" AutomationProperties.Name="{Binding CurationAbandonedText}" />
          </ComboBox>
          <StackPanel Orientation="Horizontal" Spacing="2" ToolTip.Tip="{Binding CurationRatingLabel}">
            <Button Classes="compact" Tag="1" Click="RatingButton_Click" AutomationProperties.Name="{Binding RatingOneAccessibilityText}"><TextBlock Text="1" /></Button>
            <Button Classes="compact" Tag="2" Click="RatingButton_Click" AutomationProperties.Name="{Binding RatingTwoAccessibilityText}"><TextBlock Text="2" /></Button>
            <Button Classes="compact" Tag="3" Click="RatingButton_Click" AutomationProperties.Name="{Binding RatingThreeAccessibilityText}"><TextBlock Text="3" /></Button>
            <Button Classes="compact" Tag="4" Click="RatingButton_Click" AutomationProperties.Name="{Binding RatingFourAccessibilityText}"><TextBlock Text="4" /></Button>
            <Button Classes="compact" Tag="5" Click="RatingButton_Click" AutomationProperties.Name="{Binding RatingFiveAccessibilityText}"><TextBlock Text="5" /></Button>
          </StackPanel>
          <Button Classes="compact"
                  Click="FavouriteButton_Click"
                  AutomationProperties.AutomationId="Detail.Curation.Favourite"
                  AutomationProperties.Name="{Binding FavouriteButtonText}">
            <TextBlock Text="{Binding FavouriteButtonText}" />
          </Button>
        </WrapPanel>
        <TextBlock Text="{Binding CurationStatusText}"
                   IsVisible="{Binding HasCurationStatus}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                   TextWrapping="Wrap" />

        <!-- Open error: a failed or impossible primary action keeps the panel open (11.8) -->
        <TextBlock Text="{Binding OpenErrorText}"
                   IsVisible="{Binding HasOpenError}"
                   AutomationProperties.AutomationId="Detail.OpenError"
                   AutomationProperties.Name="{Binding OpenErrorText}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Section switcher -->
      <Border Grid.Row="1"
              Classes="segmented"
              Margin="16,0,16,8"
              AutomationProperties.AutomationId="Detail.Sections"
              AutomationProperties.Name="{Binding SectionsAccessibleText}">
        <Grid ColumnDefinitions="*,*,*,*">
          <Button Grid.Column="0" Classes="segment"
                  Classes.selected="{Binding IsOverviewSection}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Tag="Overview"
                  AutomationProperties.AutomationId="Detail.Section.Overview"
                  AutomationProperties.Name="{Binding OverviewSectionText}"
                  Click="SectionButton_Click">
            <TextBlock Text="{Binding OverviewSectionText}" TextTrimming="CharacterEllipsis" />
          </Button>
          <Button Grid.Column="1" Classes="segment"
                  Classes.selected="{Binding IsDetailsSection}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Tag="Details"
                  AutomationProperties.AutomationId="Detail.Section.Details"
                  AutomationProperties.Name="{Binding DetailsSectionText}"
                  Click="SectionButton_Click">
            <TextBlock Text="{Binding DetailsSectionText}" TextTrimming="CharacterEllipsis" />
          </Button>
          <Button Grid.Column="2" Classes="segment"
                  Classes.selected="{Binding IsContentsSection}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Tag="Contents"
                  AutomationProperties.AutomationId="Detail.Section.Contents"
                  AutomationProperties.Name="{Binding ContentsSectionText}"
                  Click="SectionButton_Click">
            <TextBlock Text="{Binding ContentsSectionText}" TextTrimming="CharacterEllipsis" />
          </Button>
          <Button Grid.Column="3" Classes="segment"
                  Classes.selected="{Binding IsActivitySection}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Tag="Activity"
                  AutomationProperties.AutomationId="Detail.Section.Activity"
                  AutomationProperties.Name="{Binding ActivitySectionText}"
                  Click="SectionButton_Click">
            <TextBlock Text="{Binding ActivitySectionText}" TextTrimming="CharacterEllipsis" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="2">
        <StackPanel Margin="16,0,16,16">

          <!-- ── Overview ───────────────────────────────────────────────── -->
          <StackPanel Spacing="6"
                      IsVisible="{Binding IsOverviewSection}"
                      AutomationProperties.AutomationId="Detail.Section.Overview.Content">
            <StackPanel Spacing="5" IsVisible="{Binding CanEditTags}">
              <TextBlock Text="{Binding TagsLabel}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <TextBox Text="{Binding TagsText, Mode=TwoWay}"
                       Watermark="{Binding TagsWatermark}"
                       AutomationProperties.Name="{Binding TagsLabel}" />
              <Button HorizontalAlignment="Left"
                      IsEnabled="{Binding CanEditTags}"
                      AutomationProperties.Name="{Binding SaveTagsLabel}"
                      Click="SaveTagsButton_Click">
                <TextBlock Text="{Binding SaveTagsLabel}" />
              </Button>
              <TextBlock Text="{Binding TagsStatusText}"
                         IsVisible="{Binding HasTagsStatus}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding ProgressSummaryText}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
            <TextBlock Text="{Binding LastReadSummaryText}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
            <TextBlock Text="{Binding AnnotationSummaryText}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
            <StackPanel Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="{Binding ReadingMemorySummaryLabel}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}: {1}">
                    <Binding Path="ReadingMemoryDispositionLabel" />
                    <Binding Path="ReadingMemoryDispositionDisplay" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}: {1}">
                    <Binding Path="ReadingMemoryKeyInsightLabel" />
                    <Binding Path="ReadingMemoryKeyInsightExcerpt" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <StackPanel Spacing="5"
                          Margin="0,8,0,0"
                          IsVisible="{Binding CanEditReadingMemory}">
                <TextBlock Text="{Binding ReadingMemoryOpenedBecauseLabel}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBox Text="{Binding ReadingMemoryOpenedBecause}"
                         AcceptsReturn="True"
                         MinHeight="44"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding ReadingMemoryOpenedBecauseLabel}"
                         LostFocus="ReadingMemoryField_LostFocus" />
                <TextBlock Text="{Binding ReadingMemoryKeyInsightLabel}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBox Text="{Binding ReadingMemoryKeyInsight}"
                         AcceptsReturn="True"
                         MinHeight="44"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding ReadingMemoryKeyInsightLabel}"
                         LostFocus="ReadingMemoryField_LostFocus" />
                <TextBlock Text="{Binding ReadingMemoryOpenQuestionsLabel}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBox Text="{Binding ReadingMemoryOpenQuestions}"
                         AcceptsReturn="True"
                         MinHeight="44"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding ReadingMemoryOpenQuestionsLabel}"
                         LostFocus="ReadingMemoryField_LostFocus" />
                <TextBlock Text="{Binding ReadingMemoryDispositionLabel}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBox Text="{Binding ReadingMemoryDispositionText}"
                         AutomationProperties.Name="{Binding ReadingMemoryDispositionLabel}"
                         LostFocus="ReadingMemoryField_LostFocus" />
                <Button HorizontalAlignment="Left"
                        Padding="10,4"
                        IsEnabled="{Binding CanSaveReadingMemory}"
                        AutomationProperties.Name="{Binding ReadingMemorySaveLabel}"
                        Click="SaveReadingMemoryButton_Click">
                  <TextBlock Text="{Binding ReadingMemorySaveLabel}" />
                </Button>
                <TextBlock Text="{Binding ReadingMemoryStatusText}"
                           IsVisible="{Binding HasReadingMemoryStatus}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- ── Details ────────────────────────────────────────────────── -->
          <StackPanel Spacing="6"
                      IsVisible="{Binding IsDetailsSection}"
                      AutomationProperties.AutomationId="Detail.Section.Details.Content">
            <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
              <TextBlock.Text>
                <MultiBinding StringFormat="ISBN: {0}">
                  <Binding Path="Isbn" FallbackValue="—" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
              <TextBlock.Text>
                <MultiBinding StringFormat="DOI: {0}">
                  <Binding Path="Doi" FallbackValue="—" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding BiblioFieldDisplayRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                             TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding FileAvailabilityText}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}" />

            <!-- Write-back preview, opened from "Write metadata to PDF…" -->
            <StackPanel Spacing="5"
                        Margin="0,8,0,0"
                        IsVisible="{Binding HasPreparedWriteBack}">
              <TextBlock Text="{Binding WriteBackHeadingText}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <ItemsControl ItemsSource="{Binding WriteBackDiffRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                               TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5">
                <Button IsEnabled="{Binding CanConfirmWriteBack}"
                        AutomationProperties.Name="{Binding ConfirmWriteBackLabel}"
                        Click="ConfirmWriteBackButton_Click">
                  <TextBlock Text="{Binding ConfirmWriteBackLabel}" />
                </Button>
                <Button IsEnabled="{Binding CanRestoreWriteBack}"
                        AutomationProperties.Name="{Binding RestoreWriteBackLabel}"
                        Click="RestoreWriteBackButton_Click">
                  <TextBlock Text="{Binding RestoreWriteBackLabel}" />
                </Button>
                <Button IsEnabled="{Binding CanRestoreWriteBack}"
                        AutomationProperties.Name="{Binding CancelWriteBackLabel}"
                        Click="CancelWriteBackButton_Click">
                  <TextBlock Text="{Binding CancelWriteBackLabel}" />
                </Button>
              </WrapPanel>
            </StackPanel>
            <TextBlock Text="{Binding WriteBackStatusText}"
                       IsVisible="{Binding HasWriteBackStatus}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding PasswordStatusText}"
                       IsVisible="{Binding HasPasswordStatus}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                       TextWrapping="Wrap" />

            <Expander Header="{Binding TechnicalDetailsText}"
                      IsExpanded="False"
                      HorizontalAlignment="Stretch"
                      Margin="0,8,0,0"
                      AutomationProperties.AutomationId="Detail.Technical"
                      AutomationProperties.Name="{Binding TechnicalDetailsText}">
              <StackPanel Spacing="6">
                <TextBlock Classes="ogma-mono"
                           Text="{Binding RelativePath}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="ogma-mono"
                           Text="{Binding SizeDisplayText}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                <TextBlock Classes="ogma-mono"
                           Text="{Binding Sha256Hash}"
                           AutomationProperties.AutomationId="Detail.Technical.Hash"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                           TextWrapping="Wrap" />
                <!-- Sept-23 Phase 17: honest text status and text quality. -->
                <TextBlock Text="{Binding TextStatusText}"
                           IsVisible="{Binding HasTextStatus}"
                           AutomationProperties.AutomationId="Detail.TextStatus"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding TextQualityText}"
                           IsVisible="{Binding HasTextStatus}"
                           AutomationProperties.AutomationId="Detail.TextQuality"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>

          <!-- ── Contents ───────────────────────────────────────────────── -->
          <StackPanel Spacing="5"
                      IsVisible="{Binding IsContentsSection}"
                      AutomationProperties.AutomationId="Detail.Section.Contents.Content">
            <Button HorizontalAlignment="Left"
                    IsVisible="{Binding ShowLoadTocButton}"
                    IsEnabled="{Binding CanLoadToc}"
                    AutomationProperties.Name="{Binding LoadTocLabel}"
                    Click="LoadTocButton_Click">
              <TextBlock Text="{Binding LoadTocLabel}" />
            </Button>
            <TextBlock Text="{Binding TocLoadingText}"
                       IsVisible="{Binding IsLoadingToc}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
            <ItemsControl ItemsSource="{Binding TocRows}"
                          IsVisible="{Binding IsTocLoaded}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                             TextWrapping="Wrap"
                             Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding TocEmptyText}"
                       IsVisible="{Binding HasNoToc}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <!-- ── Activity ───────────────────────────────────────────────── -->
          <StackPanel Spacing="6"
                      IsVisible="{Binding IsActivitySection}"
                      AutomationProperties.AutomationId="Detail.Section.Activity.Content">
            <TextBlock Text="{Binding EnrichmentStatusText}"
                       IsVisible="{Binding HasEnrichmentStatus}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding OcrStatusText}"
                       IsVisible="{Binding HasOcrStatus}"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding OcrFailureText}"
                       IsVisible="{Binding HasOcrFailure}"
                       AutomationProperties.AutomationId="Detail.OcrFailure"
                       FontSize="{DynamicResource Type.Size.Caption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Surface.OnParchment}"
                       TextWrapping="Wrap" />

            <!-- Reading history -->
            <StackPanel Spacing="5" IsVisible="{Binding CanLoadReadingHistory}">
              <TextBlock Text="{Binding ReadingHistoryLabel}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <Button HorizontalAlignment="Left"
                      IsVisible="{Binding ShowLoadReadingHistoryButton}"
                      IsEnabled="{Binding CanLoadReadingHistory}"
                      AutomationProperties.Name="{Binding LoadReadingHistoryLabel}"
                      Click="LoadReadingHistoryButton_Click">
                <TextBlock Text="{Binding LoadReadingHistoryLabel}" />
              </Button>
              <TextBlock Text="{Binding ReadingHistoryLoadingText}"
                         IsVisible="{Binding IsLoadingHistory}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
              <ItemsControl ItemsSource="{Binding ReadingHistoryRows}"
                            IsVisible="{Binding IsReadingHistoryLoaded}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                               TextWrapping="Wrap"
                               Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding ReadingHistoryEmptyText}"
                         IsVisible="{Binding HasNoReadingHistory}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
              <TextBlock Text="{Binding ReadingHistoryStatusText}"
                         IsVisible="{Binding HasReadingHistoryStatus}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <!-- Enrichment and provider attribution -->
            <StackPanel Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="{Binding EnrichmentHeadingText}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <StackPanel Spacing="3" IsVisible="{Binding HasProviderAttributionLinks}">
                <TextBlock Text="{Binding ProviderAttributionHeadingText}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                <ItemsControl ItemsSource="{Binding ProviderAttributionLinks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProviderAttributionLink">
                      <Button Classes="tool" HorizontalAlignment="Left"
                              Padding="4,2"
                              BorderThickness="0"
                              AutomationProperties.Name="{Binding AccessibleName}"
                              Click="OpenProviderAttributionButton_Click">
                        <TextBlock Text="{Binding ProviderName}"
                                   TextDecorations="Underline"
                                   FontSize="{DynamicResource Type.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Accent.Slate}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ProviderLookupDisplayRows}"
                            IsVisible="{Binding HasProviderLookupStatus}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                               TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding EnrichmentFieldDisplayRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                               TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Metadata proposals -->
            <StackPanel Spacing="5"
                        Margin="0,8,0,0"
                        IsVisible="{Binding CanReviewMetadata}">
              <TextBlock Text="{Binding MetadataReviewLabel}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <ItemsControl ItemsSource="{Binding PendingMetadataProposals}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface.Footer}"
                            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,2">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding FieldName}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                        <TextBlock Text="{Binding ProposedValueLabel}"
                                   FontSize="{DynamicResource Type.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                        <TextBox Text="{Binding EditableValue, Mode=TwoWay}"
                                 AutomationProperties.Name="{Binding FieldName}" />
                        <TextBlock Text="{Binding CurrentValue}"
                                   ToolTip.Tip="{Binding CurrentValueLabel}"
                                   FontSize="{DynamicResource Type.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                          <Run Text="{Binding SourceLabel}" />
                          <Run Text=": " />
                          <Run Text="{Binding Source}" />
                          <Run Text=" · " />
                          <Run Text="{Binding ConfidenceLabel}" />
                          <Run Text=": " />
                          <Run Text="{Binding Confidence}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Button AutomationProperties.Name="{Binding AcceptLabel}"
                                  Click="AcceptMetadataProposalButton_Click">
                            <TextBlock Text="{Binding AcceptLabel}" />
                          </Button>
                          <Button AutomationProperties.Name="{Binding RejectLabel}"
                                  Click="RejectMetadataProposalButton_Click">
                            <TextBlock Text="{Binding RejectLabel}" />
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding MetadataReviewStatusText}"
                         IsVisible="{Binding HasMetadataReviewStatus}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <!-- Provenance (lazy) -->
            <StackPanel Spacing="5" Margin="0,8,0,0">
              <Button HorizontalAlignment="Left"
                      IsVisible="{Binding ShowLoadProvenanceButton}"
                      AutomationProperties.Name="{Binding LoadProvenanceLabel}"
                      Click="LoadProvenanceButton_Click">
                <TextBlock Text="{Binding LoadProvenanceLabel}" />
              </Button>
              <ItemsControl ItemsSource="{Binding ProvenanceRows}"
                            IsVisible="{Binding IsProvenanceLoaded}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                               TextWrapping="Wrap"
                               Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- AI card: content arrives with Phase 16 (D-50) -->
            <Border Background="{DynamicResource Brush.Surface.Footer}"
                    BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.S}"
                    Padding="8"
                    Margin="0,8,0,0"
                    AutomationProperties.AutomationId="Detail.AiCard">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding AiCardText}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <TextBlock Text="{Binding AiHeadingText}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Accent.Plum}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Border>
</UserControl>
