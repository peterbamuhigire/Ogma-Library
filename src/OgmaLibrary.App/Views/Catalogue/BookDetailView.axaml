<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Catalogue"
             xmlns:cat="using:OgmaLibrary.App.Views.Catalogue"
             x:Class="OgmaLibrary.App.Views.Catalogue.BookDetailView"
             x:DataType="vm:BookDetailViewModel"
             IsVisible="{Binding IsVisible}">

  <!--
    Book-detail panel (FR-CAT-004). Slides in from the right.
    Seven tab groups: File, Bibliographic, Reading, Enrichment, AI, TOC, Provenance.
    "Read" button routes through IReaderNavigationService.
    "Enrich" runs deterministic no-AI metadata provider lookup.
    "Run OCR" queues scanned PDFs for searchable text extraction.
  -->

  <Border Background="{DynamicResource Brush.Surface.Card}"
          BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
          BorderThickness="1,0,0,0"
          Width="320">

    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Header: title + close button -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,12,8">
        <TextBlock Grid.Column="0"
                   Text="{Binding Title}"
                   FontSize="{DynamicResource Type.Size.Subtitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Background="Transparent"
                BorderThickness="0"
                Padding="6"
                VerticalAlignment="Center"
                AutomationProperties.Name="Close book detail"
                Click="CloseButton_Click">
          <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
        </Button>
      </Grid>

      <!-- Scrollable detail area -->
      <ScrollViewer Grid.Row="1" Margin="0,0,0,0">
        <StackPanel Spacing="0" Margin="16,0,16,16">

          <!-- Cover placeholder -->
          <cat:CoverImageView Height="180"
                              Margin="0,0,0,16"
                              RelativePath="{Binding Book.CoverRelativePath}"
                              RootPath="{Binding AssetRootPath}"
                              Label="{Binding Title}" />

          <!-- Authors -->
          <TextBlock Text="{Binding AuthorsDisplay}"
                     FontSize="{DynamicResource Type.Size.Body}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,4" />

          <!-- Year -->
          <TextBlock Text="{Binding Year}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     Margin="0,0,0,16" />

          <!-- Tab control for 5 field groups -->
          <TabControl>

            <!-- Group 1: File -->
            <TabItem Header="{Binding FileTabText}">
              <StackPanel Spacing="6" Margin="0,8,0,0">
                <TextBlock Text="{Binding RelativePath}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}"
                           TextWrapping="Wrap" />
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Size: {0} bytes">
                      <Binding Path="SizeBytes" FallbackValue="Unknown" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                           TextWrapping="Wrap"
                           Text="{Binding Sha256Hash}" />
                <TextBlock Text="{Binding FileAvailabilityText}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <Button HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        IsVisible="{Binding CanPrepareWriteBack}"
                        IsEnabled="{Binding CanPrepareWriteBack}"
                        AutomationProperties.Name="{Binding PrepareWriteBackLabel}"
                        Click="PrepareWriteBackButton_Click">
                  <TextBlock Text="{Binding PrepareWriteBackLabel}" />
                </Button>
                <StackPanel Spacing="5"
                            Margin="0,8,0,0"
                            IsVisible="{Binding HasPreparedWriteBack}">
                  <TextBlock Text="{Binding WriteBackHeadingText}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                  <ItemsControl ItemsSource="{Binding WriteBackDiffRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="{DynamicResource Type.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5">
                    <Button IsEnabled="{Binding CanConfirmWriteBack}"
                            AutomationProperties.Name="{Binding ConfirmWriteBackLabel}"
                            Click="ConfirmWriteBackButton_Click">
                      <TextBlock Text="{Binding ConfirmWriteBackLabel}" />
                    </Button>
                    <Button IsEnabled="{Binding CanRestoreWriteBack}"
                            AutomationProperties.Name="{Binding RestoreWriteBackLabel}"
                            Click="RestoreWriteBackButton_Click">
                      <TextBlock Text="{Binding RestoreWriteBackLabel}" />
                    </Button>
                    <Button IsEnabled="{Binding CanRestoreWriteBack}"
                            AutomationProperties.Name="{Binding CancelWriteBackLabel}"
                            Click="CancelWriteBackButton_Click">
                      <TextBlock Text="{Binding CancelWriteBackLabel}" />
                    </Button>
                  </WrapPanel>
                </StackPanel>
                <TextBlock Text="{Binding WriteBackStatusText}"
                           IsVisible="{Binding HasWriteBackStatus}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </TabItem>

            <!-- Group 2: Bibliographic -->
            <TabItem Header="{Binding BiblioTabText}">
              <StackPanel Spacing="6" Margin="0,8,0,0">
                <StackPanel Spacing="5"
                            IsVisible="{Binding CanUpdateCuration}">
                  <TextBlock Text="{Binding CurationStatusLabel}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                  <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                    <Button Tag="Unread"
                            Click="CurationStatusButton_Click"
                            AutomationProperties.Name="{Binding CurationUnreadText}">
                      <TextBlock Text="{Binding CurationUnreadText}" />
                    </Button>
                    <Button Tag="Reading"
                            Click="CurationStatusButton_Click"
                            AutomationProperties.Name="{Binding CurationReadingText}">
                      <TextBlock Text="{Binding CurationReadingText}" />
                    </Button>
                    <Button Tag="Finished"
                            Click="CurationStatusButton_Click"
                            AutomationProperties.Name="{Binding CurationFinishedText}">
                      <TextBlock Text="{Binding CurationFinishedText}" />
                    </Button>
                    <Button Tag="Abandoned"
                            Click="CurationStatusButton_Click"
                            AutomationProperties.Name="{Binding CurationAbandonedText}">
                      <TextBlock Text="{Binding CurationAbandonedText}" />
                    </Button>
                  </WrapPanel>
                  <TextBlock Text="{Binding CurationRatingLabel}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                  <WrapPanel Orientation="Horizontal" ItemSpacing="4">
                    <Button Tag="1" Click="RatingButton_Click" AutomationProperties.Name="1 star"><TextBlock Text="1" /></Button>
                    <Button Tag="2" Click="RatingButton_Click" AutomationProperties.Name="2 stars"><TextBlock Text="2" /></Button>
                    <Button Tag="3" Click="RatingButton_Click" AutomationProperties.Name="3 stars"><TextBlock Text="3" /></Button>
                    <Button Tag="4" Click="RatingButton_Click" AutomationProperties.Name="4 stars"><TextBlock Text="4" /></Button>
                    <Button Tag="5" Click="RatingButton_Click" AutomationProperties.Name="5 stars"><TextBlock Text="5" /></Button>
                    <Button Click="FavouriteButton_Click"
                            AutomationProperties.Name="{Binding FavouriteButtonText}">
                      <TextBlock Text="{Binding FavouriteButtonText}" />
                    </Button>
                  </WrapPanel>
                  <TextBlock Text="{Binding CurationStatusText}"
                             IsVisible="{Binding HasCurationStatus}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="ISBN: {0}">
                      <Binding Path="Isbn" FallbackValue="—" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="DOI: {0}">
                      <Binding Path="Doi" FallbackValue="—" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding BiblioFieldDisplayRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 FontSize="{DynamicResource Type.Size.Caption}"
                                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="5"
                            Margin="0,8,0,0"
                            IsVisible="{Binding CanEditTags}">
                  <TextBlock Text="{Binding TagsLabel}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                  <TextBox Text="{Binding TagsText, Mode=TwoWay}"
                           Watermark="tag, another tag"
                           AutomationProperties.Name="{Binding TagsLabel}" />
                  <Button HorizontalAlignment="Left"
                          IsEnabled="{Binding CanEditTags}"
                          AutomationProperties.Name="{Binding SaveTagsLabel}"
                          Click="SaveTagsButton_Click">
                    <TextBlock Text="{Binding SaveTagsLabel}" />
                  </Button>
                  <TextBlock Text="{Binding TagsStatusText}"
                             IsVisible="{Binding HasTagsStatus}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="5"
                            Margin="0,12,0,0"
                            IsVisible="{Binding CanReviewMetadata}">
                  <TextBlock Text="{Binding MetadataReviewLabel}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                  <ItemsControl ItemsSource="{Binding PendingMetadataProposals}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource Brush.Surface.Footer}"
                                BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
                                BorderThickness="1"
                                Padding="8"
                                Margin="0,2">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding FieldName}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                            <TextBlock Text="{Binding ProposedValueLabel}"
                                       FontSize="{DynamicResource Type.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                            <TextBox Text="{Binding EditableValue, Mode=TwoWay}"
                                     AutomationProperties.Name="{Binding FieldName}" />
                            <TextBlock Text="{Binding CurrentValue}"
                                       ToolTip.Tip="{Binding CurrentValueLabel}"
                                       FontSize="{DynamicResource Type.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                                       TextWrapping="Wrap" />
                            <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                              <Run Text="{Binding SourceLabel}" />
                              <Run Text=": " />
                              <Run Text="{Binding Source}" />
                              <Run Text=" · " />
                              <Run Text="{Binding ConfidenceLabel}" />
                              <Run Text=": " />
                              <Run Text="{Binding Confidence}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <Button AutomationProperties.Name="{Binding AcceptLabel}"
                                      Click="AcceptMetadataProposalButton_Click">
                                <TextBlock Text="{Binding AcceptLabel}" />
                              </Button>
                              <Button AutomationProperties.Name="{Binding RejectLabel}"
                                      Click="RejectMetadataProposalButton_Click">
                                <TextBlock Text="{Binding RejectLabel}" />
                              </Button>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding MetadataReviewStatusText}"
                             IsVisible="{Binding HasMetadataReviewStatus}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </TabItem>

            <!-- Group 3: Reading -->
            <TabItem Header="{Binding ReadingTabText}">
              <StackPanel Spacing="6" Margin="0,8,0,0">
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Rating: {0}/5">
                      <Binding Path="Rating" FallbackValue="Unrated" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Progress: {0:F0}%">
                      <Binding Path="ReadingProgressPct" FallbackValue="0" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Last read: {0}">
                      <Binding Path="LastReadDisplay" FallbackValue="Never" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Annotations: {0}">
                      <Binding Path="AnnotationCount" FallbackValue="0" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <StackPanel Spacing="4" Margin="0,8,0,0">
                  <TextBlock Text="{Binding ReadingMemorySummaryLabel}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                  <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0}: {1}">
                        <Binding Path="ReadingMemoryDispositionLabel" />
                        <Binding Path="ReadingMemoryDispositionDisplay" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0}: {1}">
                        <Binding Path="ReadingMemoryKeyInsightLabel" />
                        <Binding Path="ReadingMemoryKeyInsightExcerpt" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <StackPanel Spacing="5"
                              Margin="0,8,0,0"
                              IsVisible="{Binding CanEditReadingMemory}">
                    <TextBlock Text="{Binding ReadingMemoryOpenedBecauseLabel}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                    <TextBox Text="{Binding ReadingMemoryOpenedBecause}"
                             AcceptsReturn="True"
                             MinHeight="44"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding ReadingMemoryOpenedBecauseLabel}"
                             LostFocus="ReadingMemoryField_LostFocus" />
                    <TextBlock Text="{Binding ReadingMemoryKeyInsightLabel}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                    <TextBox Text="{Binding ReadingMemoryKeyInsight}"
                             AcceptsReturn="True"
                             MinHeight="44"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding ReadingMemoryKeyInsightLabel}"
                             LostFocus="ReadingMemoryField_LostFocus" />
                    <TextBlock Text="{Binding ReadingMemoryOpenQuestionsLabel}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                    <TextBox Text="{Binding ReadingMemoryOpenQuestions}"
                             AcceptsReturn="True"
                             MinHeight="44"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding ReadingMemoryOpenQuestionsLabel}"
                             LostFocus="ReadingMemoryField_LostFocus" />
                    <TextBlock Text="{Binding ReadingMemoryDispositionLabel}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                    <TextBox Text="{Binding ReadingMemoryDispositionText}"
                             AutomationProperties.Name="{Binding ReadingMemoryDispositionLabel}"
                             LostFocus="ReadingMemoryField_LostFocus" />
                    <Button HorizontalAlignment="Left"
                            Padding="10,4"
                            IsEnabled="{Binding CanSaveReadingMemory}"
                            AutomationProperties.Name="{Binding ReadingMemorySaveLabel}"
                            Click="SaveReadingMemoryButton_Click">
                      <TextBlock Text="{Binding ReadingMemorySaveLabel}" />
                    </Button>
                    <TextBlock Text="{Binding ReadingMemoryStatusText}"
                               IsVisible="{Binding HasReadingMemoryStatus}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Spacing="5"
                            Margin="0,12,0,0"
                            IsVisible="{Binding CanLoadReadingHistory}">
                  <TextBlock Text="{Binding ReadingHistoryLabel}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                  <Button HorizontalAlignment="Left"
                          IsVisible="{Binding ShowLoadReadingHistoryButton}"
                          IsEnabled="{Binding CanLoadReadingHistory}"
                          AutomationProperties.Name="{Binding LoadReadingHistoryLabel}"
                          Click="LoadReadingHistoryButton_Click">
                    <TextBlock Text="{Binding LoadReadingHistoryLabel}" />
                  </Button>
                  <TextBlock Text="{Binding ReadingHistoryLoadingText}"
                             IsVisible="{Binding IsLoadingHistory}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                  <ItemsControl ItemsSource="{Binding ReadingHistoryRows}"
                                IsVisible="{Binding IsReadingHistoryLoaded}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="{DynamicResource Type.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,1" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding ReadingHistoryEmptyText}"
                             IsVisible="{Binding HasNoReadingHistory}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                  <TextBlock Text="{Binding ReadingHistoryStatusText}"
                             IsVisible="{Binding HasReadingHistoryStatus}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </TabItem>

            <!-- Group 4: Enrichment -->
            <TabItem Header="{Binding EnrichmentTabText}">
              <StackPanel Spacing="4" Margin="0,8,0,0">
                <TextBlock Text="{Binding EnrichmentHeadingText}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                <ItemsControl ItemsSource="{Binding EnrichmentFieldDisplayRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 FontSize="{DynamicResource Type.Size.Caption}"
                                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </TabItem>

            <!-- Group 5: AI -->
            <TabItem Header="{Binding AiTabText}">
              <StackPanel Spacing="4" Margin="0,8,0,0">
                <TextBlock Text="{Binding AiHeadingText}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Accent.Plum}" />
                <ItemsControl ItemsSource="{Binding AiFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </TabItem>

            <!-- Group 6: Lazy table of contents -->
            <TabItem Header="{Binding TocTabText}">
              <StackPanel Spacing="5" Margin="0,8,0,0">
                <Button HorizontalAlignment="Left"
                        IsVisible="{Binding ShowLoadTocButton}"
                        IsEnabled="{Binding CanLoadToc}"
                        AutomationProperties.Name="{Binding LoadTocLabel}"
                        Click="LoadTocButton_Click">
                  <TextBlock Text="{Binding LoadTocLabel}" />
                </Button>
                <TextBlock Text="{Binding TocLoadingText}"
                           IsVisible="{Binding IsLoadingToc}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                <ItemsControl ItemsSource="{Binding TocRows}"
                              IsVisible="{Binding IsTocLoaded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 FontSize="{DynamicResource Type.Size.Caption}"
                                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                                 TextWrapping="Wrap"
                                 Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding TocEmptyText}"
                           IsVisible="{Binding HasNoToc}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </TabItem>

            <!-- Group 7: Lazy provenance -->
            <TabItem Header="{Binding ProvenanceTabText}">
              <StackPanel Spacing="5" Margin="0,8,0,0">
                <Button HorizontalAlignment="Left"
                        IsVisible="{Binding ShowLoadProvenanceButton}"
                        AutomationProperties.Name="{Binding LoadProvenanceLabel}"
                        Click="LoadProvenanceButton_Click">
                  <TextBlock Text="{Binding LoadProvenanceLabel}" />
                </Button>
                <ItemsControl ItemsSource="{Binding ProvenanceRows}"
                              IsVisible="{Binding IsProvenanceLoaded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 FontSize="{DynamicResource Type.Size.Caption}"
                                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                                 TextWrapping="Wrap"
                                 Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </TabItem>

          </TabControl>

          <TextBlock Text="{Binding EnrichmentStatusText}"
                     IsVisible="{Binding HasEnrichmentStatus}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap"
                     Margin="0,12,0,0" />

          <TextBlock Text="{Binding OcrStatusText}"
                     IsVisible="{Binding HasOcrStatus}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0" />

          <Button Padding="10,6"
                  Margin="0,10,0,0"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource Brush.Accent.Clay}"
                  Foreground="White"
                  CornerRadius="{DynamicResource Radius.S}"
                  IsVisible="{Binding IsPasswordProtected}"
                  IsEnabled="{Binding CanForgetPassword}"
                  AutomationProperties.Name="{Binding ForgetPasswordText}"
                  ToolTip.Tip="{Binding ForgetPasswordTooltip}"
                  Click="ForgetPasswordButton_Click">
            <TextBlock Text="{Binding ForgetPasswordText}" />
          </Button>

          <TextBlock Text="{Binding PasswordStatusText}"
                     IsVisible="{Binding HasPasswordStatus}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0" />

        </StackPanel>
      </ScrollViewer>

      <!-- Action buttons -->
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  Margin="16,8,16,16"
                  HorizontalAlignment="Center">

        <!-- Read button -->
        <Button Padding="16,8"
                Background="{DynamicResource Brush.Accent.Ink}"
                Foreground="White"
                CornerRadius="{DynamicResource Radius.S}"
                IsEnabled="{Binding CanOpenReader}"
                AutomationProperties.Name="Open reader"
                Click="ReadButton_Click">
            <TextBlock Text="{Binding ReadText}" />
        </Button>

        <!-- Enrich button -->
        <Button Padding="16,8"
                Background="{DynamicResource Brush.Accent.Plum}"
                Foreground="White"
                CornerRadius="{DynamicResource Radius.S}"
                IsEnabled="{Binding CanEnrich}"
                AutomationProperties.Name="Enrich metadata"
                ToolTip.Tip="{Binding EnrichTooltip}"
                Click="EnrichButton_Click">
          <TextBlock Text="{Binding EnrichText}" />
        </Button>

        <!-- OCR button -->
        <Button Padding="12,8"
                Background="{DynamicResource Brush.Accent.Sage}"
                Foreground="White"
                CornerRadius="{DynamicResource Radius.S}"
                IsEnabled="{Binding CanRunOcr}"
                AutomationProperties.Name="{Binding RunOcrText}"
                ToolTip.Tip="{Binding RunOcrTooltip}"
                Click="RunOcrButton_Click">
          <TextBlock Text="{Binding RunOcrText}" />
        </Button>

      </StackPanel>

    </Grid>
  </Border>
</UserControl>
