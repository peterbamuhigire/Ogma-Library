<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Catalogue"
             x:Class="OgmaLibrary.App.Views.Catalogue.BookDetailView"
             x:DataType="vm:BookDetailViewModel"
             IsVisible="{Binding IsVisible}">

  <!--
    Book-detail panel (FR-CAT-004). Slides in from the right.
    Five tab groups: File, Bibliographic, Reading, Enrichment, AI.
    "Read" button routes through IReaderNavigationService.
    "Enrich" runs deterministic no-AI metadata provider lookup.
    "Run OCR" queues scanned PDFs for searchable text extraction.
  -->

  <Border Background="{DynamicResource Brush.Surface.Card}"
          BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
          BorderThickness="1,0,0,0"
          Width="320">

    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Header: title + close button -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,12,8">
        <TextBlock Grid.Column="0"
                   Text="{Binding Title}"
                   FontSize="{DynamicResource Type.Size.Subtitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Background="Transparent"
                BorderThickness="0"
                Padding="6"
                VerticalAlignment="Center"
                AutomationProperties.Name="Close book detail"
                Click="CloseButton_Click">
          <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
        </Button>
      </Grid>

      <!-- Scrollable detail area -->
      <ScrollViewer Grid.Row="1" Margin="0,0,0,0">
        <StackPanel Spacing="0" Margin="16,0,16,16">

          <!-- Cover placeholder -->
          <Border Height="180"
                  CornerRadius="{DynamicResource Radius.S}"
                  Background="{DynamicResource Brush.Accent.Ink}"
                  Margin="0,0,0,16"
                  ClipToBounds="True">
            <TextBlock Text="{Binding Title}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="260"
                       Foreground="White"
                       FontSize="{DynamicResource Type.Size.Body}"
                       FontWeight="SemiBold"
                       Margin="12" />
          </Border>

          <!-- Authors -->
          <TextBlock Text="{Binding AuthorsDisplay}"
                     FontSize="{DynamicResource Type.Size.Body}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,4" />

          <!-- Year -->
          <TextBlock Text="{Binding Year}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     Margin="0,0,0,16" />

          <!-- Tab control for 5 field groups -->
          <TabControl>

            <!-- Group 1: File -->
            <TabItem Header="File">
              <StackPanel Spacing="6" Margin="0,8,0,0">
                <TextBlock Text="{Binding RelativePath}"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}"
                           TextWrapping="Wrap" />
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Size: {0} bytes">
                      <Binding Path="SizeBytes" FallbackValue="Unknown" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                           TextWrapping="Wrap"
                           Text="{Binding Sha256Hash}" />
              </StackPanel>
            </TabItem>

            <!-- Group 2: Bibliographic -->
            <TabItem Header="Biblio">
              <StackPanel Spacing="6" Margin="0,8,0,0">
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="ISBN: {0}">
                      <Binding Path="Isbn" FallbackValue="—" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="DOI: {0}">
                      <Binding Path="Doi" FallbackValue="—" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding BiblioFieldDisplayRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 FontSize="{DynamicResource Type.Size.Caption}"
                                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </TabItem>

            <!-- Group 3: Reading -->
            <TabItem Header="Reading">
              <StackPanel Spacing="6" Margin="0,8,0,0">
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Rating: {0}/5">
                      <Binding Path="Rating" FallbackValue="Unrated" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Progress: {0:F0}%">
                      <Binding Path="ReadingProgressPct" FallbackValue="0" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Last read: {0}">
                      <Binding Path="LastReadDisplay" FallbackValue="Never" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Annotations: {0}">
                      <Binding Path="AnnotationCount" FallbackValue="0" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <StackPanel Spacing="4" Margin="0,8,0,0">
                  <TextBlock Text="{Binding ReadingMemorySummaryLabel}"
                             FontSize="{DynamicResource Type.Size.Caption}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                  <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0}: {1}">
                        <Binding Path="ReadingMemoryDispositionLabel" />
                        <Binding Path="ReadingMemoryDispositionDisplay" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0}: {1}">
                        <Binding Path="ReadingMemoryKeyInsightLabel" />
                        <Binding Path="ReadingMemoryKeyInsightExcerpt" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <StackPanel Spacing="5"
                              Margin="0,8,0,0"
                              IsVisible="{Binding CanEditReadingMemory}">
                    <TextBlock Text="{Binding ReadingMemoryOpenedBecauseLabel}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                    <TextBox Text="{Binding ReadingMemoryOpenedBecause}"
                             AcceptsReturn="True"
                             MinHeight="44"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding ReadingMemoryOpenedBecauseLabel}"
                             LostFocus="ReadingMemoryField_LostFocus" />
                    <TextBlock Text="{Binding ReadingMemoryKeyInsightLabel}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                    <TextBox Text="{Binding ReadingMemoryKeyInsight}"
                             AcceptsReturn="True"
                             MinHeight="44"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding ReadingMemoryKeyInsightLabel}"
                             LostFocus="ReadingMemoryField_LostFocus" />
                    <TextBlock Text="{Binding ReadingMemoryOpenQuestionsLabel}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                    <TextBox Text="{Binding ReadingMemoryOpenQuestions}"
                             AcceptsReturn="True"
                             MinHeight="44"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding ReadingMemoryOpenQuestionsLabel}"
                             LostFocus="ReadingMemoryField_LostFocus" />
                    <TextBlock Text="{Binding ReadingMemoryDispositionLabel}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                    <TextBox Text="{Binding ReadingMemoryDispositionText}"
                             AutomationProperties.Name="{Binding ReadingMemoryDispositionLabel}"
                             LostFocus="ReadingMemoryField_LostFocus" />
                    <Button HorizontalAlignment="Left"
                            Padding="10,4"
                            IsEnabled="{Binding CanSaveReadingMemory}"
                            AutomationProperties.Name="{Binding ReadingMemorySaveLabel}"
                            Click="SaveReadingMemoryButton_Click">
                      <TextBlock Text="{Binding ReadingMemorySaveLabel}" />
                    </Button>
                    <TextBlock Text="{Binding ReadingMemoryStatusText}"
                               IsVisible="{Binding HasReadingMemoryStatus}"
                               FontSize="{DynamicResource Type.Size.Caption}"
                               Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </TabItem>

            <!-- Group 4: Enrichment -->
            <TabItem Header="Enrichment">
              <StackPanel Spacing="4" Margin="0,8,0,0">
                <TextBlock Text="Enrichment data (Phase 07)"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                <ItemsControl ItemsSource="{Binding EnrichmentFieldDisplayRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 FontSize="{DynamicResource Type.Size.Caption}"
                                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </TabItem>

            <!-- Group 5: AI -->
            <TabItem Header="AI">
              <StackPanel Spacing="4" Margin="0,8,0,0">
                <TextBlock Text="AI insights (Phase 13)"
                           FontSize="{DynamicResource Type.Size.Caption}"
                           Foreground="{DynamicResource Brush.Accent.Plum}" />
                <ItemsControl ItemsSource="{Binding AiFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock FontSize="{DynamicResource Type.Size.Caption}"
                                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </TabItem>

          </TabControl>

          <TextBlock Text="{Binding EnrichmentStatusText}"
                     IsVisible="{Binding HasEnrichmentStatus}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap"
                     Margin="0,12,0,0" />

          <TextBlock Text="{Binding OcrStatusText}"
                     IsVisible="{Binding HasOcrStatus}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0" />

        </StackPanel>
      </ScrollViewer>

      <!-- Action buttons -->
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  Margin="16,8,16,16"
                  HorizontalAlignment="Center">

        <!-- Read button -->
        <Button Padding="16,8"
                Background="{DynamicResource Brush.Accent.Ink}"
                Foreground="White"
                CornerRadius="{DynamicResource Radius.S}"
                AutomationProperties.Name="Open reader"
                Click="ReadButton_Click">
          <TextBlock Text="Read" />
        </Button>

        <!-- Enrich button -->
        <Button Padding="16,8"
                Background="{DynamicResource Brush.Accent.Plum}"
                Foreground="White"
                CornerRadius="{DynamicResource Radius.S}"
                IsEnabled="{Binding CanEnrich}"
                AutomationProperties.Name="Enrich metadata"
                ToolTip.Tip="{Binding EnrichTooltip}"
                Click="EnrichButton_Click">
          <TextBlock Text="{Binding EnrichText}" />
        </Button>

        <!-- OCR button -->
        <Button Padding="12,8"
                Background="{DynamicResource Brush.Accent.Sage}"
                Foreground="White"
                CornerRadius="{DynamicResource Radius.S}"
                IsEnabled="{Binding CanRunOcr}"
                AutomationProperties.Name="{Binding RunOcrText}"
                ToolTip.Tip="{Binding RunOcrTooltip}"
                Click="RunOcrButton_Click">
          <TextBlock Text="{Binding RunOcrText}" />
        </Button>

      </StackPanel>

    </Grid>
  </Border>
</UserControl>
