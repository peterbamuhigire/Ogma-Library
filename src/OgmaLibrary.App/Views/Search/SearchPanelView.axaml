<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Search"
             xmlns:local="using:OgmaLibrary.App.Views.Search"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="OgmaLibrary.App.Views.Search.SearchPanelView"
             x:DataType="vm:SearchViewModel"
             Focusable="True"
             KeyDown="SearchPanel_KeyDown">

  <Border Background="{DynamicResource Brush.Surface.Footer}"
          BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
          BorderThickness="0,0,0,1"
          Padding="12,10">
    <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="Auto,*,Auto,Auto">
      <svg:Svg Grid.Row="0"
               Grid.Column="0"
               Width="18"
               Height="18"
               Margin="0,0,8,0"
               VerticalAlignment="Center"
               Path="{Binding SearchIconPath}" />
      <TextBox x:Name="SearchBox"
               Grid.Row="0"
               Grid.Column="1"
               Text="{Binding Query, Mode=TwoWay}"
               Watermark="{Binding PlaceholderText}"
               AutomationProperties.AutomationId="Search.Box"
               AutomationProperties.Name="{Binding PlaceholderText}"
               KeyDown="SearchBox_KeyDown"
               MinWidth="260" />
      <!-- Sept-23 Phase 13 (K41): the mode is measured from the latest response. -->
      <Border Grid.Row="0"
              Grid.Column="2"
              Margin="8,0,0,0"
              Padding="8,4"
              Background="{DynamicResource Brush.Surface.Card}"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.S}"
              AutomationProperties.AutomationId="Search.Mode"
              AutomationProperties.Name="{Binding SearchModeText}"
              AutomationProperties.HelpText="{Binding SearchModeToolTip}"
              ToolTip.Tip="{Binding SearchModeToolTip}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <svg:Svg Width="12"
                   Height="12"
                   Path="{Binding SearchModeIconPath}" />
          <TextBlock Text="{Binding SearchModeText}"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
        </StackPanel>
      </Border>
      <Button Grid.Row="0"
              Grid.Column="3"
              Margin="8,0,0,0"
              Padding="10,5"
              Background="{DynamicResource Brush.Accent.Oak}"
              Foreground="{DynamicResource Brush.Accent.OnAccent}"
              CornerRadius="{DynamicResource Radius.S}"
              IsEnabled="{Binding CanOpenSelected}"
              AutomationProperties.AutomationId="Search.OpenSelected"
              AutomationProperties.Name="{Binding OpenSelectedLabel}"
              Click="OpenSelected_Click">
        <TextBlock Text="{Binding OpenSelectedLabel}"
                   FontSize="{DynamicResource Type.Size.Caption}" />
      </Button>

      <TextBlock Grid.Row="1"
                 Grid.ColumnSpan="4"
                 Margin="0,6,0,0"
                 Text="{Binding CoverageText}"
                 IsVisible="{Binding HasCoverage}"
                 FontSize="{DynamicResource Type.Size.Caption}"
                 AutomationProperties.AutomationId="Search.Coverage"
                 Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />

      <Grid Grid.Row="2" Grid.ColumnSpan="4" Margin="0,6,0,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="Search.Status"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
        <Button Grid.Column="1"
                Margin="8,0,0,0"
                Padding="10,4"
                IsVisible="{Binding HasError}"
                AutomationProperties.AutomationId="Search.Retry"
                AutomationProperties.Name="{Binding RetryLabel}"
                Click="Retry_Click">
          <TextBlock Text="{Binding RetryLabel}"
                     FontSize="{DynamicResource Type.Size.Caption}" />
        </Button>
      </Grid>

      <ListBox x:Name="SearchResults"
               AutomationProperties.AutomationId="Search.Results"
               Grid.Row="3"
               Grid.ColumnSpan="4"
               Margin="0,10,0,0"
               MaxHeight="220"
               ItemsSource="{Binding Results}"
               SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
               KeyDown="SearchResults_KeyDown"
               DoubleTapped="SearchResults_DoubleTapped"
               AutomationProperties.Name="{Binding StatusText}">
        <ListBox.Styles>
          <!-- Sept-23 K14: the container carries "Title, by Author, matched on page N". -->
          <Style Selector="ListBoxItem" x:DataType="vm:SearchResultItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SearchResultItem">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4"
                  AutomationProperties.Name="{Binding AutomationName}">
              <svg:Svg Grid.RowSpan="4"
                       Width="18"
                       Height="18"
                       Margin="0,2,8,0"
                       Path="{Binding IconPath}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Title}"
                         FontWeight="SemiBold"
                         FontSize="{DynamicResource Type.Size.Body}"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding Subtitle}"
                         IsVisible="{Binding HasSubtitle}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
              <TextBlock Grid.Row="2"
                         Grid.Column="1"
                         local:SnippetHighlight.Result="{Binding}"
                         IsVisible="{Binding HasSnippet}"
                         TextWrapping="Wrap"
                         MaxLines="2"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
              <ItemsControl Grid.Row="3"
                            Grid.Column="1"
                            ItemsSource="{Binding MatchBadges}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SearchResultBadge">
                    <Border Margin="0,4,6,0"
                            Padding="6,2"
                            Background="{DynamicResource Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Brush.Accent.Oak}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.S}"
                            AutomationProperties.Name="{Binding AutomationLabel}"
                            ToolTip.Tip="{Binding AutomationLabel}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <svg:Svg Width="12"
                                 Height="12"
                                 Path="{Binding IconPath}" />
                        <TextBlock Text="{Binding Label}"
                                   FontSize="{DynamicResource Type.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Accent.Oak}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
