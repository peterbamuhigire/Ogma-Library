<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Search"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="OgmaLibrary.App.Views.Search.SearchPanelView"
             x:DataType="vm:SearchViewModel"
             Focusable="True"
             KeyDown="SearchPanel_KeyDown">

  <Border Background="{DynamicResource Brush.Surface.Footer}"
          BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
          BorderThickness="0,0,0,1"
          Padding="12,10">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*,Auto,Auto">
      <svg:Svg Grid.Row="0"
               Grid.Column="0"
               Width="18"
               Height="18"
               Margin="0,0,8,0"
               VerticalAlignment="Center"
               Path="{Binding SearchIconPath}" />
      <TextBox x:Name="SearchBox"
               Grid.Row="0"
               Grid.Column="1"
               Text="{Binding Query, Mode=TwoWay}"
               Watermark="{Binding PlaceholderText}"
               AutomationProperties.Name="{Binding PlaceholderText}"
               MinWidth="260" />
      <Border Grid.Row="0"
              Grid.Column="2"
              Margin="8,0,0,0"
              Padding="8,4"
              Background="{DynamicResource Brush.Surface.Card}"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.S}"
              AutomationProperties.Name="{Binding SearchModeText}">
        <TextBlock Text="{Binding SearchModeText}"
                   FontSize="{DynamicResource Type.Size.Caption}"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}" />
      </Border>
      <Button Grid.Row="0"
              Grid.Column="3"
              Margin="8,0,0,0"
              Padding="10,5"
              Background="{DynamicResource Brush.Accent.Oak}"
              Foreground="White"
              CornerRadius="{DynamicResource Radius.S}"
              IsEnabled="{Binding CanOpenSelected}"
              AutomationProperties.Name="{Binding OpenSelectedLabel}"
              Click="OpenSelected_Click">
        <TextBlock Text="{Binding OpenSelectedLabel}"
                   FontSize="{DynamicResource Type.Size.Caption}" />
      </Button>

      <ListBox x:Name="SearchResults"
               Grid.Row="1"
               Grid.ColumnSpan="4"
               Margin="0,10,0,0"
               MaxHeight="220"
               ItemsSource="{Binding Results}"
               SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
               AutomationProperties.Name="{Binding StatusText}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SearchResultItem">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4">
              <svg:Svg Grid.RowSpan="4"
                       Width="18"
                       Height="18"
                       Margin="0,2,8,0"
                       Path="{Binding IconPath}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Title}"
                         FontWeight="SemiBold"
                         FontSize="{DynamicResource Type.Size.Body}"
                         Foreground="{DynamicResource Brush.Surface.OnParchment}" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding Subtitle}"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
              <TextBlock Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding Snippet}"
                         TextWrapping="Wrap"
                         MaxLines="2"
                         FontSize="{DynamicResource Type.Size.Caption}"
                         Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
              <ItemsControl Grid.Row="3"
                            Grid.Column="1"
                            ItemsSource="{Binding MatchBadges}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SearchResultBadge">
                    <Border Margin="0,4,6,0"
                            Padding="6,2"
                            Background="{DynamicResource Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Brush.Accent.Oak}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.S}"
                            Focusable="True"
                            AutomationProperties.Name="{Binding AutomationLabel}">
                      <TextBlock Text="{Binding Label}"
                                 FontSize="{DynamicResource Type.Size.Caption}"
                                 Foreground="{DynamicResource Brush.Accent.Oak}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
