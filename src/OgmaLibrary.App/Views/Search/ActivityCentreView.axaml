<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Search"
             xmlns:cvm="using:OgmaLibrary.App.ViewModels.Catalogue"
             x:Class="OgmaLibrary.App.Views.Search.ActivityCentreView"
             x:DataType="vm:ActivityCentreViewModel">
  <Border Padding="10"
          Background="{DynamicResource Brush.Surface.Card}"
          BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Radius.S}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="{Binding Title}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}" />
        <Button Grid.Column="1"
                Margin="8,0,0,0"
                Padding="8,4"
                IsEnabled="{Binding CanAct}"
                AutomationProperties.Name="{Binding RefreshLabel}"
                Click="Refresh_Click">
          <TextBlock Text="{Binding RefreshLabel}" />
        </Button>
        <Button Grid.Column="2"
                Margin="6,0,0,0"
                Padding="8,4"
                IsEnabled="{Binding CanAct}"
                AutomationProperties.Name="{Binding ExportLabel}"
                Click="Export_Click">
          <TextBlock Text="{Binding ExportLabel}" />
        </Button>
        <Button Grid.Column="3"
                Margin="6,0,0,0"
                Padding="8,4"
                IsVisible="{Binding HasFailedJobs}"
                IsEnabled="{Binding CanAct}"
                AutomationProperties.Name="{Binding RetryAllLabel}"
                Click="RetryAll_Click">
          <TextBlock Text="{Binding RetryAllLabel}" />
        </Button>
      </Grid>

      <UniformGrid Grid.Row="1" Columns="2" Margin="0,8,0,0">
        <TextBlock Text="{Binding QueueSummary}" />
        <TextBlock Text="{Binding FailureSummary}" />
      </UniformGrid>

      <StackPanel Grid.Row="2">
      <!-- Sept-23 Phase 14 (task 14.7, K141): books waiting for smart search, with a route to Settings. -->
      <Border Margin="0,8,0,0"
              Padding="8,6"
              IsVisible="{Binding HasSemanticWaiting}"
              Background="{DynamicResource Brush.Surface.Parchment}"
              BorderBrush="{DynamicResource Brush.Accent.Slate}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.S}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding SemanticWaitingText}"
                     AutomationProperties.AutomationId="Activity.Search.Waiting"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          <Button Grid.Column="1"
                  Margin="8,0,0,0"
                  Padding="8,4"
                  AutomationProperties.AutomationId="Activity.Search.OpenSettings"
                  AutomationProperties.Name="{Binding OpenSearchSettingsLabel}"
                  Click="OpenSearchSettings_Click">
            <TextBlock Text="{Binding OpenSearchSettingsLabel}" />
          </Button>
        </Grid>
      </Border>

      <!-- Sept-23 Phase 17: suggestion banner for scanned books that cannot be searched yet. -->
      <Border Margin="0,8,0,0"
              Padding="8,6"
              IsVisible="{Binding HasOcrSuggestion}"
              Background="{DynamicResource Brush.Surface.Parchment}"
              BorderBrush="{DynamicResource Brush.Accent.Slate}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.S}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding OcrSuggestionText}"
                     AutomationProperties.AutomationId="Activity.Ocr.Suggestion"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          <Button Grid.Column="1"
                  Margin="8,0,0,0"
                  Padding="8,4"
                  IsEnabled="{Binding CanAct}"
                  AutomationProperties.AutomationId="Activity.Ocr.MakeSearchable"
                  AutomationProperties.Name="{Binding MakeSearchableLabel}"
                  Click="MakeSearchable_Click">
            <TextBlock Text="{Binding MakeSearchableLabel}" />
          </Button>
        </Grid>
      </Border>
      </StackPanel>

      <ListBox Grid.Row="3"
               Margin="0,8,0,0"
               MaxHeight="160"
               IsVisible="{Binding HasJobs}"
               ItemsSource="{Binding Jobs}"
               AutomationProperties.Name="{Binding StatusText}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ActivityJobDisplayItem">
            <Grid ColumnDefinitions="2*,Auto,Auto,Auto,Auto" Margin="0,3">
              <TextBlock Text="{Binding JobType}" />
              <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding StateText}" />
              <TextBlock Grid.Column="2" Margin="8,0,0,0" Text="{Binding Attempt}" />
              <Button Grid.Column="3"
                      Margin="8,0,0,0"
                      Padding="6,2"
                      IsEnabled="{Binding CanRetry}"
                      AutomationProperties.Name="{Binding RetryLabel}"
                      Click="Retry_Click">
                <TextBlock Text="{Binding RetryLabel}" />
              </Button>
              <Button Grid.Column="4"
                      Margin="6,0,0,0"
                      Padding="6,2"
                      IsEnabled="{Binding CanCancel}"
                      AutomationProperties.Name="{Binding CancelLabel}"
                      Click="Cancel_Click">
                <TextBlock Text="{Binding CancelLabel}" />
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Sept-23 Phase 10, task 10.8: recent bulk edits. Undo is LIFO, so only the newest
           edit not yet undone has an enabled Undo. -->
      <StackPanel Grid.Row="4"
                  Margin="0,8,0,0"
                  Spacing="4"
                  IsVisible="{Binding Edits.HasItems, FallbackValue=False}"
                  AutomationProperties.AutomationId="ActivityCentre.Edits">
        <TextBlock Text="{Binding Edits.Title, FallbackValue=''}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Surface.OnParchment}" />
        <ItemsControl ItemsSource="{Binding Edits.Items, FallbackValue={x:Null}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="cvm:EditActivityItem">
              <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <TextBlock Text="{Binding Text}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Surface.OnParchment}" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="6,2"
                        IsVisible="{Binding !IsUndone}"
                        Command="{Binding UndoCommand}"
                        AutomationProperties.AutomationId="{Binding UndoAutomationId}"
                        AutomationProperties.Name="{Binding UndoText}">
                  <TextBlock Text="{Binding UndoText}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
