<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Search"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="OgmaLibrary.App.Views.Search.IndexManagerPanelView"
             x:DataType="vm:IndexManagerViewModel">

  <Border Background="{DynamicResource Brush.Surface.Footer}"
          BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
          BorderThickness="0,0,0,1"
          Padding="12,10">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <svg:Svg Width="18"
                   Height="18"
                   Path="{Binding IndexManagerIconPath}" />
          <TextBlock Text="{Binding PanelLabel}"
                     FontWeight="SemiBold"
                     FontSize="{DynamicResource Type.Size.Subtitle}"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
        </StackPanel>
        <Button Grid.Column="1"
                Margin="8,0,0,0"
                Padding="10,5"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Accent.Clay}"
                Foreground="{DynamicResource Brush.Surface.OnParchment}"
                CornerRadius="{DynamicResource Radius.S}"
                IsEnabled="{Binding CanEraseEmbeddings}"
                AutomationProperties.Name="{Binding EraseEmbeddingsLabel}"
                Click="EraseEmbeddings_Click">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <svg:Svg Width="14"
                     Height="14"
                     Path="{Binding EraseEmbeddingsIconPath}" />
            <TextBlock Text="{Binding EraseEmbeddingsLabel}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2"
                Margin="8,0,0,0"
                Padding="10,5"
                Background="{DynamicResource Brush.Accent.Clay}"
                Foreground="White"
                CornerRadius="{DynamicResource Radius.S}"
                IsEnabled="{Binding CanRebuild}"
                AutomationProperties.Name="{Binding RebuildLabel}"
                Click="Rebuild_Click">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <svg:Svg Width="14"
                     Height="14"
                     Path="{Binding RebuildIconPath}" />
            <TextBlock Text="{Binding RebuildLabel}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3"
                Margin="8,0,0,0"
                Padding="10,5"
                IsEnabled="{Binding CanCancelRebuild}"
                AutomationProperties.Name="{Binding CancelLabel}"
                Click="Cancel_Click">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <svg:Svg Width="14"
                     Height="14"
                     Path="{Binding CancelIconPath}" />
            <TextBlock Text="{Binding CancelLabel}"
                       FontSize="{DynamicResource Type.Size.Caption}" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Grid.Row="1"
              IsVisible="{Binding IsRebuildConfirmationOpen}"
              Margin="0,10,0,0"
              Padding="10"
              Background="{DynamicResource Brush.Surface.Card}"
              BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.S}">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="{Binding RebuildConfirmationText}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          <Button Grid.Column="1"
                  Margin="8,0,0,0"
                  Padding="10,5"
                  Background="{DynamicResource Brush.Accent.Clay}"
                  Foreground="White"
                  AutomationProperties.Name="{Binding ConfirmRebuildLabel}"
                  Click="ConfirmRebuild_Click">
            <TextBlock Text="{Binding ConfirmRebuildLabel}" />
          </Button>
          <Button Grid.Column="2"
                  Margin="8,0,0,0"
                  Padding="10,5"
                  AutomationProperties.Name="{Binding CancelLabel}"
                  Click="CancelConfirmation_Click">
            <TextBlock Text="{Binding CancelLabel}" />
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="2"
              IsVisible="{Binding IsEmbeddingErasureConfirmationOpen}"
              Margin="0,10,0,0"
              Padding="10"
              Background="{DynamicResource Brush.Surface.Card}"
              BorderBrush="{DynamicResource Brush.Accent.Clay}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.S}">
        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Text="{Binding EmbeddingErasureConfirmationText}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.Surface.OnParchment}" />
          <TextBlock Grid.Row="1"
                     Text="{Binding EmbeddingErasureCountdownText}"
                     Margin="0,6,0,0"
                     FontSize="{DynamicResource Type.Size.Caption}"
                     Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                     AutomationProperties.Name="{Binding EmbeddingErasureCountdownText}" />
          <Button Grid.Column="1"
                  Grid.RowSpan="2"
                  Margin="8,0,0,0"
                  Padding="10,5"
                  Background="{DynamicResource Brush.Accent.Clay}"
                  Foreground="White"
                  IsEnabled="{Binding CanConfirmEmbeddingErasure}"
                  AutomationProperties.Name="{Binding ConfirmEmbeddingErasureLabel}"
                  Click="ConfirmEmbeddingErasure_Click">
            <TextBlock Text="{Binding ConfirmEmbeddingErasureLabel}" />
          </Button>
          <Button Grid.Column="2"
                  Grid.RowSpan="2"
                  Margin="8,0,0,0"
                  Padding="10,5"
                  AutomationProperties.Name="{Binding CancelLabel}"
                  Click="CancelEmbeddingErasure_Click">
            <TextBlock Text="{Binding CancelLabel}" />
          </Button>
        </Grid>
      </Border>

      <ProgressBar x:Name="RebuildProgress"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Height="8"
                   IsVisible="{Binding IsRebuildProgressVisible}"
                   IsIndeterminate="{Binding IsRebuilding}"
                   AutomationProperties.Name="{Binding StatusText}" />

      <UniformGrid Grid.Row="4"
                   Columns="4"
                   Margin="0,10,0,0">
        <TextBlock Text="{Binding IndexedSummary}" />
        <TextBlock Text="{Binding FailedSummary}" />
        <TextBlock Text="{Binding PendingOcrSummary}" />
        <TextBlock Text="{Binding ChunkSummary}" />
      </UniformGrid>

      <UniformGrid Grid.Row="5"
                   Columns="3"
                   Margin="0,6,0,0">
        <TextBlock Text="{Binding FailedPagesSummary}" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <svg:Svg Width="14"
                   Height="14"
                   Path="{Binding SizeIconPath}" />
          <TextBlock Text="{Binding SizeSummary}" />
        </StackPanel>
        <TextBlock Text="{Binding IntegritySummary}" />
      </UniformGrid>

      <ListBox x:Name="OcrJobList"
               Grid.Row="6"
               Margin="0,8,0,0"
               MaxHeight="92"
               IsVisible="{Binding HasOcrJobs}"
               ItemsSource="{Binding OcrJobs}"
               AutomationProperties.Name="{Binding OcrJobsSummary}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="2*,Auto,Auto" Margin="0,3">
              <TextBlock Text="{Binding Title}" />
              <TextBlock Grid.Column="1"
                         Margin="8,0,0,0"
                         Text="{Binding StateText}" />
              <TextBlock Grid.Column="2"
                         Margin="8,0,0,0"
                         Text="{Binding ProgressText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="7"
            RowDefinitions="Auto,*"
            Margin="0,10,0,0">
        <ListBox IsVisible="{Binding HasErrors}"
                 MaxHeight="82"
                 ItemsSource="{Binding ErrorItems}"
                 AutomationProperties.Name="{Binding StatusText}" />

        <ListBox Grid.Row="1"
               Margin="0,10,0,0"
               MaxHeight="180"
               ItemsSource="{Binding Books}"
               AutomationProperties.Name="{Binding StatusText}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="2*,Auto,Auto,Auto" Margin="0,3">
                <TextBlock Text="{Binding Title}" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           Text="{Binding Status}" />
                <TextBlock Grid.Column="2"
                           Margin="8,0,0,0"
                           Text="{Binding SearchChunkCount}" />
                <TextBlock Grid.Column="3"
                           Margin="8,0,0,0"
                           Text="{Binding FailedPageCount}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Border>
</UserControl>
