<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Ai"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="OgmaLibrary.App.Views.Ai.ReadingPlanView"
             x:DataType="vm:ReadingPlanViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Margin="16">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <svg:Svg Width="22" Height="22" Path="{Binding IconPath}" />
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Text="{Binding Goal}"
               Watermark="{Binding GoalWatermark}"
               MinWidth="280" />
      <Button Grid.Column="1"
              IsEnabled="{Binding CanGenerate}"
              Content="{Binding GenerateLabel}"
              Click="Generate_Click" />
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PlanStepViewModel">
              <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="10"
                      Margin="0,0,0,8"
                      AutomationProperties.Name="{Binding AccessibleLabel}">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Rank}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding BookTitle}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2">
                      <TextBlock Text="{Binding DifficultyText}" FontSize="12" />
                    </Border>
                    <Button Grid.Column="3"
                            Content="{Binding $parent[UserControl].DataContext.OpenBookLabel}"
                            Click="OpenBook_Click" />
                  </Grid>
                  <TextBlock Grid.Row="1"
                             Text="{Binding Rationale}"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2"
                             Text="{Binding EstimatedReadingText}"
                             FontSize="12" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Checkpoints}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CheckpointViewModel">
              <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8"
                      Margin="0,0,0,6">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Spacing="4">
      <TextBlock Text="{Binding ErrorText}"
                 IsVisible="{Binding HasError}"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <TextBlock Text="{Binding StatusText}" />
    </StackPanel>
  </Grid>
</UserControl>
