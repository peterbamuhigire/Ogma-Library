<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OgmaLibrary.App.ViewModels.Ai"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="OgmaLibrary.App.Views.Ai.RecommendationPanelView"
             x:DataType="vm:RecommendationPanelViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12" Margin="16">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <svg:Svg Width="22" Height="22" Path="{Binding IconPath}" />
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBox Text="{Binding Query, Mode=TwoWay}"
               Watermark="{Binding QueryWatermark}"
               MinWidth="280"
               AutomationProperties.Name="{Binding QueryWatermark}" />
      <Button Grid.Column="1"
              IsEnabled="{Binding CanLoad}"
              Content="{Binding LoadLabel}"
              AutomationProperties.Name="{Binding LoadLabel}"
              Click="Load_Click" />
      <Button Grid.Column="2"
              IsEnabled="{Binding CanAsk}"
              Content="{Binding AskLabel}"
              AutomationProperties.Name="{Binding AskLabel}"
              Click="Ask_Click" />
    </Grid>

    <Border Grid.Row="2"
            IsVisible="{Binding HasInterpretedIntent}"
            Background="{DynamicResource Brush.Surface.Footer}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.S}"
            Padding="10">
      <TextBlock Text="{Binding InterpretedIntentText}"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Interpreted reading preferences" />
    </Border>

    <Border Grid.Row="3"
            IsVisible="{Binding HasAnswer}"
            Background="{DynamicResource Brush.Surface.Footer}"
            BorderBrush="{DynamicResource Brush.Surface.CardBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.S}"
            Padding="10"
            AutomationProperties.Name="{Binding AnswerTitle}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding AnswerTitle}"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding AnswerText}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding CitationLabel}"
                   IsVisible="{Binding HasAnswer}"
                   FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding AnswerCitations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AnswerCitationViewModel">
              <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="6"
                      Margin="0,0,0,4"
                      AutomationProperties.Name="{Binding AccessibleLabel}">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding CitationText}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding RelevantText}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding UncertaintyText}"
                             IsVisible="{Binding HasUncertainty}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border IsVisible="{Binding IsFeedbackAvailable}"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
          <StackPanel Spacing="6">
            <CheckBox IsChecked="{Binding FeedbackConsent, Mode=TwoWay}"
                      Content="{Binding FeedbackConsentLabel}"
                      AutomationProperties.Name="{Binding FeedbackConsentLabel}" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="1" Tag="1" Click="FeedbackRating_Click" AutomationProperties.Name="Rate answer 1 of 5" />
              <Button Content="2" Tag="2" Click="FeedbackRating_Click" AutomationProperties.Name="Rate answer 2 of 5" />
              <Button Content="3" Tag="3" Click="FeedbackRating_Click" AutomationProperties.Name="Rate answer 3 of 5" />
              <Button Content="4" Tag="4" Click="FeedbackRating_Click" AutomationProperties.Name="Rate answer 4 of 5" />
              <Button Content="5" Tag="5" Click="FeedbackRating_Click" AutomationProperties.Name="Rate answer 5 of 5" />
              <Button Content="{Binding FeedbackSubmitLabel}"
                      IsEnabled="{Binding CanSubmitFeedback}"
                      Click="SubmitFeedback_Click"
                      AutomationProperties.Name="{Binding FeedbackSubmitLabel}" />
            </StackPanel>
            <TextBlock Text="{Binding FeedbackStatusText}"
                       IsVisible="{Binding HasFeedbackStatus}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Recommendations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecommendationCardViewModel">
            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{Binding AccessibleLabel}">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding RankText}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding BookId}"
                             TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2"
                          BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                          BorderThickness="1"
                          CornerRadius="4"
                          Padding="6,2">
                    <TextBlock Text="{Binding ConfidenceText}" FontSize="12" />
                  </Border>
                  <Button Grid.Column="3"
                          Content="{Binding $parent[UserControl].DataContext.OpenBookLabel}"
                          AutomationProperties.Name="{Binding $parent[UserControl].DataContext.OpenBookLabel}"
                          Click="OpenBook_Click" />
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding ExplanationSummary}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="2"
                           Text="{Binding UncertaintyText}"
                           IsVisible="{Binding HasUncertainty}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Surface.OnParchmentMuted}"
                           AutomationProperties.Name="Evidence limitation" />
                <ToggleButton Grid.Row="3"
                              IsChecked="{Binding IsExplanationExpanded}"
                              Content="{Binding WhyLabel}" />
                <ItemsControl Grid.Row="4"
                              IsVisible="{Binding IsExplanationExpanded}"
                              ItemsSource="{Binding ProvenanceItems}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProvenanceChipViewModel">
                      <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                              BorderThickness="1"
                              CornerRadius="4"
                              Padding="6,2"
                              Margin="0,0,6,6">
                        <TextBlock Text="{Binding Text}" FontSize="12" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="5" Spacing="4">
      <TextBlock Text="{Binding ErrorText}"
                 IsVisible="{Binding HasError}"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <TextBlock Text="{Binding StatusText}" />
    </StackPanel>
  </Grid>
</UserControl>
