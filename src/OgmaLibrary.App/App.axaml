<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OgmaLibrary.App.App"
             RequestedThemeVariant="Light">

  <Application.Styles>
    <!--
      Sept-23 Phase 09 (K15): pin the Fluent accent to the Ogma palette so the OS accent colour
      (the "salmon" selection) never leaks into lists, toggles, checkboxes or sliders.
      Values mirror Color.Accent.Primary / Color.Surface.Base in Themes/Tokens.axaml (palettes
      cannot take resource references); Sept23Phase09DesignSystemTests guards the mirror.
    -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#A35C0A" RegionColor="#FBF5EA" />
        <ColorPaletteResources x:Key="Dark" Accent="#A35C0A" RegionColor="#121A2E" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://OgmaLibrary.App/Themes/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          Phase 03 design tokens (color, typography, spacing, motion).
          All UI code references these keys via DynamicResource.
          ThemeDictionaries inside Tokens.axaml swap automatically with
          RequestedThemeVariant (Light / Dark).
        -->
        <ResourceInclude Source="avares://OgmaLibrary.App/Themes/Tokens.axaml" />
        <!-- About dialog showcase tokens (About.* namespace, Lamplit D-14). -->
        <ResourceInclude Source="avares://OgmaLibrary.App/Themes/About.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
