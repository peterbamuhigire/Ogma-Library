<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OgmaLibrary.App.App"
             RequestedThemeVariant="Light">

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          Phase 03 design tokens (color, typography, spacing, motion).
          All UI code references these keys via DynamicResource.
          ThemeDictionaries inside Tokens.axaml swap automatically with
          RequestedThemeVariant (Light / Dark).
        -->
        <ResourceInclude Source="avares://OgmaLibrary.App/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
