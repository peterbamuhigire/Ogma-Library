<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    About dialog tokens ("Lamplit Library", decision D-14). Every colour the About dialog uses is
    named here in the About.* namespace, with Light ("Lamplit") and Dark ("Night Library")
    variants, so the Phase 09 token set can remap them later without touching the view.
    Contrast (MEASURED by AboutDialogTests): every text pair is at least 4.5:1; icon chips are
    at least 3:1 against their glyphs.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <!-- ═══════════════════════════ LIGHT: Lamplit ═══════════════════════════ -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="About.Color.Canvas">#F3EAD8</Color>
      <Color x:Key="About.Color.Card">#FFFBF2</Color>
      <Color x:Key="About.Color.CardBorder">#E4D2AE</Color>
      <Color x:Key="About.Color.HeroStart">#111A33</Color>
      <Color x:Key="About.Color.HeroMid">#1C2C58</Color>
      <Color x:Key="About.Color.HeroEnd">#2F58A8</Color>
      <Color x:Key="About.Color.HeroText">#F8F0DF</Color>
      <Color x:Key="About.Color.HeroTagline">#EBD6A6</Color>
      <Color x:Key="About.Color.Gilt">#C49A3C</Color>
      <Color x:Key="About.Color.GiltSoft">#80C49A3C</Color>
      <Color x:Key="About.Color.Eyebrow">#8A5210</Color>
      <Color x:Key="About.Color.Text">#1F1A14</Color>
      <Color x:Key="About.Color.TextMuted">#65513B</Color>
      <Color x:Key="About.Color.LinkHover">#F5E9D2</Color>
      <Color x:Key="About.Color.LinkPressed">#EDDCBC</Color>
      <Color x:Key="About.Color.ChipGlyph">#FFFFFF</Color>
      <Color x:Key="About.Color.Chip.Lapis">#2552A0</Color>
      <Color x:Key="About.Color.Chip.Garnet">#A3303D</Color>
      <Color x:Key="About.Color.Chip.Malachite">#1B7350</Color>
      <Color x:Key="About.Color.Chip.Amber">#A35C0A</Color>
      <Color x:Key="About.Color.Button">#1C2C58</Color>
      <Color x:Key="About.Color.ButtonHover">#2A3F7C</Color>
      <Color x:Key="About.Color.ButtonText">#F8F0DF</Color>
      <Color x:Key="About.Color.Footer">#EDE1C8</Color>

      <SolidColorBrush x:Key="About.Brush.Canvas" Color="{DynamicResource About.Color.Canvas}" />
      <SolidColorBrush x:Key="About.Brush.Card" Color="{DynamicResource About.Color.Card}" />
      <SolidColorBrush x:Key="About.Brush.CardBorder" Color="{DynamicResource About.Color.CardBorder}" />
      <SolidColorBrush x:Key="About.Brush.HeroText" Color="{DynamicResource About.Color.HeroText}" />
      <SolidColorBrush x:Key="About.Brush.HeroTagline" Color="{DynamicResource About.Color.HeroTagline}" />
      <SolidColorBrush x:Key="About.Brush.Gilt" Color="{DynamicResource About.Color.Gilt}" />
      <SolidColorBrush x:Key="About.Brush.GiltSoft" Color="{DynamicResource About.Color.GiltSoft}" />
      <SolidColorBrush x:Key="About.Brush.Eyebrow" Color="{DynamicResource About.Color.Eyebrow}" />
      <SolidColorBrush x:Key="About.Brush.Text" Color="{DynamicResource About.Color.Text}" />
      <SolidColorBrush x:Key="About.Brush.TextMuted" Color="{DynamicResource About.Color.TextMuted}" />
      <SolidColorBrush x:Key="About.Brush.LinkHover" Color="{DynamicResource About.Color.LinkHover}" />
      <SolidColorBrush x:Key="About.Brush.LinkPressed" Color="{DynamicResource About.Color.LinkPressed}" />
      <SolidColorBrush x:Key="About.Brush.ChipGlyph" Color="{DynamicResource About.Color.ChipGlyph}" />
      <SolidColorBrush x:Key="About.Brush.Chip.Lapis" Color="{DynamicResource About.Color.Chip.Lapis}" />
      <SolidColorBrush x:Key="About.Brush.Chip.Garnet" Color="{DynamicResource About.Color.Chip.Garnet}" />
      <SolidColorBrush x:Key="About.Brush.Chip.Malachite" Color="{DynamicResource About.Color.Chip.Malachite}" />
      <SolidColorBrush x:Key="About.Brush.Chip.Amber" Color="{DynamicResource About.Color.Chip.Amber}" />
      <SolidColorBrush x:Key="About.Brush.Button" Color="{DynamicResource About.Color.Button}" />
      <SolidColorBrush x:Key="About.Brush.ButtonHover" Color="{DynamicResource About.Color.ButtonHover}" />
      <SolidColorBrush x:Key="About.Brush.ButtonText" Color="{DynamicResource About.Color.ButtonText}" />
      <SolidColorBrush x:Key="About.Brush.Footer" Color="{DynamicResource About.Color.Footer}" />
      <LinearGradientBrush x:Key="About.Brush.Hero" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{DynamicResource About.Color.HeroStart}" />
        <GradientStop Offset="0.55" Color="{DynamicResource About.Color.HeroMid}" />
        <GradientStop Offset="1" Color="{DynamicResource About.Color.HeroEnd}" />
      </LinearGradientBrush>
      <BoxShadows x:Key="About.Shadow.Card">0 10 30 -6 #40402A10</BoxShadows>
    </ResourceDictionary>

    <!-- ═══════════════════════ DARK: Night Library ══════════════════════════ -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="About.Color.Canvas">#121A2E</Color>
      <Color x:Key="About.Color.Card">#1B2440</Color>
      <Color x:Key="About.Color.CardBorder">#34406A</Color>
      <Color x:Key="About.Color.HeroStart">#080D1C</Color>
      <Color x:Key="About.Color.HeroMid">#14204A</Color>
      <Color x:Key="About.Color.HeroEnd">#26468C</Color>
      <Color x:Key="About.Color.HeroText">#F6ECD6</Color>
      <Color x:Key="About.Color.HeroTagline">#E8C987</Color>
      <Color x:Key="About.Color.Gilt">#D9B45E</Color>
      <Color x:Key="About.Color.GiltSoft">#80D9B45E</Color>
      <Color x:Key="About.Color.Eyebrow">#E8B45A</Color>
      <Color x:Key="About.Color.Text">#F3EAD8</Color>
      <Color x:Key="About.Color.TextMuted">#BDB3A1</Color>
      <Color x:Key="About.Color.LinkHover">#243056</Color>
      <Color x:Key="About.Color.LinkPressed">#2C3963</Color>
      <Color x:Key="About.Color.ChipGlyph">#FFFFFF</Color>
      <Color x:Key="About.Color.Chip.Lapis">#3F6FCC</Color>
      <Color x:Key="About.Color.Chip.Garnet">#B83E4C</Color>
      <Color x:Key="About.Color.Chip.Malachite">#1C805A</Color>
      <Color x:Key="About.Color.Chip.Amber">#A8650F</Color>
      <Color x:Key="About.Color.Button">#E8B45A</Color>
      <Color x:Key="About.Color.ButtonHover">#F0C77A</Color>
      <Color x:Key="About.Color.ButtonText">#121A2E</Color>
      <Color x:Key="About.Color.Footer">#0E1424</Color>

      <SolidColorBrush x:Key="About.Brush.Canvas" Color="{DynamicResource About.Color.Canvas}" />
      <SolidColorBrush x:Key="About.Brush.Card" Color="{DynamicResource About.Color.Card}" />
      <SolidColorBrush x:Key="About.Brush.CardBorder" Color="{DynamicResource About.Color.CardBorder}" />
      <SolidColorBrush x:Key="About.Brush.HeroText" Color="{DynamicResource About.Color.HeroText}" />
      <SolidColorBrush x:Key="About.Brush.HeroTagline" Color="{DynamicResource About.Color.HeroTagline}" />
      <SolidColorBrush x:Key="About.Brush.Gilt" Color="{DynamicResource About.Color.Gilt}" />
      <SolidColorBrush x:Key="About.Brush.GiltSoft" Color="{DynamicResource About.Color.GiltSoft}" />
      <SolidColorBrush x:Key="About.Brush.Eyebrow" Color="{DynamicResource About.Color.Eyebrow}" />
      <SolidColorBrush x:Key="About.Brush.Text" Color="{DynamicResource About.Color.Text}" />
      <SolidColorBrush x:Key="About.Brush.TextMuted" Color="{DynamicResource About.Color.TextMuted}" />
      <SolidColorBrush x:Key="About.Brush.LinkHover" Color="{DynamicResource About.Color.LinkHover}" />
      <SolidColorBrush x:Key="About.Brush.LinkPressed" Color="{DynamicResource About.Color.LinkPressed}" />
      <SolidColorBrush x:Key="About.Brush.ChipGlyph" Color="{DynamicResource About.Color.ChipGlyph}" />
      <SolidColorBrush x:Key="About.Brush.Chip.Lapis" Color="{DynamicResource About.Color.Chip.Lapis}" />
      <SolidColorBrush x:Key="About.Brush.Chip.Garnet" Color="{DynamicResource About.Color.Chip.Garnet}" />
      <SolidColorBrush x:Key="About.Brush.Chip.Malachite" Color="{DynamicResource About.Color.Chip.Malachite}" />
      <SolidColorBrush x:Key="About.Brush.Chip.Amber" Color="{DynamicResource About.Color.Chip.Amber}" />
      <SolidColorBrush x:Key="About.Brush.Button" Color="{DynamicResource About.Color.Button}" />
      <SolidColorBrush x:Key="About.Brush.ButtonHover" Color="{DynamicResource About.Color.ButtonHover}" />
      <SolidColorBrush x:Key="About.Brush.ButtonText" Color="{DynamicResource About.Color.ButtonText}" />
      <SolidColorBrush x:Key="About.Brush.Footer" Color="{DynamicResource About.Color.Footer}" />
      <LinearGradientBrush x:Key="About.Brush.Hero" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{DynamicResource About.Color.HeroStart}" />
        <GradientStop Offset="0.55" Color="{DynamicResource About.Color.HeroMid}" />
        <GradientStop Offset="1" Color="{DynamicResource About.Color.HeroEnd}" />
      </LinearGradientBrush>
      <BoxShadows x:Key="About.Shadow.Card">0 12 34 -6 #66000000</BoxShadows>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ══════════════════════ THEME-INDEPENDENT ═════════════════════════════ -->
  <!-- Type sizes specific to the About showcase (Spectral hero and credit name). -->
  <x:Double x:Key="About.Type.Hero">40</x:Double>
  <x:Double x:Key="About.Type.Name">28</x:Double>
  <x:Double x:Key="About.Type.Eyebrow">11</x:Double>
  <x:Double x:Key="About.Type.Tagline">17</x:Double>
  <x:Double x:Key="About.Motion.Rise">12</x:Double>

  <!--
    Contact glyphs, drawn in-repo for Ogma on a 24-unit grid and stroked (not filled). They are
    original geometry, not copied from an icon set, so they carry the repository's MIT licence.
  -->
  <StreamGeometry x:Key="About.Icon.Globe">M12,3 A9,9 0 1 1 11.99,3 Z M12,3 C8.4,6.2 8.4,17.8 12,21 C15.6,17.8 15.6,6.2 12,3 Z M3,12 L21,12 M4.6,7.6 L19.4,7.6 M4.6,16.4 L19.4,16.4</StreamGeometry>
  <StreamGeometry x:Key="About.Icon.Mail">M4.5,5.5 L19.5,5.5 A1.5,1.5 0 0 1 21,7 L21,17 A1.5,1.5 0 0 1 19.5,18.5 L4.5,18.5 A1.5,1.5 0 0 1 3,17 L3,7 A1.5,1.5 0 0 1 4.5,5.5 Z M3.6,6.6 L12,12.6 L20.4,6.6</StreamGeometry>
  <StreamGeometry x:Key="About.Icon.Phone">M8.5,2.5 L15.5,2.5 A2,2 0 0 1 17.5,4.5 L17.5,19.5 A2,2 0 0 1 15.5,21.5 L8.5,21.5 A2,2 0 0 1 6.5,19.5 L6.5,4.5 A2,2 0 0 1 8.5,2.5 Z M10.5,18.2 L13.5,18.2 M10.8,5.2 L13.2,5.2</StreamGeometry>
  <StreamGeometry x:Key="About.Icon.Book">M12,6.2 C9.6,4.6 6.2,4.4 3,5.4 L3,18.8 C6.2,17.8 9.6,18 12,19.6 C14.4,18 17.8,17.8 21,18.8 L21,5.4 C17.8,4.4 14.4,4.6 12,6.2 Z M12,6.2 L12,19.6</StreamGeometry>
  <StreamGeometry x:Key="About.Icon.External">M8,4 L20,4 L20,16 M20,4 L5,19</StreamGeometry>
  <!-- A small lozenge flanked by dots: the gilt ornament between sections. -->
  <StreamGeometry x:Key="About.Ornament.Lozenge">M6,0 L12,6 L6,12 L0,6 Z</StreamGeometry>

</ResourceDictionary>
