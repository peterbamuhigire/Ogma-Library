<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OgmaLibrary.Domain\OgmaLibrary.Domain.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Application\OgmaLibrary.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDF rendering (spike S02 winner, updated to 5.x for SkiaSharp 3.x compat) -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- SkiaSharp for thumbnail/spine encoding (3.x required by Avalonia.Svg.Skia) -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.2" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <!-- PdfPig for metadata extraction -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.16">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.16" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
