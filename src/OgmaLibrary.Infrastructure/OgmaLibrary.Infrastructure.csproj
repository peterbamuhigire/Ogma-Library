<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OgmaLibrary.Domain\OgmaLibrary.Domain.csproj" />
    <ProjectReference Include="..\OgmaLibrary.Application\OgmaLibrary.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AI\Advisor\prompts\*.txt" />
    <EmbeddedResource Include="AI\Onnx\Resources\embedding-model-manifest.json" LogicalName="OgmaLibrary.Infrastructure.AI.Onnx.embedding-model-manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in local embeddings (Sept-23 Phase 14, D-103; CUR-23, CUR-24).
         Inference is in-process and makes no network call. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDF rendering (spike S02 winner, updated to 5.x for SkiaSharp 3.x compat) -->
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- SkiaSharp for thumbnail/spine encoding (3.x required by Avalonia.Svg.Skia) -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.2" />
    <!-- PdfPig for metadata extraction -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tesseract.Data.English" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
