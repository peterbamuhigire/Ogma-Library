<?xml version="1.0" encoding="utf-8"?>
<!-- Spike-local NuGet config: only nuget.org, ignoring machine-level broken sources -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
