<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike 3: WebView<->JS bridge contract. THROWAWAY. -->
  <!-- The contract + dispatcher are headless-testable here; the full Avalonia -->
  <!-- WebView host (WebView2 / WKWebView) round-trip is validated in a desktop -->
  <!-- session (see RESULT.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Spikes are throwaway: do not enforce production analyzers/warnings. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
